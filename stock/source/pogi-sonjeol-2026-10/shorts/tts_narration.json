 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "쇼츠",
   "text": "올해 반도체 주식에 투자했다가, 전재산의 70%인 2억 5천만 원을 잃었어요.",
   "start": 0.3,
   "end": 5.54
  },
  {
   "n": 2,
   "role": "host",
   "part": "쇼츠",
   "text": "코스피가 처음 9,000을 넘던 날, 남들 다 번다는 말에 빚까지 내서 넣었거든요.",
   "start": 5.92,
   "end": 10.921
  },
  {
   "n": 3,
   "role": "host",
   "part": "쇼츠",
   "text": "7월 폭락에 빌린 돈은 강제로 빠져나갔고, 남은 건 1억 원 남짓이에요.",
   "start": 11.301,
   "end": 15.979
  },
  {
   "n": 4,
   "role": "host",
   "part": "쇼츠",
   "text": "회사는 언제까지 다닐지 모르고, 딸 학원비는 매달 나가요.",
   "start": 16.358,
   "end": 20.113
  },
  {
   "n": 5,
   "role": "host",
   "part": "쇼츠",
   "text": "아내는, 아직 몰라요.",
   "start": 20.493,
   "end": 22.173
  },
  {
   "n": 6,
   "role": "host",
   "part": "쇼츠",
   "text": "주식 앱을 지우려다가, 문득 이런 생각이 들었어요.",
   "start": 22.553,
   "end": 25.412
  },
  {
   "n": 7,
   "role": "host",
   "part": "쇼츠",
   "text": "지금 떠나면, 이 2억 5천은 영원히 잃은 돈이 된다는 거요.",
   "start": 25.792,
   "end": 29.632
  },
  {
   "n": 8,
   "role": "host",
   "part": "쇼츠",
   "text": "포기하지 않고 다시 시작하면, 잃은 돈을 되찾을 수 있을까요?",
   "start": 30.012,
   "end": 33.736
  },
  {
   "n": 9,
   "role": "host",
   "part": "쇼츠",
   "text": "제가 찾은 다섯 가지 방법, 아래 영상에서 확인하세요.",
   "start": 34.116,
   "end": 37.286
  }
 ],
