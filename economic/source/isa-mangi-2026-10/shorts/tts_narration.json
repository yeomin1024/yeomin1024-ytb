 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "이씨는 ISA 만기 돈을 받고 3년 동안 세금을 96만 원 더 낸다는 걸 알게 됐습니다.",
   "start": 0.3,
   "end": 5.68
  },
  {
   "n": 2,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "시작은 회사 점심시간, 동갑 동료와 나눈 ISA 만기 얘기였는데요.",
   "start": 6.13,
   "end": 11.01
  },
  {
   "n": 3,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "둘 다 61세, 연봉 6,000만 원에 65세까지 일할 생각이에요.",
   "start": 11.46,
   "end": 16.22
  },
  {
   "n": 4,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "ISA도 3년 전 같은 달에 만들어, 해마다 2,000만 원씩 넣었고요.",
   "start": 16.67,
   "end": 20.95
  },
  {
   "n": 5,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "이번 달 만기 돈도 똑같이 6,800만 원이었죠.",
   "start": 21.4,
   "end": 24.85
  },
  {
   "n": 6,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "동료가 두 사람의 3년 세금을 계산해 보여 줬는데요.",
   "start": 25.3,
   "end": 28.43
  },
  {
   "n": 7,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "이씨는 약 172만 원, 동료는 약 76만 원이었습니다.",
   "start": 28.88,
   "end": 32.71
  },
  {
   "n": 8,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "이씨는 처음엔 동료가 잘못 계산한 줄 알았습니다.",
   "start": 33.16,
   "end": 35.96
  },
  {
   "n": 9,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "그런데 직접 다시 해 봐도 숫자는 그대로였어요.",
   "start": 36.41,
   "end": 39.17
  },
  {
   "n": 10,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "다음 만기 돈도 이번과 같은 곳에 두면, 6년간 이씨가 더 낼 세금은 약 2백만 원입니다.",
   "start": 39.62,
   "end": 44.66
  },
  {
   "n": 11,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "만기 돈을 이미 받은 이씨, 지금이라도 세금을 줄일 수 있을까요?",
   "start": 45.11,
   "end": 49.07
  },
  {
   "n": 12,
   "role": "host",
   "part": "같은 6,800만 원, 다른 세금",
   "text": "두 사람이 무엇이 달랐는지, 지금 할 일까지 아래 영상에서 확인하세요.",
   "start": 49.52,
   "end": 53.64
