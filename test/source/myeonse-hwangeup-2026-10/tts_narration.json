 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "11월 1일부터 일본의 외국인 여행자 면세 방식이 바뀝니다.",
   "start": 0.3,
   "end": 3.78
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "지금처럼 매장 계산대에서 바로 세금을 빼 주는 방식이 사라집니다.",
   "start": 4.23,
   "end": 7.79
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "한국 언론에서도 '면세라더니 세금부터?'라는 기사 제목이 나왔죠.",
   "start": 8.24,
   "end": 12.47
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "여행 가이드들 사이에선 공항에 훨씬 일찍 가야 하는 것 아니냐는 걱정도 나옵니다.",
   "start": 12.92,
   "end": 18.17
  },
  {
   "n": 5,
   "role": "host",
   "part": "도입",
   "text": "그럼 일본 면세가 없어지는 걸까요?",
   "start": 18.62,
   "end": 20.7
  },
  {
   "n": 6,
   "role": "host",
   "part": "도입",
   "text": "결론부터 말하면, 면세는 그대로입니다.",
   "start": 21.15,
   "end": 23.63
  },
  {
   "n": 7,
   "role": "host",
   "part": "도입",
   "text": "다만 세금을 먼저 내고, 출국할 때 세관 확인을 받아야 돌려받는 방식으로 바뀝니다.",
   "start": 24.08,
   "end": 29.56
  },
  {
   "n": 8,
   "role": "host",
   "part": "도입",
   "text": "이 확인을 받지 못하면 낸 세금은 돌려받을 수 없습니다.",
   "start": 30.01,
   "end": 33.29
  },
  {
   "n": 9,
   "role": "host",
   "part": "도입",
   "text": "무엇이 바뀌고 무엇을 조심해야 하는지, 다섯 가지로 정리하겠습니다.",
   "start": 33.74,
   "end": 37.9
  },
  {
   "n": 10,
   "role": "host",
   "part": "첫째, 언제부터 바뀌나",
   "text": "첫 번째는 시작 날짜입니다.",
   "start": 38.9,
   "end": 40.45
  },
  {
   "n": 11,
   "role": "host",
   "part": "첫째, 언제부터 바뀌나",
   "text": "새 방식은 2026년 11월 1일 이후에 산 물건부터 적용됩니다.",
   "start": 40.9,
   "end": 45.18
  },
  {
   "n": 12,
   "role": "host",
   "part": "첫째, 언제부터 바뀌나",
   "text": "기준은 출국하는 날이 아니라 물건을 산 날이에요.",
   "start": 45.63,
   "end": 48.41
  },
  {
   "n": 13,
   "role": "host",
   "part": "첫째, 언제부터 바뀌나",
   "text": "10월 31일까지 산 물건은 지금처럼 매장에서 바로 면세됩니다.",
   "start": 48.86,
   "end": 52.62
  },
  {
   "n": 14,
   "role": "host",
   "part": "첫째, 언제부터 바뀌나",
   "text": "11월에 출국하더라도 마찬가지예요.",
   "start": 53.07,
   "end": 55.22
  },
  {
   "n": 15,
   "role": "host",
   "part": "첫째, 언제부터 바뀌나",
   "text": "두 방식을 함께 쓰는 기간은 따로 없어요.",
   "start": 55.67,
   "end": 58.03
  },
  {
   "n": 16,
   "role": "host",
   "part": "첫째, 언제부터 바뀌나",
   "text": "그럼 11월부터는 어떤 순서로 돌려받는 걸까요?",
   "start": 58.48,
   "end": 61.56
  },
  {
   "n": 17,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "두 번째는 돌려받는 순서입니다.",
   "start": 62.56,
   "end": 64.32
  },
  {
   "n": 18,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "먼저 매장에서 여권을 보여 주고, 소비세를 포함한 가격으로 결제합니다.",
   "start": 64.77,
   "end": 68.84
  },
  {
   "n": 19,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "예를 들어 세금 포함 1만 1천 엔짜리를 사면, 그중 1천 엔이 소비세입니다.",
   "start": 69.29,
   "end": 73.93
  },
  {
   "n": 20,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "매장은 이 구매 기록을 일본 국세청 시스템으로 보냅니다.",
   "start": 74.38,
   "end": 77.9
  },
  {
   "n": 21,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "출국하는 날에는 공항 국제선 출발 로비에 있는 면세 수속 단말기에 여권을 댑니다.",
   "start": 78.35,
   "end": 84.0
  },
  {
   "n": 22,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "화면에 초록색이 뜨면 확인이 끝나요.",
   "start": 84.45,
   "end": 86.4
  },
  {
   "n": 23,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "빨간색이 뜨면 세관 검사장에서 산 물건을 직접 보여 줘야 합니다.",
   "start": 86.85,
   "end": 91.01
  },
  {
   "n": 24,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "나리타, 하네다, 간사이 등 일곱 개 공항에서는 비지트 재팬 웹으로도 수속할 수 있습니다.",
   "start": 91.46,
   "end": 97.68
  },
  {
   "n": 25,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "공항 안 전용 와이파이 구역에서 휴대전화로 하는 방식이에요.",
   "start": 98.13,
   "end": 101.56
  },
  {
   "n": 26,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "세관 확인이 끝나면 돈을 돌려받습니다.",
   "start": 102.01,
   "end": 104.26
  },
  {
   "n": 27,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "돌려주는 곳은 세관이 아니라, 물건을 산 매장이나 매장이 맡긴 환급 업체입니다.",
   "start": 104.71,
   "end": 109.38
  },
  {
   "n": 28,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "돌려받는 방법은 카드, 계좌 송금, 앱, 공항 현금 등 매장마다 다릅니다.",
   "start": 109.83,
   "end": 115.3
  },
  {
   "n": 29,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "일본 정부는 수수료를 받지 않지만, 환급 업체의 수수료는 법으로 정해져 있지 않습니다.",
   "start": 115.75,
   "end": 121.27
  },
  {
   "n": 30,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "그래서 수수료를 떼고 나면 돌려받는 돈이 낸 세금보다 적을 수 있습니다.",
   "start": 121.72,
   "end": 125.57
  },
  {
   "n": 31,
   "role": "host",
   "part": "둘째, 돌려받는 순서",
   "text": "그런데 이 과정에서 놓치면 환급을 아예 못 받는 경우가 있습니다.",
   "start": 126.02,
   "end": 129.54
  },
  {
   "n": 32,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "세 번째는 놓치면 환급을 못 받는 세 가지입니다.",
   "start": 130.54,
   "end": 133.24
  },
  {
   "n": 33,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "하나, 짐을 맡기기 전에 세관 확인을 받아야 합니다.",
   "start": 133.69,
   "end": 136.93
  },
  {
   "n": 34,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "산 물건을 캐리어에 넣어 먼저 부치면, 세관 확인을 받을 수 없습니다.",
   "start": 137.38,
   "end": 141.62
  },
  {
   "n": 35,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "한 번 맡긴 짐은 되찾아 올 수도 없습니다.",
   "start": 142.07,
   "end": 144.24
  },
  {
   "n": 36,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "둘, 확인은 영수증 단위로 합니다.",
   "start": 144.69,
   "end": 146.82
  },
  {
   "n": 37,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "한 영수증에 든 물건 가운데 하나라도 없으면, 그 영수증 전체가 환급되지 않습니다.",
   "start": 147.27,
   "end": 152.8
  },
  {
   "n": 38,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "일본에서 먹거나 써 버린 물건도 환급받을 수 없습니다.",
   "start": 153.25,
   "end": 156.17
  },
  {
   "n": 39,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "일부라도 썼다면 단말기 대신 세관 창구에 신고해야 합니다.",
   "start": 156.62,
   "end": 160.43
  },
  {
   "n": 40,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "셋, 산 날부터 90일 안에 출국하면서 확인을 받아야 합니다.",
   "start": 160.88,
   "end": 164.32
  },
  {
   "n": 41,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "확인을 받지 않으면 낸 세금은 돌려받지 못합니다.",
   "start": 164.77,
   "end": 167.48
  },
  {
   "n": 42,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "수속을 하다가 중간에 그만둬도, 확인을 받지 않은 것으로 봅니다.",
   "start": 167.93,
   "end": 171.72
  },
  {
   "n": 43,
   "role": "host",
   "part": "셋째, 놓치면 환급 못 받는 세 가지",
   "text": "반대로 오히려 편해진 점도 있습니다.",
   "start": 172.17,
   "end": 174.09
  },
  {
   "n": 44,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "네 번째는 편해진 점입니다.",
   "start": 175.09,
   "end": 176.68
  },
  {
   "n": 45,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "같은 매장에서 하루에 세금 빼고 5,000엔 이상 사야 한다는 기준은 그대로입니다.",
   "start": 177.13,
   "end": 181.67
  },
  {
   "n": 46,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "대신 물건을 소모품과 일반 물품으로 나누던 구분이 사라집니다.",
   "start": 182.12,
   "end": 185.75
  },
  {
   "n": 47,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "소모품은 과자나 화장품, 일반 물품은 옷이나 가전 같은 물건이죠.",
   "start": 186.2,
   "end": 190.58
  },
  {
   "n": 48,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "그래서 둘을 합쳐 5,000엔 이상이면 돼요.",
   "start": 191.03,
   "end": 193.51
  },
  {
   "n": 49,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "소모품은 50만 엔까지만 면세되던 상한도 없어집니다.",
   "start": 193.96,
   "end": 197.32
  },
  {
   "n": 50,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "소모품을 밀봉 봉투에 담아 주던 특수 포장도 사라지고요.",
   "start": 197.77,
   "end": 201.08
  },
  {
   "n": 51,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "다만 한 개에 세금 빼고 100만 엔 이상인 물건은 따로 기록합니다.",
   "start": 201.53,
   "end": 205.13
  },
  {
   "n": 52,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "시리얼 번호처럼 그 물건을 알아볼 수 있는 정보를 구매 기록에 남기는 거죠.",
   "start": 205.58,
   "end": 209.91
  },
  {
   "n": 53,
   "role": "host",
   "part": "넷째, 오히려 편해진 점",
   "text": "그렇다면 일본은 왜 이렇게 방식을 바꾼 걸까요?",
   "start": 210.36,
   "end": 213.28
  },
  {
   "n": 54,
   "role": "host",
   "part": "다섯째, 왜 바꿨나",
   "text": "다섯 번째는 바꾼 이유입니다.",
   "start": 214.28,
   "end": 215.8
  },
  {
   "n": 55,
   "role": "host",
   "part": "다섯째, 왜 바꿨나",
   "text": "일본 재무성은 면세로 산 물건을 일본 안에서 되파는 부정을 막기 위해서라고 설명합니다.",
   "start": 216.25,
   "end": 221.61
  },
  {
   "n": 56,
   "role": "host",
   "part": "다섯째, 왜 바꿨나",
   "text": "재무성이 2022년 4월부터 2년 동안의 기록을 정리한 자료가 있습니다.",
   "start": 222.06,
   "end": 226.88
  },
  {
   "n": 57,
   "role": "host",
   "part": "다섯째, 왜 바꿨나",
   "text": "그 기간에 한 번 입국해 1억 엔 이상 산 사람이 690명이었습니다.",
   "start": 227.33,
   "end": 231.6
  },
  {
   "n": 58,
   "role": "host",
   "part": "다섯째, 왜 바꿨나",
   "text": "이들이 산 금액은 합계 2,332억 엔입니다.",
   "start": 232.05,
   "end": 235.34
  },
  {
   "n": 59,
   "role": "host",
   "part": "다섯째, 왜 바꿨나",
   "text": "세관은 이 가운데 9할 가까이를 출국할 때 확인하지 못했습니다.",
   "start": 235.79,
   "end": 239.86
  },
  {
   "n": 60,
   "role": "host",
   "part": "다섯째, 왜 바꿨나",
   "text": "확인한 사람들은 거의 모두 물건을 가지고 있지 않아 세금이 매겨졌습니다.",
   "start": 240.31,
   "end": 244.53
  },
  {
   "n": 61,
   "role": "host",
