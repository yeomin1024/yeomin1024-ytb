  {
   "start": 326.56,
   "duration": 4.16,
   "text": "봐요. 분할 매수를 하면서 평단이"
  },
  {
   "start": 328.52,
   "duration": 4.28,
   "text": "계속 올라가기 때문에 이게"
  },
  {
   "start": 330.72,
   "duration": 3.92,
   "text": "심정적으로는 약간 손실이라고 생각을"
  },
  {
   "start": 332.8,
   "duration": 3.64,
   "text": "하신 거 같거든요. 이제 이런 부분은"
  },
  {
   "start": 334.64,
   "duration": 4.08,
   "text": "어떻게 마음가짐을 해야? 그러니까요."
  },
  {
   "start": 336.44,
   "duration": 3.96,
   "text": "그렇게 그 이게 만약에 여유 자금이라"
  },
  {
   "start": 338.72,
   "duration": 3.08,
   "text": "그러면 불안할 필요가 없는 거죠."
  },
  {
   "start": 340.4,
   "duration": 4.4,
   "text": "근데 여유 자금이 아니기 때문에"
  },
  {
   "start": 341.8,
   "duration": 5.68,
   "text": "불안한 거예요. 빚을 냈거나 아니면"
  },
  {
   "start": 344.8,
   "duration": 4.32,
   "text": "어 이거 뭐 생활비로 써야 되는데 그"
  },
  {
   "start": 347.48,
   "duration": 4.36,
   "text": "돈으로 투자했거나 그럼 불안하죠."
  },
  {
   "start": 349.12,
   "duration": 3.96,
   "text": "만약 전세가 전세 자이다 그러면"
  },
  {
   "start": 351.84,
   "duration": 4.48,
   "text": "투자하면 안 되죠."
  },
  {
   "start": 353.08,
   "duration": 5.12,
   "text": ">> 많은 분들이 어 물타기는"
  },
  {
   "start": 356.32,
   "duration": 3.68,
   "text": "조금 하시는 분들이 있는 거 같아요."
  },
  {
   "start": 358.2,
   "duration": 4.24,
   "text": "이제 마이너스일 때 들어가는 거."
  },
  {
   "start": 360.0,
   "duration": 5.08,
   "text": "근데 불타기 하는 거는 오히려 그니까"
  },
  {
   "start": 362.44,
   "duration": 5.36,
   "text": "이렇게 그니까 평단이 올라가면 왠지"
  },
  {
   "start": 365.08,
   "duration": 3.68,
   "text": "손해인 거 같다면서 불타이 안 하시는"
  },
  {
   "start": 367.8,
   "duration": 3.48,
   "text": "분들 있거든요."
  },
  {
   "start": 368.76,
   "duration": 6.24,
   "text": ">> 아니 근데 그거는네 또 도박자행 한"
  },
  {
   "start": 371.28,
   "duration": 6.08,
   "text": "거예요. 자꾸 막 그 시장을 맞추려고"
  },
  {
   "start": 375.0,
   "duration": 6.0,
   "text": "하다 보니까 어 예를 들어서 이런"
  },
  {
   "start": 377.36,
   "duration": 6.12,
   "text": "거예요. 내가 만 원 주고 샀어요."
  },
  {
   "start": 381.0,
   "duration": 4.6,
   "text": "근데 12,000이 될 때도 있죠."
  },
  {
   "start": 383.48,
   "duration": 4.0,
   "text": "또 13,000원이 될 때도 있죠."
  },
  {
   "start": 385.6,
   "duration": 4.2,
   "text": "또 9,000원이 될 때도 있어요."
  },
  {
   "start": 387.48,
   "duration": 4.4,
   "text": "근데 만약에 10년 후에 보니까만이"
  },
  {
   "start": 389.8,
   "duration": 3.36,
   "text": "5만 원이 되면 어떻게 돼요?"
  },
  {
   "start": 391.88,
   "duration": 3.96,
   "text": ">> 의미 없죠."
  },
  {
   "start": 393.16,
   "duration": 6.12,
   "text": ">> 근데 사람들은 그 짧은 기간을"
  },
  {
   "start": 395.84,
   "duration": 5.84,
   "text": "맞추려고 보니까 불안하고 또 좋아하고"
  },
  {
   "start": 399.28,
   "duration": 4.72,
   "text": "그러니까 우리가 운전할 때 멀리 보고"
  },
  {
   "start": 401.68,
   "duration": 4.4,
   "text": "운전하는게 아니고 바로 앞에 1m만"
  },
  {
   "start": 404.0,
   "duration": 5.08,
   "text": "보면 어떻게 어지럽죠?"
  },
  {
   "start": 406.08,
   "duration": 6.4,
   "text": "그러니까 아 내가 수없이 얘기를 해도"
  },
  {
   "start": 409.08,
   "duration": 6.12,
   "text": "사람들 똑같은 질문을 해요. 그거는"
  },
  {
   "start": 412.48,
   "duration": 5.4,
   "text": "내가 경험이 없어서 그런게 아니라"
  },
  {
   "start": 415.2,
   "duration": 3.92,
   "text": "현명함이 없는 거예요. 투자를 왜 왜"
  },
  {
   "start": 417.88,
   "duration": 3.24,
   "text": "해야 되는지"
  },
  {
   "start": 419.12,
   "duration": 3.72,
   "text": ">> 노 준비잖아요. 그러면 노후"
  },
  {
   "start": 421.12,
   "duration": 3.72,
   "text": "준비하려면 앞으로 10년 후, 20년"
  },
  {
   "start": 422.84,
   "duration": 4.04,
   "text": "후를 얘기하는 거잖아요. 근데 한"
  },
  {
   "start": 424.84,
   "duration": 4.4,
   "text": "달로 얘기하거든요."
  },
  {
   "start": 426.88,
   "duration": 4.48,
   "text": "그 현명하지가 않은 거죠. 그 불안한"
  },
  {
   "start": 429.24,
   "duration": 4.52,
   "text": "이유는 본인이 현명하지가 않기 때문에"
  },
  {
   "start": 431.36,
   "duration": 5.52,
   "text": "생기는 거예요. 죄송하지만"
  },
  {
   "start": 433.76,
   "duration": 4.96,
   "text": ">> 그럼 요즘에 이제 뭐 뭐 소수점"
  },
  {
   "start": 436.88,
   "duration": 4.16,
   "text": "투자라는 것도 있고 이제 정확한"
  },
  {
   "start": 438.72,
   "duration": 4.76,
   "text": "날짜에 자동으로 투자되는 것도 있고"
  },
  {
   "start": 441.04,
   "duration": 4.44,
   "text": "그런 거를 이용해서 그냥 뭐 맨날"
  },
  {
   "start": 443.48,
   "duration": 4.6,
   "text": "이렇게 내가 보고서 오늘 좀 떨어진"
  },
  {
   "start": 445.48,
   "duration": 4.96,
   "text": "사야지 이런 마음가짐을 가는 거보다"
  },
  {
   "start": 448.08,
   "duration": 3.92,
   "text": "그냥 뭐 매달 15일에 나는 사겠다"
  },
  {
   "start": 450.44,
   "duration": 2.84,
   "text": "그러면 정확하게 그렇게 사는"
  },
  {
   "start": 452.0,
   "duration": 3.16,
   "text": ">> 방 좋은 방법이에요. 그니까"
  },
  {
   "start": 453.28,
   "duration": 5.2,
   "text": "들여다보지 않는 거. 근데 이제"
  },
  {
   "start": 455.16,
   "duration": 6.2,
   "text": "소수점 같은 경우는 저는 그게 권장"
  },
  {
   "start": 458.48,
   "duration": 5.04,
   "text": "안 해요. 왜냐하면 너무 장난치는 거"
  },
  {
   "start": 461.36,
   "duration": 4.12,
   "text": "같잖아요. 그동안 가끔 뭐 하려고."
  },
  {
   "start": 463.52,
   "duration": 4.44,
   "text": "예를 들어서 내가 하루에 10원씩"
  },
  {
   "start": 465.48,
   "duration": 4.6,
   "text": "투자해한다고요. 그죠? 100원씩"
  },
  {
   "start": 467.96,
   "duration": 3.48,
   "text": "투자한다 그래요. 의미가 없죠. 근데"
  },
  {
   "start": 470.08,
   "duration": 3.68,
   "text": "나는 아, 난 100원으로 노"
  },
  {
   "start": 471.44,
   "duration": 5.08,
   "text": "준비해. 그건 거짓말이죠."
  },
  {
   "start": 473.76,
   "duration": 4.76,
   "text": "적어도 내가 할 수 있는 가장 많이"
  },
  {
   "start": 476.52,
   "duration": 4.48,
   "text": "많은 돈을 해야죠. 만약에 20대다,"
  },
  {
   "start": 478.52,
   "duration": 4.6,
   "text": "30대다 그러면 남들이 보면 정말"
  },
  {
   "start": 481.0,
   "duration": 4.8,
   "text": "독할 정도로 해야죠."
  },
  {
   "start": 483.12,
   "duration": 4.88,
   "text": "그러면 30대에 투자를 시작한 사람과"
  },
  {
   "start": 485.8,
   "duration": 4.36,
   "text": "이제 지금이 사연 주신 어르신처럼"
  },
  {
   "start": 488.0,
   "duration": 4.48,
   "text": "60대에 시작한 사람이 투자 기간이"
  },
  {
   "start": 490.16,
   "duration": 2.84,
   "text": "다르면 투자에 대한 전략을 좀 다르게"
  },
  {
   "start": 492.48,
   "duration": 1.92,
   "text": "가져가야 되."
  },
  {
   "start": 493.0,
   "duration": 3.4,
   "text": ">> 전략이 아니라 [목을 가다듬음]"
  },
  {
   "start": 494.4,
   "duration": 4.76,
   "text": "다른 거죠. 그니까 비중이죠. 내가"
  },
  {
   "start": 496.4,
   "duration": 4.64,
   "text": "60대는 아 주식 비중이 낮아야"
  },
  {
   "start": 499.16,
   "duration": 4.72,
   "text": "되겠죠. 아까 얘기했듯이 110에서"
  },
  {
   "start": 501.04,
   "duration": 4.28,
   "text": "자기 나이를 뺀 거라고 하니까. 근데"
  },
  {
   "start": 503.88,
   "duration": 2.8,
   "text": "만약에 30대라 그러면 저 같은"
  },
  {
   "start": 505.32,
   "duration": 3.76,
   "text": "100% 주식에 투자해야 되죠."
  },
  {
   "start": 506.68,
   "duration": 4.88,
   "text": "30년 동안 투자할 수 있으니까."
  },
  {
   "start": 509.08,
   "duration": 4.76,
   "text": "그니까 남보다 낮은 나이에 투자를"
  },
  {
   "start": 511.56,
   "duration": 4.32,
   "text": "시작하신 분들은 사실 조금은 조급한"
  },
  {
   "start": 513.84,
   "duration": 4.84,
   "text": "마음이 생길 수 있을 것 같아요."
  },
  {
   "start": 515.88,
   "duration": 5.52,
   "text": "근데 이게 이제 도박이라고 표현을"
  },
  {
   "start": 518.68,
   "duration": 6.56,
   "text": "주셨지만 내가 조금 짧은 기간을"
  },
  {
   "start": 521.4,
   "duration": 5.52,
   "text": "투자하는데도 이왕이면 조금 많은 돈을"
  },
  {
   "start": 525.24,
   "duration": 2.36,
   "text": "벌 수 있으면 좋겠다라는게 사실"
  },
  {
   "start": 526.92,
   "duration": 1.92,
   "text": "사람들의 마음"
  },
  {
   "start": 527.6,
   "duration": 4.72,
   "text": ">> 그 당연하죠."
  },
  {
   "start": 528.84,
   "duration": 6.4,
   "text": "그런데 어 그런 일 안 일어난다."
  },
  {
   "start": 532.32,
   "duration": 6.0,
   "text": "미안하지만 어 그 시간에 투자하는"
  },
  {
   "start": 535.24,
   "duration": 5.8,
   "text": "거다. 그래서 내 포트폴리오를 짜야"
  },
  {
   "start": 538.32,
   "duration": 4.72,
   "text": "되는 이유죠. 그러니까 변동성금 작은"
  },
  {
   "start": 541.04,
   "duration": 3.64,
   "text": "거에 이제 많이 그 채권 같은 경우는"
  },
  {
   "start": 543.04,
   "duration": 4.68,
   "text": "거 채권 같은 경우는 이제 이자가"
  },
  {
   "start": 544.68,
   "duration": 5.68,
   "text": "나오니까 또 주식에 투자하더라도"
  },
  {
   "start": 547.72,
   "duration": 4.96,
   "text": "배당률이 높은 거 배당이 어떤 경우는"
  },
  {
   "start": 550.36,
   "duration": 4.08,
   "text": "6% 7% 주는 거 있거든요. 근데"
  },
  {
   "start": 552.68,
   "duration": 4.48,
   "text": "그런 거에 투자하는 ETF가 또"
  },
  {
   "start": 554.44,
   "duration": 5.96,
   "text": "있어요. 배당을 많이 주는 ETF."
  },
  {
   "start": 557.16,
   "duration": 5.68,
   "text": "그렇게 어 골라서 사면 되죠."
  },
  {
   "start": 560.4,
   "duration": 4.32,
   "text": ">> 어 그럼 이분이 이제 60대시잖아요."
  },
  {
   "start": 562.84,
   "duration": 3.28,
   "text": "그리고 아까 사연에 그니까 언제"
  },
  {
   "start": 564.72,
   "duration": 2.52,
   "text": "인출을 해야 될지 그것도 좀"
  },
  {
   "start": 566.12,
   "duration": 4.16,
   "text": "고민이다.음"
  },
  {
   "start": 567.24,
   "duration": 5.68,
   "text": ">> 그 인출을 만약에 이게 이제 유일한"
  },
  {
   "start": 570.28,
   "duration": 5.04,
   "text": "자산이다 그러면 인출을 해야 되겠죠."
  },
  {
   "start": 572.92,
   "duration": 3.32,
   "text": "그런데 가능한 늦게 하는게 좋은"
  },
  {
   "start": 575.32,
   "duration": 3.64,
   "text": "거죠."
  },
  {
   "start": 576.24,
   "duration": 4.48,
   "text": ">> 최소화은 그러면 5년 10년 이상 가"
  },
  {
   "start": 578.96,
   "duration": 5.12,
   "text": ">> 최소한 5년은 해야"
  },
  {
   "start": 580.72,
   "duration": 5.92,
   "text": ">> 만약에 내가 어 그 중간중간에 팔아야"
  },
  {
   "start": 584.08,
   "duration": 4.4,
   "text": "된다 그러면 안 되죠.음 음. 그거는"
  },
  {
   "start": 586.64,
   "duration": 5.28,
   "text": "그냥 예금에 넣는게 낫죠.가"
  },
  {
   "start": 588.48,
   "duration": 6.12,
   "text": "생활비는. 음. 만약에 한 이분이"
  },
  {
   "start": 591.92,
   "duration": 5.28,
   "text": "이제 모아 가지고 그 돈이 한 5년,"
  },
  {
   "start": 594.6,
   "duration": 5.24,
   "text": "10년 이후에 키워 가지고 한 1억"
  },
  {
   "start": 597.2,
   "duration": 4.52,
   "text": "정도가 됐다. 그러면 뭐 1년에 뭐"
  },
  {
   "start": 599.84,
   "duration": 3.32,
   "text": "몇 % 정도는 꺼냈을 써도 될"
  },
  {
   "start": 601.72,
   "duration": 3.48,
   "text": "것이다. 이런 예상이 있어요."
  },
  {
   "start": 603.16,
   "duration": 2.44,
   "text": ">> 보통 이제 4% 얘기를 해요."
  },
  {
   "start": 605.2,
   "duration": 2.64,
   "text": ">> 네네."
  },
  {
   "start": 605.6,
   "duration": 4.08,
   "text": ">> 그니까 1년에 4% 정도는 내가 빼서"
  },
  {
   "start": 607.84,
   "duration": 3.6,
   "text": "생활비를 써도 된다. 근데 이제"
  },
  {
   "start": 609.68,
   "duration": 4.04,
   "text": "금액에 따라 틀리겠죠."
  },
  {
   "start": 611.44,
   "duration": 4.24,
   "text": ">> 조금 더 금액이 큰 경우에는 조금 덜"
  },
  {
   "start": 613.72,
   "duration": 4.28,
   "text": "찾아도 될 것이고. 그렇죠. 맞아."
  },
  {
   "start": 615.68,
   "duration": 4.92,
   "text": ">> 조금 작은 경우에는 조금 더 찾아야"
  },
  {
   "start": 618.0,
   "duration": 3.96,
   "text": "될 것인데 근데 똑같이 100세를"
  },
  {
   "start": 620.6,
   "duration": 3.92,
   "text": "산다 그러면"
  },
  {
   "start": 621.96,
   "duration": 4.84,
   "text": ">> 어 제가 그냥 뭐 노후자금이 많지"
  },
  {
   "start": 624.52,
   "duration": 5.12,
   "text": "않아서 이제 1억 정도의 규모였다."
  },
  {
   "start": 626.8,
   "duration": 4.68,
   "text": "근데 이거를 100세까지 가지고 간다"
  },
  {
   "start": 629.64,
   "duration": 3.84,
   "text": "그러면 10년 후부터 찾아도 나"
  },
  {
   "start": 631.48,
   "duration": 4.8,
   "text": "나중에 찾을 돈이 없어지면 어떡하지?"
  },
  {
   "start": 633.48,
   "duration": 4.76,
   "text": "이런 고민이 생길 수도 있는데 계속"
  },
  {
   "start": 636.28,
   "duration": 3.16,
   "text": "원금을 가지고 갈 수 있다 그러면은"
  },
  {
   "start": 638.24,
   "duration": 3.88,
   "text": "걱정을 안 해도 될까요? [콧방귀]"
  },
  {
   "start": 639.44,
   "duration": 5.36,
   "text": ">> 그러니까 이제 그럴 경우에는 채권에"
  },
  {
   "start": 642.12,
   "duration": 3.44,
   "text": "투자를 많이 해야죠. 이자를 주니까"
  },
  {
   "start": 644.8,
   "duration": 3.24,
   "text": "예,"
  },
  {
   "start": 645.56,
   "duration": 4.96,
   "text": ">> 이게 또 채권이 그니까 종류가 좀"
  },
  {
   "start": 648.04,
   "duration": 5.32,
   "text": "다양하게 있어요. 그래서 그 장기는"
  },
  {
   "start": 650.52,
   "duration": 4.72,
   "text": "뭔지 30년물은 뭔지 좀 그런 거"
  },
  {
   "start": 653.36,
   "duration": 3.92,
   "text": "혼돈하는 분들이 있거든요. 그야 나는"
  },
  {
   "start": 655.24,
   "duration": 4.08,
   "text": "도대체 단기에 넣어야 돼. 아니면"
  },
  {
   "start": 657.28,
   "duration": 3.72,
   "text": "30년 이런 거 믿고 넣어도 돼. 뭐"
  },
  {
   "start": 659.32,
   "duration": 3.2,
   "text": "그럼 내가 실제로 30년을 들고"
  },
  {
   "start": 661.0,
   "duration": 3.36,
   "text": "있어야 되는 거야. 약간 그런 거"
  },
  {
   "start": 662.52,
   "duration": 3.6,
   "text": "생각하시는 분들이 있거든요. 아, 그"
  },
  {
   "start": 664.36,
   "duration": 3.16,
   "text": "채권에 대해서 좀 설명을 드릴게."
  },
  {
   "start": 666.12,
   "duration": 4.2,
   "text": "채권하고"
  },
  {
   "start": 667.52,
   "duration": 5.2,
   "text": ">> 주식은 기업에 내가 주인이 되는"
  },
  {
   "start": 670.32,
   "duration": 5.88,
   "text": "거예요. 그래. 주식은 근데 이제"
  },
  {
   "start": 672.72,
   "duration": 6.16,
   "text": "채권은 뭐냐면 회사가 자금을 조달할"
  },
  {
   "start": 676.2,
   "duration": 5.2,
   "text": "때 주식을 발행하는 방법들이 하나가"
  },
  {
   "start": 678.88,
   "duration": 5.44,
   "text": "있죠. 그다음에 채권을 발행하는"
  },
  {
   "start": 681.4,
   "duration": 5.72,
   "text": "경우가 있어요. 채권은 뭐냐면 예를"
  },
  {
   "start": 684.32,
   "duration": 5.28,
   "text": "들어서 주권하고 비슷하게 생겼어요."
  },
  {
   "start": 687.12,
   "duration": 4.48,
   "text": "거기에 뭐냐면 어 만 원이에요. 한"
  },
  {
   "start": 689.6,
   "duration": 5.04,
   "text": "장에. 그러면 거기 두 가지가"
  },
  {
   "start": 691.6,
   "duration": 5.96,
   "text": "있습니다. 하나는 어 만기가 있어요."
  },
  {
   "start": 694.64,
   "duration": 6.44,
   "text": "10년 만기. 뭐 20년 만기 5년"
  },
  {
   "start": 697.56,
   "duration": 5.72,
   "text": "만기. 그다음에 이자로 들어가죠."
  },
  {
   "start": 701.08,
   "duration": 4.12,
   "text": "그래서 이자율이 예를 들어서 5%다."
  },
  {
   "start": 703.28,
   "duration": 4.52,
   "text": "그러면 5%를"
  },
  {
   "start": 705.2,
   "duration": 5.28,
   "text": "1년마다 받는 거예요. 그리고 이제"
  },
  {
   "start": 707.8,
   "duration": 5.08,
   "text": "10년 만기면 10년 후에 원금을"
  },
  {
   "start": 710.48,
   "duration": 4.4,
   "text": "돌려봤습니다. 그게 채권이에요."
  },
  {
   "start": 712.88,
   "duration": 4.48,
   "text": "그러면"
  },
  {
   "start": 714.88,
   "duration": 4.72,
   "text": "이자율이 어떤게 좋을까요? 만기간"
  },
  {
   "start": 717.36,
   "duration": 4.68,
   "text": "남은게 이자율이 비쌀까요? 만기가"
  },
  {
   "start": 719.6,
   "duration": 3.56,
   "text": "적은게 이자율이 비쌀까요?"
  },
  {
   "start": 722.04,
   "duration": 4.76,
   "text": ">> 만기가 많이 남은"
  },
  {
   "start": 723.16,
   "duration": 6.64,
   "text": ">> 그렇죠. 만기가 많이 남아 있을것수록"
  },
  {
   "start": 726.8,
   "duration": 4.64,
   "text": "이자이 좋아요. 그러니까 제일 하지"
  },
  {
   "start": 729.8,
   "duration": 3.28,
   "text": "말아야 될 건 단기체는 하면 안"
  },
  {
   "start": 731.44,
   "duration": 5.2,
   "text": "되겠죠. 근데 노즘에 도움이 안"
  },
  {
   "start": 733.08,
   "duration": 6.24,
   "text": "되죠. 그런데 나는 잘 모르잖아요."
  },
  {
   "start": 736.64,
   "duration": 4.8,
   "text": "그다음에 또 뭐가 결정되냐면 국가가"
  },
  {
   "start": 739.32,
   "duration": 3.8,
   "text": "발행한 채권도 있어요. 그걸 뭐라"
  },
  {
   "start": 741.44,
   "duration": 2.72,
   "text": "그래? 국채라 그러죠.이 자리에"
  },
  {
   "start": 743.12,
   "duration": 2.04,
   "text": "비슷할까 쌀까요?"
  },
  {
   "start": 744.16,
   "duration": 2.28,
   "text": ">> 국체 쌓 거 같아요."
  },
  {
   "start": 745.16,
   "duration": 2.36,
   "text": ">> 싸죠. 왜냐 안전하니까."
  },
  {
   "start": 746.44,
   "duration": 2.64,
   "text": ">> 네."
  },
  {
   "start": 747.52,
   "duration": 5.68,
   "text": ">> 위험할수록이 자리 비싸겠죠?"
  },
  {
   "start": 749.08,
   "duration": 4.12,
   "text": ">> 네. 그럼 이제 회사체가"
  },
  {
   "start": 753.52,
   "duration": 5.84,
   "text": "가장 적당한 그 위험도 어느 정도"
  },
  {
   "start": 756.8,
   "duration": 3.96,
   "text": "컨트롤이 되고 그러면 이제 회사가"
  },
  {
   "start": 759.36,
   "duration": 3.52,
   "text": "들어가는 건데 어떤 경우는 5년"
  },
  {
   "start": 760.76,
   "duration": 3.76,
   "text": "만기도 있고 10년 만기도 있잖아요."
  },
  {
   "start": 762.88,
   "duration": 5.56,
   "text": "그걸 내가 걱정할 필요가 없죠."
  },
  {
   "start": 764.52,
   "duration": 6.24,
   "text": "ETF는 펀드 매니저가 사는 거예요."
  },
  {
   "start": 768.44,
   "duration": 4.48,
   "text": "그러니까 그 안에 30년짜리도 들어가"
  },
  {
   "start": 770.76,
   "duration": 4.24,
   "text": "있고 10년짜리 들어가 있고 5년짜리"
  },
  {
   "start": 772.92,
   "duration": 3.4,
   "text": "들어가 있습니다. 내가 걱정할 일이"
  },
  {
   "start": 775.0,
   "duration": 3.12,
   "text": "아니에요. 근데 난 언제든지 살 수"
  },
  {
   "start": 776.32,
   "duration": 4.12,
   "text": "있고 언제든지 팔 수가 있어요."
  },
  {
   "start": 778.12,
   "duration": 6.64,
   "text": "그리고 내가 채권은 살수 개인적으로"
  },
  {
   "start": 780.44,
   "duration": 6.88,
   "text": "살 수가 없어요. 왜냐 단위가 커요."
  },
  {
   "start": 784.76,
   "duration": 5.08,
   "text": "막 1천억씩 500억씩 단위이기"
  },
  {
   "start": 787.32,
   "duration": 5.64,
   "text": "때문에. 그래서 ETF가 제일 좋은"
  },
  {
   "start": 789.84,
   "duration": 5.52,
   "text": "방법이에요. 그래서 ETF에 보면"
  },
  {
   "start": 792.96,
   "duration": 5.72,
   "text": "그런게 이제 종류가 있어요. 회사체에"
  },
  {
   "start": 795.36,
   "duration": 5.6,
   "text": "투자하는 건지 국채에 투자하는 건지."
  },
  {
   "start": 798.68,
   "duration": 4.8,
   "text": "그래서 어 그 이제 그런 구별해"
  },
  {
   "start": 800.96,
   "duration": 3.6,
   "text": "보시면 돼요. 국채라면은 대부분"
  },
  {
   "start": 803.48,
   "duration": 2.92,
   "text": "이자리 싸다."
  },
  {
   "start": 804.56,
   "duration": 4.24,
   "text": ">> 그럼 10년이 5년보다는 조금 더"
  },
  {
   "start": 806.4,
   "duration": 5.16,
   "text": "이자율이 높을 텐데 이제 그런 것들을"
  },
  {
   "start": 808.8,
   "duration": 4.0,
   "text": "가지 샀다가 내가 적당한 때에 팔"
  },
  {
   "start": 811.56,
   "duration": 5.12,
   "text": "수도 있다."
  },
  {
   "start": 812.8,
   "duration": 5.32,
   "text": ">> 채권은 그 5년 만기라 그래서 그게"
  },
  {
   "start": 816.68,
   "duration": 3.56,
   "text": "거래가 안 되는게 아니에요. 계속"
  },
  {
   "start": 818.12,
   "duration": 4.84,
   "text": "거래하는 거예요. 주식처럼. 근데"
  },
  {
   "start": 820.24,
   "duration": 5.4,
   "text": "그걸 갖고 있는 사람이 채권을 팔지도"
  },
  {
   "start": 822.96,
   "duration": 4.36,
   "text": "않고 그냥 갖고 있으면 만약 10년"
  },
  {
   "start": 825.64,
   "duration": 3.16,
   "text": "만기다가 그 10년 후에 원금을 받는"
  },
  {
   "start": 827.32,
   "duration": 4.24,
   "text": "거예요. 근데 중간에 돈 필요할 수도"
  },
  {
   "start": 828.8,
   "duration": 5.32,
   "text": "있잖아요. 그러면 중간에 파는"
  },
  {
   "start": 831.56,
   "duration": 4.44,
   "text": "거예요. 그 전혀 문제 없어요."
  },
  {
   "start": 834.12,
   "duration": 4.32,
   "text": ">> 그리고 그런 걸 모아 놓은 ETF도"
  },
  {
   "start": 836.0,
   "duration": 3.2,
   "text": "있으니까 특권 ETF에 관심을"
  },
  {
   "start": 838.44,
   "duration": 3.0,
   "text": "가져보면 좋겠다."
  },
  {
   "start": 839.2,
   "duration": 4.52,
   "text": ">> 그렇죠. 그렇죠. 그래서 내 자산"
  },
  {
   "start": 841.44,
   "duration": 4.24,
   "text": "구정에서 주식형 ETF가 있고"
  },
  {
   "start": 843.72,
   "duration": 4.6,
   "text": "그러니까 내가 주식에 투자해야 된다"
  },
  {
   "start": 845.68,
   "duration": 5.24,
   "text": "그러면 내가 100이면 뭐 50월"
  },
  {
   "start": 848.32,
   "duration": 4.16,
   "text": "주식의 경 ETF에 넣고 50은"
  },
  {
   "start": 850.92,
   "duration": 3.48,
   "text": "채권형이 넣다든가"
  },
  {
   "start": 852.48,
   "duration": 3.48,
   "text": ">> 그럼 이분께 마지막으로 이제 어떤"
  },
  {
   "start": 854.4,
   "duration": 5.16,
   "text": "처방 해 주시면 좋으실지"
  },
  {
   "start": 855.96,
   "duration": 6.92,
   "text": ">> 그러니까 60대 이제 시작했으니까"
  },
  {
   "start": 859.56,
   "duration": 6.56,
   "text": "이제 그 사람마다 틀리긴 하죠. 근데"
  },
  {
   "start": 862.88,
   "duration": 5.4,
   "text": "어 재산이 뭐 다른 것 하나도 없고"
  },
  {
   "start": 866.12,
   "duration": 5.76,
   "text": "이것만 있다 그러면 이제 불안하던 건"
  },
  {
   "start": 868.28,
   "duration": 7.72,
   "text": "너무 당연한 겁니다. 근데 어 인출"
  },
  {
   "start": 871.88,
   "duration": 6.52,
   "text": "시점은 내가 투자하자마자 뭐 1년"
  },
  {
   "start": 876.0,
   "duration": 5.56,
   "text": "만에 인출하고 그럴 경우는 없거든요."
  },
  {
   "start": 878.4,
   "duration": 5.08,
   "text": "근데 많은 분들이 이제 이거 그 얼마"
  },
  {
   "start": 881.56,
   "duration": 5.08,
   "text": "벌었어 또 걸로 생활비 쓰고 또"
  },
  {
   "start": 883.48,
   "duration": 4.92,
   "text": "벌어서 근데 그거는 굉장히 어려울"
  },
  {
   "start": 886.64,
   "duration": 3.56,
   "text": "거라고 생각 들어요. 그러면 이제"
  },
  {
   "start": 888.4,
   "duration": 4.28,
   "text": "포트폴리오를 바꾸는 수밖에 없어요."
  },
  {
   "start": 890.2,
   "duration": 6.32,
   "text": "변동성이 낮은 걸로 가고 채권 비중을"
  },
  {
   "start": 892.68,
   "duration": 6.64,
   "text": "늘리고 채권에서 나오는이자 가지고"
  },
  {
   "start": 896.52,
   "duration": 5.24,
   "text": "생활비를 쓰는 수밖에 없죠."
  },
  {
   "start": 899.32,
   "duration": 4.52,
   "text": "그래서 좋은 교훈인게"
  },
  {
   "start": 901.76,
   "duration": 4.76,
   "text": "60대가 되건 70대가 되건 투자는"
  },
  {
   "start": 903.84,
   "duration": 6.24,
   "text": "당연히 해야 되는 거고 주식 비중을"
  },
  {
   "start": 906.52,
   "duration": 6.44,
   "text": "이제 몇 %로 하느냐가 중요한 거고"
  },
  {
   "start": 910.08,
   "duration": 5.08,
   "text": "또 하나 이제 좋은 교훈은 어 젊었을"
  },
  {
   "start": 912.96,
   "duration": 4.6,
   "text": "때부터 해야 된다는 거죠. 많은"
  },
  {
   "start": 915.16,
   "duration": 6.48,
   "text": "사람들이 젊었을 때는 아무 생각이"
  },
  {
   "start": 917.56,
   "duration": 6.36,
   "text": "없다가 이제 나이가 들어갔을 때 좀"
  },
  {
   "start": 921.64,
   "duration": 5.32,
   "text": "후회하는 경우가 많으니까요. 그래서"
  },
  {
   "start": 923.92,
   "duration": 7.0,
   "text": "어 이분도 60세라 그러면은 어"
  },
  {
   "start": 926.96,
   "duration": 5.88,
   "text": "은퇴를 하셨을 것 같은데 그래도"
  },
  {
   "start": 930.92,
   "duration": 4.24,
   "text": "과거한 다르게 100세이 되잖아요."
  },
  {
   "start": 932.84,
   "duration": 3.84,
   "text": "그러니까 당연히 해야 되는 거죠."
  },
  {
   "start": 935.16,
   "duration": 4.84,
   "text": "돈을 일시키는 거 당연히 해야 되죠."
  },
  {
   "start": 936.68,
   "duration": 7.28,
   "text": "근데 이제 주식 비중을 조금씩 아"
  },
  {
   "start": 940.0,
   "duration": 6.2,
   "text": "줄이는 거죠. 그러니까 아 투자는"
  },
  {
   "start": 943.96,
   "duration": 4.12,
   "text": "길게 보고 투자하는 건 그건 뭐 나이"
  },
  {
   "start": 946.2,
   "duration": 5.24,
   "text": "상관없이 해야 되는 겁니다. 그래서"
  },
  {
   "start": 948.08,
   "duration": 5.88,
   "text": "뭐 20살이건 50살이건 60살이건"
  },
  {
   "start": 951.44,
   "duration": 6.64,
   "text": "아 무조건 해야 되는 건 맞아요."
  },
  {
   "start": 953.96,
   "duration": 6.08,
   "text": "근데 어 좀 이제 나에 따라서 비중을"
  },
  {
   "start": 958.08,
   "duration": 4.96,
   "text": "주식 비중을 늘리느냐 줄이느냐의"
  },
  {
   "start": 960.04,
   "duration": 3.0,
   "text": "차이죠."
  },
  {
   "start": 975.16,
   "duration": 4.64,
   "text": "많은 분들이 저한테 질문합니다. 한"
  },
  {
   "start": 977.16,
   "duration": 6.16,
   "text": "번도 투자 안 해 봤는데 어르쳐"
  },
  {
   "start": 979.8,
   "duration": 5.88,
   "text": "주세요. 그러는데 아 제가 조언드릴"
  },
  {
   "start": 983.32,
   "duration": 5.4,
   "text": "수 있는 거는 ETF라는 거"
  },
  {
   "start": 985.68,
   "duration": 5.84,
   "text": "들어보셨겠죠? ETF를 시작하는게"
  },
  {
   "start": 988.72,
   "duration": 5.68,
   "text": "좋을 것 같고요. ETF는 어"
  },
  {
   "start": 991.52,
   "duration": 6.36,
   "text": "주식에만 투자하는게 아니에요. 또이"
  },
  {
   "start": 994.4,
   "duration": 5.08,
   "text": "채권에 투자하는 것도 있고 또 뭐"
  },
  {
   "start": 997.88,
   "duration": 3.76,
   "text": "여러 가지 다양합니다. 리치에"
  },
  {
   "start": 999.48,
   "duration": 3.64,
   "text": "투자하는 ETF도 있고 그래서 제일"
  },
  {
   "start": 1001.64,
   "duration": 3.72,
   "text": "먼저 해야 되는 건 일단 계좌를"
  },
  {
   "start": 1003.12,
   "duration": 5.0,
   "text": "여시는 건데요. 연금 조초 펀드"
  },
  {
   "start": 1005.36,
   "duration": 5.0,
   "text": "계좌를 여세요. 어 그럼 5년 동안"
  },
  {
   "start": 1008.12,
   "duration": 4.28,
   "text": "못 쳤습니다. 그렇게 해야 돼요."
  },
  {
   "start": 1010.36,
   "duration": 4.68,
   "text": "강제성이 있어야 돼요. 그래서 연금"
  },
  {
   "start": 1012.4,
   "duration": 4.96,
   "text": "저축 펀드 계좌를 여시고요. 마구니에"
  },
  {
   "start": 1015.04,
   "duration": 4.96,
   "text": "뭘 담을까 생각을 해야 되죠."
  },
  {
   "start": 1017.36,
   "duration": 4.32,
   "text": "그래서 여러분들 스스로가 ETF에"
  },
  {
   "start": 1020.0,
   "duration": 4.08,
   "text": "대해서 좀 알아볼 필요가 있어요."
  },
  {
   "start": 1021.68,
   "duration": 4.48,
   "text": "그래서 제일 중요한 거는 내 비중을"
  },
  {
   "start": 1024.08,
   "duration": 4.68,
   "text": "정하는 거예요. 내가 지금 나이가"
  },
  {
   "start": 1026.16,
   "duration": 5.8,
   "text": "50이다, 60이다. 그러면 내 주식"
  },
  {
   "start": 1028.76,
   "duration": 6.24,
   "text": "비중이 50%가 돼야 되겠느냐, 뭐"
  },
  {
   "start": 1031.96,
   "duration": 4.88,
   "text": "40%가 돼야 되지 정하고 채권"
  },
  {
   "start": 1035.0,
   "duration": 3.96,
   "text": "채권은 변동성이 좀 덜해요. 대신에"
  },
  {
   "start": 1036.84,
   "duration": 4.32,
   "text": "이자를 받습니다. 그 채권에 투자하는"
  },
  {
   "start": 1038.96,
   "duration": 4.56,
   "text": "ETF가 뭐가 있는지 그다음에"
  },
  {
   "start": 1041.16,
   "duration": 5.16,
   "text": "부동산에 투자하는 ETF가 뭐가"
  },
  {
   "start": 1043.52,
   "duration": 6.0,
   "text": "있는지 생각보다 간단합니다."
  },
  {
   "start": 1046.32,
   "duration": 7.04,
   "text": "그래서 그 비중을 정하는 거예요."
  },
  {
   "start": 1049.52,
   "duration": 6.8,
   "text": "그리고 아 그 정한 비중 안에서"
  },
  {
   "start": 1053.36,
   "duration": 5.04,
   "text": "골라보는 거예요. 근데 좌석 영상"
  },
  {
   "start": 1056.32,
   "duration": 3.88,
   "text": "굉장히 많잖아요. 뭐 삼성도 있고"
  },
  {
   "start": 1058.4,
   "duration": 5.08,
   "text": "미래도 있고 뭐 한국 투자도 있고"
  },
  {
   "start": 1060.2,
   "duration": 6.04,
   "text": "많습니다. 근데 ETF는 다 있어요."
  },
  {
   "start": 1063.48,
   "duration": 5.48,
   "text": "그래서 그 우리가 슈퍼마켓 가면은"
  },
  {
   "start": 1066.24,
   "duration": 4.84,
   "text": "라면을 사잖아요. 라면은 뭐 삼양"
  },
  {
   "start": 1068.96,
   "duration": 4.72,
   "text": "라면도 있고 롯데 라면도 있고 뭐"
  },
  {
   "start": 1071.08,
   "duration": 5.84,
   "text": "농심도 있고 많잖아요. 라면은 똑같은"
  },
  {
   "start": 1073.68,
   "duration": 6.24,
   "text": "거예요. 그러니까 너무 어렵다고"
  },
  {
   "start": 1076.92,
   "duration": 5.04,
   "text": "생각하지 마시고 골라보는 거고요. 한"
  },
  {
   "start": 1079.92,
   "duration": 3.68,
   "text": "가지 주의해야 될 거는 절대 빚내서"
  },
  {
   "start": 1081.96,
   "duration": 4.44,
   "text": "하면 안 된다는 거. 그다음에"
  },
  {
   "start": 1083.6,
   "duration": 5.52,
   "text": "여의적으로 해야 된다는 거. 그리고"
  },
  {
   "start": 1086.4,
   "duration": 5.36,
   "text": "어 나는 주인이다. 그런 말에 소금"
  },
  {
   "start": 1089.12,
   "duration": 4.2,
   "text": "속으면 안 돼요. 나는 경험이 없어."
  },
  {
   "start": 1091.76,
   "duration": 3.76,
   "text": "그러면 경험이 많은 사람 나보다"
  },
  {
   "start": 1093.32,
   "duration": 5.96,
   "text": "똑똑할까? 절대로 그렇지 않습니다."
  },
  {
   "start": 1095.52,
   "duration": 6.16,
   "text": "그리고 그 리딩박 그런 감원이서를"
  },
  {
   "start": 1099.28,
   "duration": 4.8,
   "text": "하는 사람들 조심하셔야 됩니다. 그"
  },
  {
   "start": 1101.68,
   "duration": 4.84,
   "text": "사람들 절대 전문가가 아니에요."
  },
  {
   "start": 1104.08,
   "duration": 4.68,
   "text": "여러분들이 전문가라는 생각도 그 잊지"
  },
  {
   "start": 1106.52,
   "duration": 4.4,
   "text": "마시고요. 하다 보면 하나씩 배우게"
  },
  {
   "start": 1108.76,
   "duration": 5.32,
   "text": "돼요. 그러니까 제일 중요한 거는"
  },
  {
   "start": 1110.92,
   "duration": 5.6,
   "text": "당장 시작하셔라. 그리고 여러분들"
  },
  {
   "start": 1114.08,
   "duration": 5.32,
   "text": "충분히 할 수 있어요. 그렇게 제가"
  },
  {
   "start": 1116.52,
   "duration": 6.04,
   "text": "도움을 드리고 싶어요. 그래서 이분도"
  },
  {
   "start": 1119.4,
   "duration": 7.0,
   "text": "어 도움이 됐으면 좋겠네요. 그래서"
  },
  {
   "start": 1122.56,
   "duration": 6.28,
   "text": "가능한한 그 투자의 제일 좋은 시점은"
  },
  {
   "start": 1126.4,
   "duration": 4.8,
   "text": "지금이다. 그렇게 생각하시면 되고요."
  },
  {
   "start": 1128.84,
   "duration": 5.24,
   "text": "아 무조건 해야 되고 계좌를 여셔야"
  },
  {
   "start": 1131.2,
   "duration": 5.44,
   "text": "되고 너무 그렇게 급하게 걱정하지"
  },
  {
   "start": 1134.08,
   "duration": 5.04,
   "text": "마시고 60세 60세에 맞게 70은"
  },
  {
   "start": 1136.64,
   "duration": 4.52,
   "text": "70세에 맞게 반드시 투자를 하셔야"
  },
  {
   "start": 1139.12,
   "duration": 5.08,
   "text": "됩니다. 여러분 도움이 됐으면"
  },
  {
   "start": 1141.16,
   "duration": 6.76,
   "text": "좋겠고요. 또 저는 또 다음 시간에"
  },
  {
   "start": 1144.2,
   "duration": 3.72,
   "text": "뵙도록 하겠습니다. 습니다."
  }
 ]
}