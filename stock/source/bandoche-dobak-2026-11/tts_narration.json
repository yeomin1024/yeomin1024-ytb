 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "젠슨 황의 불륜 사실이 드러나면서, 엔비디아 주가 하락은 물론, 반등하고 있던 반도체, AI 관련 주식들의 주가도 다시 하락하기 시작했죠.",
   "start": 0.3,
   "end": 9.806
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "일부 증권가에서는, CEO 리스크 문제와 AI 투자 흐름은 별개이고, 장기적으로 큰 기업들의 AI 투자는 줄지 않는다는 분석도 있는데요.",
   "start": 10.186,
   "end": 19.33
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "그 말대로 정말 지금이 매수 기회일까요, 아니면 결과를 모르고 돈을 거는 도박일까요?",
   "start": 19.71,
   "end": 25.374
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "젠슨 황 퇴진으로 인한 어떤 리스크가 있는지, 반도체, AI 관련 주식에는 어떤 영향이 있는지 알아보겠습니다.",
   "start": 25.754,
   "end": 32.659
  },
  {
   "n": 5,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "이번 젠슨 황 이슈로 인한 리스크는 세 가지입니다.",
   "start": 33.659,
   "end": 36.607
  },
  {
   "n": 6,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "첫 번째는 칩 밀수출 수사입니다.",
   "start": 36.987,
   "end": 39.157
  },
  {
   "n": 7,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "젠슨 황과 가까웠던 여성은, 싱가포르의 엔비디아 고객사 메가스피드의 임원이었습니다.",
   "start": 39.537,
   "end": 45.005
  },
  {
   "n": 8,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "뉴욕타임스 보도에 따르면, 미국 정보 당국은 이 여성을 중국 간첩으로 보고 있습니다.",
   "start": 45.385,
   "end": 50.641
  },
  {
   "n": 9,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "메가스피드는 지난 2년 동안 엔비디아 칩을 48억 달러어치 넘게 샀습니다.",
   "start": 51.021,
   "end": 55.891
  },
  {
   "n": 10,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "수사 당국은 이 경로로, 중국 수출이 금지된 칩 24만 개가 넘어갔는지 보고 있습니다.",
   "start": 56.271,
   "end": 61.788
  },
  {
   "n": 11,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "비슷한 사례가 있습니다.",
   "start": 62.168,
   "end": 63.447
  },
  {
   "n": 12,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "2023년, 시게이트는 화웨이에 허가 없이 하드디스크를 팔았습니다.",
   "start": 63.827,
   "end": 68.389
  },
  {
   "n": 13,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "미국 상무부는 시게이트에 3억 달러 벌금을 매겼습니다.",
   "start": 68.769,
   "end": 72.069
  },
  {
   "n": 14,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "어기면 수출을 막는다는 조건도 5년 동안 붙였습니다.",
   "start": 72.449,
   "end": 75.431
  },
  {
   "n": 15,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "벌금이 발표된 날 시게이트 주가는 2.19% 내렸습니다.",
   "start": 75.811,
   "end": 79.7
  },
  {
   "n": 16,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "다음 날에는 실적 부진까지 겹쳐 9.2% 더 빠졌습니다.",
   "start": 80.08,
   "end": 83.968
  },
  {
   "n": 17,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "이틀 만에 11% 넘게 빠진 것입니다.",
   "start": 84.348,
   "end": 86.953
  },
  {
   "n": 18,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "엔비디아도 수사 결과에 따라 벌금과 판매 제한을 받을 수 있습니다.",
   "start": 87.333,
   "end": 91.373
  },
  {
   "n": 19,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "두 번째는 칩 수출 규칙이 더 엄해지는 것입니다.",
   "start": 91.753,
   "end": 94.655
  },
  {
   "n": 20,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "그러면 엔비디아가 칩을 팔 수 있는 곳이 줄어듭니다.",
   "start": 95.035,
   "end": 97.913
  },
  {
   "n": 21,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "미국 의회는 젠슨 황과, 수출을 관리하는 상무부 장관까지 불러 증언을 듣기로 했습니다.",
   "start": 98.293,
   "end": 104.112
  },
  {
   "n": 22,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "여기에 미국이 AI 칩 수출 통제 대상에 일곱 나라를 더한다는 보도도 나왔습니다.",
   "start": 104.492,
   "end": 109.142
  },
  {
   "n": 23,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "싱가포르, 말레이시아, 태국, 인도네시아 등입니다.",
   "start": 109.522,
   "end": 113.145
  },
  {
   "n": 24,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "빠르면 이달 안에 발표될 수 있다고 합니다.",
   "start": 113.525,
   "end": 115.695
  },
  {
   "n": 25,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "엔비디아에게 이 나라들은 작은 시장이 아닙니다.",
   "start": 116.075,
   "end": 118.969
  },
  {
   "n": 26,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "작년 한 분기에는 엔비디아 매출의 20%를, 싱가포르에서 대금을 치른 고객들이 냈습니다.",
   "start": 119.349,
   "end": 125.078
  },
  {
   "n": 27,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "칩이 모두 싱가포르로 간 건 아니지만, 그만큼 큰 고객들이 이 지역에 있습니다.",
   "start": 125.458,
   "end": 130.284
  },
  {
   "n": 28,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "이 나라들에 팔 때마다 허가가 필요해지면, 판매가 늦어지거나 줄 수 있습니다.",
   "start": 130.664,
   "end": 135.06
  },
  {
   "n": 29,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "세 번째는 CEO 자리가 비었다는 것입니다.",
   "start": 135.44,
   "end": 137.96
  },
  {
   "n": 30,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "그러면 미국 정부와의 협상이 약해질 수 있습니다.",
   "start": 138.34,
   "end": 141.08
  },
  {
   "n": 31,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "젠슨 황은 몇 달 동안 미국 정부를 설득한 끝에, 작년 12월 중국 판매 허가를 받아 냈습니다.",
   "start": 141.46,
   "end": 147.429
  },
  {
   "n": 32,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "지금은 재무 책임자가 임시 CEO를 맡고 있고, 정식 CEO는 언제 정해질지 모릅니다.",
   "start": 147.809,
   "end": 153.159
  },
  {
   "n": 33,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "게다가 중국과 얽힌 의혹까지 생겨서, 협상은 더 어려워질 수 있습니다.",
   "start": 153.539,
   "end": 157.616
  },
  {
   "n": 34,
   "role": "host",
   "part": "현재 해결되지 않은 리스크들",
   "text": "그럼 이 리스크들로 인해, 반도체와 AI 관련 주식에는 어떤 영향이 있을까요?",
   "start": 157.996,
   "end": 162.736
  },
  {
   "n": 35,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "앞서 말한 리스크가 좋게 해소되면, 주가 반등을 기대해 볼 수 있습니다.",
   "start": 163.736,
   "end": 167.715
  },
  {
   "n": 36,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "하지만 엔비디아에도 책임이 있다고 나오거나, 동남아 수출 규칙이 엄해질 수 있습니다.",
   "start": 168.095,
   "end": 172.895
  },
  {
   "n": 37,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "그러면 다른 반도체와 AI 관련 주식도 같이 빠질 수 있습니다.",
   "start": 173.275,
   "end": 177.204
  },
  {
   "n": 38,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "특히 에스케이하이닉스는 엔비디아 소식에 더 크게 흔들립니다.",
   "start": 177.584,
   "end": 181.821
  },
  {
   "n": 39,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "엔비디아 차세대 칩의 고성능 메모리, HBM의 약 3분의 2를 맡고 있어서입니다.",
   "start": 182.201,
   "end": 187.31
  },
  {
   "n": 40,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "길게 보면, 증권가 말대로 큰 기업들의 AI 투자는 줄지 않을 수도 있습니다.",
   "start": 187.69,
   "end": 192.51
  },
  {
   "n": 41,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "하지만 칩을 팔 수 있는 나라가 줄면, 투자가 이어져도 엔비디아 몫은 줄 수 있습니다.",
   "start": 192.89,
   "end": 197.605
  },
  {
   "n": 42,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "그러면 HBM 주문과, 삼성전자와 에스케이하이닉스의 이익 전망도 깎일 수 있습니다.",
   "start": 197.985,
   "end": 203.555
  },
  {
   "n": 43,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "한마디로, 지금은 수사와 증언 결과 하나에 주가가 크게 갈립니다.",
   "start": 203.935,
   "end": 208.184
  },
  {
   "n": 44,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "그리고 그 결과는 아무도 미리 알 수 없습니다.",
   "start": 208.564,
   "end": 211.304
  },
  {
   "n": 45,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "따라서 지금 반도체, AI 관련 주식에 투자하는 건 도박이나 마찬가지입니다.",
   "start": 211.684,
   "end": 216.635
  },
  {
   "n": 46,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "주가가 떨어졌다고, 싸게 매수할 수 있는 기회가 아닙니다.",
   "start": 217.015,
   "end": 220.373
  },
  {
   "n": 47,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "싼지 비싼지를 정하는 이익 전망부터 흔들리고 있기 때문입니다.",
   "start": 220.753,
   "end": 224.389
  },
  {
   "n": 48,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "그렇기 때문에 리스크가 해소되기 전에는, 반도체와 AI 관련 주식을 신규 매수하거나 물타기하지 않는 것이 좋습니다.",
   "start": 224.769,
   "end": 231.929
  },
  {
   "n": 49,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "지금까지 젠슨 황 퇴진으로 생긴 리스크와 그 영향에 대해 알아보았습니다.",
   "start": 232.309,
   "end": 236.409
  },
  {
   "n": 50,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "오늘 내용은 지금까지의 보도를 바탕으로 했고, 수사 결과에 따라 달라질 수 있습니다.",
   "start": 236.789,
   "end": 241.908
  },
  {
   "n": 51,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "제 생각을 한마디 하자면, 한 사람의 문제가 업종 전체를 흔들 수 있다는 겁니다.",
   "start": 242.288,
   "end": 247.056
  },
  {
   "n": 52,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "그래서 한 업종에 몰아 두지 않는 것이, 이런 일에 가장 확실한 대비라고 생각합니다.",
   "start": 247.436,
   "end": 252.138
  },
  {
   "n": 53,
   "role": "host",
   "part": "결과에 따른 장단기 여파",
   "text": "시청해주셔서 감사합니다.",
   "start": 252.518,
   "end": 254.048
  }
 ],
 "voice_sha1": "67155a53ae90a91a"
