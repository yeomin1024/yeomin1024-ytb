 "segments": [
  {
   "start": 0.0,
   "duration": 3.36,
   "text": "S&P 500도 역사적인 고평가에 지금 와 있는 상황이에요."
  },
  {
   "start": 3.36,
   "duration": 5.16,
   "text": "정립수구로 장기적으로 계속 투자한다라고 하는 생각은 어떤 사람이 있었어요."
  },
  {
   "start": 8.52,
   "duration": 2.36,
   "text": "지금부터도 시작을 해야 되나요?"
  },
  {
   "start": 10.88,
   "duration": 1.48,
   "text": "기다렸다 빠졌다 해야 돼?"
  },
  {
   "start": 12.36,
   "duration": 2.08,
   "text": "이런 고민 분명히 할 거라고요."
  },
  {
   "start": 14.44,
   "duration": 2.32,
   "text": "모든 사람들이 거기에 대한 의견을 어떠세요?"
  },
  {
   "start": 16.76,
   "duration": 1.68,
   "text": "S&P는 괜찮다."
  },
  {
   "start": 18.44,
   "duration": 3.32,
   "text": "단, 목도로 투자하신 분에 대해서는 부담됩니다."
  },
  {
   "start": 21.76,
   "duration": 1.0,
   "text": "한 번에 놓지 말아요."
  },
  {
   "start": 22.76,
   "duration": 1.12,
   "text": "그 말씀 하시는 거죠?"
  },
  {
   "start": 23.88,
   "duration": 3.24,
   "text": "그러나 정리 씨라는 것은 정리 씨의 가장 큰 의견이 있죠."
  },
  {
   "start": 27.12,
   "duration": 2.12,
   "text": "사실은 지수가 빠질 때가 아니겠습니까?"
  },
  {
   "start": 29.4,
   "duration": 1.0,
   "text": "그렇죠."
  },
  {
   "start": 30.4,
   "duration": 3.0,
   "text": "지수가 빠졌을 때 더 많은 주식을 살 수가 있고"
  },
  {
   "start": 33.4,
   "duration": 1.76,
   "text": "그게 정리 씨의 심을 발휘하는 거기 때문에"
  },
  {
   "start": 35.16,
   "duration": 1.0,
   "text": "그래서 코..."
  },
  {
   "start": 36.16,
   "duration": 2.2,
   "text": "그래서 오히려 정리 씨를 투자하시는 분들은"
  },
  {
   "start": 38.36,
   "duration": 3.32,
   "text": "사실은 젊은 사람들은 지금 심하게 말하면"
  },
  {
   "start": 41.68,
   "duration": 1.28,
   "text": "빠지는 거 원해야 돼요."
  },
  {
   "start": 42.96,
   "duration": 1.0,
   "text": "그렇죠."
  },
  {
   "start": 43.96,
   "duration": 2.8,
   "text": "빠져서 자기가 정립하는 동안에 많이 샀다가"
  },
  {
   "start": 46.76,
   "duration": 2.0,
   "text": "자기가 은퇴한 시점에서 확 올라와주면"
  },
  {
   "start": 48.76,
   "duration": 1.0,
   "text": "그게 베스트인 거죠."
  }
 ]
}