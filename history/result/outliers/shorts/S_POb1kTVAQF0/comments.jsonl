{"id": "UgxCBNHF0Yst4KOq8Zl4AaABAg", "parent": null, "likes": 6, "text": "F4 한명 나왔넹 ㅋㅋㅋ", "published": "2026-05-18T13:48:17", "replies": 0, "creator": false}
