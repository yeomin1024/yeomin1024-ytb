{"id": "UgzBY3gW14Y_J5FeIMd4AaABAg.AXZ_S6PXSRxAYvhXsoJWcN", "parent": "UgzBY3gW14Y_J5FeIMd4AaABAg", "likes": 3, "text": "힘내시구 빠른 쾌유 기원드립니다", "published": "2026-07-06T15:19:38", "replies": 0, "creator": false}
