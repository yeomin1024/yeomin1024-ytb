  {
   "n": 66,
   "role": "host",
   "part": "실제로 바뀐 것",
   "text": "항공권과 여권을 보여 주고, 소유권 포기서에 서명하면 돼요.",
   "start": 269.58,
   "end": 273.19
  },
  {
   "n": 67,
   "role": "host",
   "part": "실제로 바뀐 것",
   "text": "주부공항은 1,200엔에 받아 주고, 2,200엔에 수거해 가는 민간 업체도 있습니다.",
   "start": 273.64,
   "end": 278.78
  },
  {
   "n": 68,
   "role": "host",
   "part": "실제로 바뀐 것",
   "text": "떠나기 전에 이용할 공항이나 숙소에 먼저 물어보는 게 가장 확실합니다.",
   "start": 279.23,
   "end": 283.22
  },
  {
   "n": 69,
   "role": "host",
   "part": "정리",
   "text": "자, 마지막으로 오늘 내용을 정리하겠습니다.",
