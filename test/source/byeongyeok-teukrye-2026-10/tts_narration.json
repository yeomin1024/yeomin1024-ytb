 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "아시안게임 축구 금메달 뒤, 병역특례를 없애자는 말까지 나왔습니다.",
   "start": 0.3,
   "end": 4.62
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "일부 선수의 '전역모' 사진과, 군 면제만 바라봤다는 말이 시작이었죠.",
   "start": 5.0,
   "end": 9.488
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "선수들은 사과했습니다.",
   "start": 9.868,
   "end": 11.228
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "하지만 국방부는 예술·체육요원을 포함한 보충역을 줄이고 없애겠다고 밝혔습니다.",
   "start": 11.608,
   "end": 16.817
  },
  {
   "n": 5,
   "role": "host",
   "part": "도입",
   "text": "관련 뉴스 영상에는 이번 선수들부터 적용하라는 댓글이 좋아요를 수천 개씩 받았습니다.",
   "start": 17.197,
   "end": 22.646
  },
  {
   "n": 6,
   "role": "host",
   "part": "도입",
   "text": "그럼 이번 금메달리스트의 병역특례도 취소할 수 있을까요?",
   "start": 23.026,
   "end": 26.229
  },
  {
   "n": 7,
   "role": "host",
   "part": "도입",
   "text": "결론부터 말하면, 지금 병역법에는 말이나 태도로 편입을 취소하는 규정이 없습니다.",
   "start": 26.609,
   "end": 31.699
  },
  {
   "n": 8,
   "role": "host",
   "part": "도입",
   "text": "또 이미 딴 금메달에 새 기준을 적용하는 건, 법조계에서 어렵다고 보는 시각이 많습니다.",
   "start": 32.079,
   "end": 37.486
  },
  {
   "n": 9,
   "role": "host",
   "part": "도입",
   "text": "정부가 밝힌 것도 아직은 방향뿐입니다.",
   "start": 37.866,
   "end": 40.222
  },
  {
   "n": 10,
   "role": "host",
   "part": "도입",
   "text": "왜 그런지, 다섯 가지로 정리하겠습니다.",
   "start": 40.602,
   "end": 43.102
  },
  {
   "n": 11,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "첫 번째는 병역특례가 무엇인가입니다.",
   "start": 44.102,
   "end": 46.354
  },
  {
   "n": 12,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "흔히 '군 면제'라고 부르지만, 법에 적힌 이름은 '예술·체육요원'입니다.",
   "start": 46.734,
   "end": 51.214
  },
  {
   "n": 13,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "병역법은 이들이 문화창달과 국위선양을 위해 복무한다고 정해 두었어요.",
   "start": 51.594,
   "end": 55.994
  },
  {
   "n": 14,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "현역병으로 입영할 사람이 편입되면, 보충역이 됩니다.",
   "start": 56.374,
   "end": 59.824
  },
  {
   "n": 15,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "의무복무기간은 2년 10개월이고, 그동안 자기 분야에서 활동하는 것이 곧 복무입니다.",
   "start": 60.204,
   "end": 65.392
  },
  {
   "n": 16,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "대신 편입되고 1년 안에 군사교육을 받아야 합니다.",
   "start": 65.772,
   "end": 68.661
  },
  {
   "n": 17,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "그리고 특기를 살린 공익복무를 544시간 채워야 합니다.",
   "start": 69.041,
   "end": 72.774
  },
  {
   "n": 18,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "공익복무는 취약계층이나 어린이, 청소년을 위한 지도와 교육 같은 활동이에요.",
   "start": 73.154,
   "end": 78.004
  },
  {
   "n": 19,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "분기마다 최소 24시간은 해야 합니다.",
   "start": 78.384,
   "end": 80.773
  },
  {
   "n": 20,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "2년 10개월을 마치면, 사회복무요원 복무를 마친 것으로 봅니다.",
   "start": 81.153,
   "end": 85.256
  },
  {
   "n": 21,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "현역으로 입대하지 않는 건 맞지만, 병역 의무가 사라지는 건 아닌 거죠.",
   "start": 85.636,
   "end": 89.796
  },
  {
   "n": 22,
   "role": "host",
   "part": "첫째, 병역특례는 면제가 아니다",
   "text": "그럼 누가, 어떻게 이 자격을 얻는 걸까요?",
   "start": 90.176,
   "end": 92.849
  },
  {
   "n": 23,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "두 번째는 자격을 얻는 방법입니다.",
   "start": 93.849,
   "end": 95.916
  },
  {
   "n": 24,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "체육 분야 기준은 병역법 시행령에 두 줄로 적혀 있습니다.",
   "start": 96.296,
   "end": 99.684
  },
  {
   "n": 25,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "올림픽 3위 이상, 그리고 아시아경기대회 1위입니다.",
   "start": 100.064,
   "end": 103.737
  },
  {
   "n": 26,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "단체 종목은 금메달을 딴 팀의 선수가 모두 대상이 됩니다.",
   "start": 104.117,
   "end": 107.634
  },
  {
   "n": 27,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "그래서 이번 축구 대표팀에선 1분도 안 뛴 선수 2명도 대상이 됐다는 보도가 나왔습니다.",
   "start": 108.014,
   "end": 113.157
  },
  {
   "n": 28,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "메달을 따면 바로 편입되는 것도 아닙니다.",
   "start": 113.537,
   "end": 115.977
  },
  {
   "n": 29,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "본인이 원하면 추천원서를 문화체육관광부에 냅니다.",
   "start": 116.357,
   "end": 119.449
  },
  {
   "n": 30,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "문체부가 14일 안에 병무청에 명단을 알리면, 병무청장이 편입합니다.",
   "start": 119.829,
   "end": 124.579
  },
  {
   "n": 31,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "보도된 문체부 자료를 보면, 2022년부터 올해 8월까지 편입된 체육요원은 80명입니다.",
   "start": 124.959,
   "end": 131.175
  },
  {
   "n": 32,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "그 가운데 65명이 아시안게임 금메달로 편입됐습니다.",
   "start": 131.555,
   "end": 135.139
  },
  {
   "n": 33,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "열 명 중 여덟 명꼴입니다.",
   "start": 135.519,
   "end": 137.169
  },
  {
   "n": 34,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "이 제도는 1973년에 처음 생겨, 50년 넘게 이어져 왔습니다.",
   "start": 137.549,
   "end": 142.219
  },
  {
   "n": 35,
   "role": "host",
   "part": "둘째, 누가 어떻게 받나",
   "text": "그렇다면 이렇게 얻은 자격은 취소할 수 없을까요?",
   "start": 142.599,
   "end": 145.485
  },
  {
   "n": 36,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "세 번째는 편입이 취소되는 경우입니다.",
   "start": 146.485,
   "end": 148.781
  },
  {
   "n": 37,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "병역법에는 예술·체육요원의 편입을 취소하는 경우가 일곱 가지로 적혀 있습니다.",
   "start": 149.161,
   "end": 153.92
  },
  {
   "n": 38,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "하나, 허가 없이 나라 밖으로 나갔거나 기간 안에 돌아오지 않은 경우.",
   "start": 154.3,
   "end": 158.68
  },
  {
   "n": 39,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "둘, 귀국 명령을 어긴 경우.",
   "start": 159.06,
   "end": 160.932
  },
  {
   "n": 40,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "셋, 8일 이상 복무를 이탈하는 등 복무 위반으로 형을 선고받은 경우.",
   "start": 161.312,
   "end": 165.807
  },
  {
   "n": 41,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "넷, 금품을 주고받는 등 부정한 방법으로 편입된 경우.",
   "start": 166.187,
   "end": 169.847
  },
  {
   "n": 42,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "다섯, 승부조작 같은 부정행위로 형을 선고받은 경우.",
   "start": 170.227,
   "end": 173.403
  },
  {
   "n": 43,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "여섯, 복무 중 범죄로 금고 이상의 실형을 선고받은 경우.",
   "start": 173.783,
   "end": 177.393
  },
  {
   "n": 44,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "일곱, 공익복무를 못 채워 기간이 늘어난 뒤에도 1년 안에 마치지 못한 경우입니다.",
   "start": 177.773,
   "end": 182.603
  },
  {
   "n": 45,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "말이나 태도는 이 일곱 가지에 들어 있지 않습니다.",
   "start": 182.983,
   "end": 185.619
  },
  {
   "n": 46,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "실제로 취소된 경우도 공익복무 문제였습니다.",
   "start": 185.999,
   "end": 188.939
  },
  {
   "n": 47,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "병무청이 국회에 낸 자료를 보면, 2022년부터 올해 8월까지 취소된 사람은 7명입니다.",
   "start": 189.319,
   "end": 195.218
  },
  {
   "n": 48,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "모두 공익복무를 채우지 못한 경우였어요.",
   "start": 195.598,
   "end": 197.867
  },
  {
   "n": 49,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "분기 기준을 못 채우면 경고를 받고, 그때마다 복무가 5일씩 늘어납니다.",
   "start": 198.247,
   "end": 203.065
  },
  {
   "n": 50,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "모자란 시간의 두 배를 더 해야 하고요.",
   "start": 203.445,
   "end": 205.866
  },
  {
   "n": 51,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "공익복무 실적을 거짓으로 내면, 한 번만으로도 형사처벌 대상이 됩니다.",
   "start": 206.246,
   "end": 210.796
  },
  {
   "n": 52,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "편입이 취소되면 다시 편입될 수 없고, 현역병이나 사회복무요원으로 복무해야 합니다.",
   "start": 211.176,
   "end": 216.551
  },
  {
   "n": 53,
   "role": "host",
   "part": "셋째, 법에 적힌 취소 사유 일곱 가지",
   "text": "그럼 법을 바꿔서 이번 선수들에게 적용하는 건 어떨까요?",
   "start": 216.931,
   "end": 220.265
  },
  {
   "n": 54,
   "role": "host",
   "part": "넷째, 이번 선수들에게도 적용될까",
   "text": "네 번째는 댓글에서 가장 많이 나온 요구, 소급 적용입니다.",
   "start": 221.265,
   "end": 225.001
  },
  {
   "n": 55,
   "role": "host",
   "part": "넷째, 이번 선수들에게도 적용될까",
   "text": "아시안게임 1위 기준은 법률이 아니라, 대통령령인 시행령에 적혀 있습니다.",
   "start": 225.381,
   "end": 229.961
  },
  {
   "n": 56,
   "role": "host",
   "part": "넷째, 이번 선수들에게도 적용될까",
   "text": "그래서 정부가 시행령만 고쳐도, 국회를 거치지 않고 기준을 바꿀 수 있습니다.",
   "start": 230.341,
   "end": 235.219
  },
  {
   "n": 57,
   "role": "host",
   "part": "넷째, 이번 선수들에게도 적용될까",
   "text": "하지만 이미 금메달을 딴 선수에게 바뀐 기준을 적용하는 건 다른 문제입니다.",
   "start": 235.599,
   "end": 240.044
  },
  {
   "n": 58,
