 "items": [
  {
   "n": 1,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "2025년 4월, 유나이티드헬스 주가가 하루 만에 22% 넘게 떨어졌어요.",
   "start": 0.3,
   "end": 7.63
  },
  {
   "n": 2,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "미국 최대 건강보험사인데 의료비가 예상보다 많이 나가 실적 전망을 낮췄대요.",
   "start": 8.08,
   "end": 14.05
  },
  {
   "n": 3,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "이렇게 큰 회사가 망하진 않을 테니 지금이 싸게 살 때라고 생각했어요.",
   "start": 14.5,
   "end": 19.99
  },
  {
   "n": 4,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "모아 둔 8천만 원 중 5천만 원으로 먼저 샀죠.",
   "start": 20.44,
   "end": 24.26
  },
  {
   "n": 5,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "그런데 일주일 만에 -200만 원이 됐어요.",
   "start": 24.71,
   "end": 29.8
  },
  {
   "n": 6,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "평단을 낮추면 된다는 말만 믿고 그날 바로 1,500만 원을 더 샀어요.",
   "start": 30.25,
   "end": 36.37
  },
  {
   "n": 7,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "주가가 더 떨어지자 남은 1,500만 원까지 넣었죠.",
   "start": 36.82,
   "end": 41.44
  },
  {
   "n": 8,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "평단이 내려갔으니 조금만 반등해도 본전이라고 생각했어요.",
   "start": 41.89,
   "end": 47.14
  },
  {
   "n": 9,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "하지만 반등은 끝내 오지 않았습니다.",
   "start": 47.59,
   "end": 50.69
  },
  {
   "n": 10,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "5월 14일 아침, 눈을 뜨자마자 계좌를 열었더니 -2천만 원이 찍혀 있었어요.",
   "start": 51.14,
   "end": 59.19
  },
  {
   "n": 11,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "밤사이 회사가 그해 실적 전망을 아예 거둬들이고 CEO까지 물러났다는 소식이 나왔더라고요.",
   "start": 59.64,
   "end": 68.34
  },
  {
   "n": 12,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "주가는 하루 만에 18% 가까이 빠졌고요.",
   "start": 68.79,
   "end": 71.97
  },
  {
   "n": 13,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "평단을 낮추려고 넣은 3천만 원이 오히려 손실만 키운 셈이에요.",
   "start": 72.42,
   "end": 78.55
  },
  {
   "n": 14,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "물타기 버튼을 누른 제 손가락이 원망스러워요.",
   "start": 79.0,
   "end": 83.06
  },
  {
   "n": 15,
   "role": "host",
   "part": "진행자 파트",
   "text": "산 종목이 계속 떨어질 때 많은 분들이 이런 생각을 하죠.",
   "start": 84.06,
   "end": 87.71
  },
  {
   "n": 16,
   "role": "host",
   "part": "진행자 파트",
   "text": "평단만 낮추면 조금만 올라도 본전이야.",
   "start": 88.16,
   "end": 90.82
  },
  {
   "n": 17,
   "role": "host",
   "part": "진행자 파트",
   "text": "이렇게 큰 회사가 설마 망하겠어?",
   "start": 91.27,
   "end": 93.58
  },
  {
   "n": 18,
   "role": "host",
   "part": "진행자 파트",
   "text": "여기서 팔면 손실이 확정되잖아.",
   "start": 94.03,
   "end": 96.16
  },
  {
   "n": 19,
   "role": "host",
   "part": "진행자 파트",
   "text": "이런 식으로 손실을 인정하기 싫은 마음이 기준 없는 물타기로 이어집니다.",
   "start": 96.61,
   "end": 100.79
  },
  {
   "n": 20,
   "role": "host",
   "part": "진행자 파트",
   "text": "실제로 2025년 5월 한 달간 서학개미는 이 종목을 4,800억 원 넘게 순매수했습니다.",
   "start": 101.24,
   "end": 107.75
  },
  {
   "n": 21,
   "role": "host",
   "part": "진행자 파트",
   "text": "미국 주식에 투자하는 국내 투자자들이 그달 가장 많이 사들인 종목이었죠.",
   "start": 108.2,
   "end": 113.4
  },
  {
   "n": 22,
   "role": "host",
   "part": "진행자 파트",
   "text": "사연 속 이야기가 결코 남의 일이 아닌 이유입니다.",
   "start": 113.85,
   "end": 117.16
  },
  {
   "n": 23,
   "role": "host",
   "part": "진행자 파트",
   "text": "그럼 기준 없는 물타기가 왜 위험한지 하나씩 살펴보겠습니다.",
   "start": 117.61,
   "end": 121.9
  },
  {
   "n": 24,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "첫 번째 문제는 평단은 조금 내려가도 걸린 돈은 크게 늘어난다는 것입니다.",
   "start": 129.9,
   "end": 134.79
  },
  {
   "n": 25,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사연자는 물타기로 3천만 원을 더 넣었습니다.",
   "start": 135.24,
   "end": 138.53
  },
  {
   "n": 26,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그 덕에 평단은 428달러에서 415달러로 3% 정도 내려갔습니다.",
   "start": 138.98,
   "end": 144.37
  },
  {
   "n": 27,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "대신 한 종목에 걸린 돈은 5천만 원에서 8천만 원으로 60%나 늘었죠.",
   "start": 144.82,
   "end": 149.52
  },
  {
   "n": 28,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그래서 폭락한 날, 물타기를 안 했을 때보다 손실이 600만 원 넘게 커졌습니다.",
   "start": 149.97,
   "end": 155.4
  },
  {
   "n": 29,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "평단을 낮춘다는 건 사실 같은 종목에 돈을 더 거는 일입니다.",
   "start": 155.85,
   "end": 159.82
  },
  {
   "n": 30,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "두 번째는 떨어진 가격이 곧 싼 가격은 아니라는 것입니다.",
   "start": 160.27,
   "end": 164.21
  },
  {
   "n": 31,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "주가가 떨어지는 데에는 이유가 있을 수 있습니다.",
   "start": 164.66,
   "end": 167.68
  },
  {
   "n": 32,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "유나이티드헬스는 4월 17일 실적 전망을 낮추면서 하루 만에 22% 떨어졌습니다.",
   "start": 168.13,
   "end": 174.51
  },
  {
   "n": 33,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "5월 13일에는 전망 철회와 CEO 사임이 겹치며 또 18% 가까이 폭락했습니다.",
   "start": 174.96,
   "end": 180.52
  },
  {
   "n": 34,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "이틀 뒤에는 11% 가까이 더 빠졌죠.",
   "start": 180.97,
   "end": 184.06
  },
  {
   "n": 35,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "미국 법무부가 이 회사를 수사 중이라는 보도 때문이었습니다.",
   "start": 184.51,
   "end": 188.01
  },
  {
   "n": 36,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "미국 정부의 노인 의료보험인 메디케어와 관련된 사기 혐의였죠.",
   "start": 188.46,
   "end": 192.74
  },
  {
   "n": 37,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그렇게 585달러이던 주가는 한 달 만에 274달러, 절반 아래로 떨어졌습니다.",
   "start": 193.19,
   "end": 199.07
  },
  {
   "n": 38,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "1년 반이 지난 2026년 10월에도 주가는 376달러 정도입니다.",
   "start": 199.52,
   "end": 205.13
  },
  {
   "n": 39,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사연자의 평단 415달러보다 여전히 아래죠.",
   "start": 205.58,
   "end": 209.3
  },
  {
   "n": 40,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "세 번째는 사람이 원래 손실 난 종목을 너무 오래 붙잡는다는 것입니다.",
   "start": 209.75,
   "end": 213.66
  },
  {
   "n": 41,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "자본시장연구원이 2020년 개인 투자자 약 20만 명의 거래를 분석했습니다.",
   "start": 214.11,
   "end": 219.49
  },
  {
   "n": 42,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "산 다음 날 수익이 난 종목은 41%를 팔았습니다.",
   "start": 219.94,
   "end": 224.0
  },
  {
   "n": 43,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그런데 손실 난 종목은 22%만 팔고, 78%는 그대로 들고 있었죠.",
   "start": 224.45,
   "end": 230.03
  },
  {
   "n": 44,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "이 습관이 가장 강한 투자자들은 들고 있던 종목이 평균 9.8% 손실이었습니다.",
   "start": 230.48,
   "end": 235.98
  },
  {
   "n": 45,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "반대로 손실 종목부터 정리한 투자자들은 평균 4.9% 수익이었죠.",
   "start": 236.43,
   "end": 241.87
  },
  {
   "n": 46,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "본전을 기다리는 마음이 오히려 수익을 깎아 먹은 겁니다.",
   "start": 242.32,
   "end": 246.13
  },
  {
   "n": 47,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "물타기는 이렇게 붙잡고 있는 종목에 돈까지 더 얹는 일입니다.",
   "start": 246.58,
   "end": 250.71
  },
  {
   "n": 48,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "네 번째는 손실을 만회하려는 물타기는 갈수록 멈추기 어렵다는 것입니다.",
   "start": 251.16,
   "end": 256.09
  },
  {
   "n": 49,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2021년 6월, 카카오 주가는 16만 9,500원까지 올랐습니다.",
   "start": 256.54,
   "end": 261.63
  },
  {
   "n": 50,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그해 9월 금융당국의 빅테크 규제 소식에 일주일 만에 17% 가까이 빠졌죠.",
   "start": 262.08,
   "end": 267.2
  },
  {
   "n": 51,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그런데 그 한 주 동안 개인 투자자는 1조 원 넘게 사들였습니다.",
   "start": 267.65,
   "end": 271.33
  },
  {
   "n": 52,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "주가가 반 토막 난 2022년에도 2조 원 넘게 더 샀죠.",
   "start": 271.78,
   "end": 275.7
  },
  {
   "n": 53,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그해 소액주주는 오히려 15만 명 가까이 늘어 206만 명이 됐습니다.",
   "start": 276.15,
   "end": 280.59
  },
  {
   "n": 54,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "하지만 2026년 10월 주가는 3만 2천 원대, 고점의 5분의 1도 안 됩니다.",
   "start": 281.04,
   "end": 287.03
  },
  {
   "n": 55,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "떨어질수록 더 사들인 돈만큼 손실도 함께 커진 겁니다.",
   "start": 287.48,
   "end": 291.49
  },
  {
   "n": 56,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "물론 물타기가 통한 경우도 있습니다.",
   "start": 291.94,
   "end": 294.34
  },
  {
   "n": 57,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "하지만 결과를 미리 알고 물타기를 할 수는 없습니다.",
   "start": 294.79,
   "end": 298.32
  },
  {
   "n": 58,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그렇다면 물타기와 손절은 어떤 기준으로 해야 할까요?",
   "start": 298.77,
   "end": 302.27
  },
  {
   "n": 59,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "첫째, 사기 전에 이 종목을 사는 이유를 한 줄로 적어 두는 것입니다.",
   "start": 303.27,
   "end": 307.93
  },
  {
   "n": 60,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "사연자의 이유는 큰 회사라 망하지 않는다는 것이었습니다.",
   "start": 308.38,
   "end": 312.12
  },
  {
   "n": 61,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "이 이유로는 지금 가격이 싼지, 언제 다시 오를지 판단할 수 없습니다.",
