 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "식당에서 밥을 다 먹고 나면, 빈 그릇을 한쪽에 모아 두는 사람이 있습니다.",
   "start": 0.3,
   "end": 4.74
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "수저는 가지런히 모으고, 흘린 반찬은 휴지로 닦아 둡니다.",
   "start": 5.12,
   "end": 8.96
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "직원이 치워 주는 식당인데도 말입니다.",
   "start": 9.34,
   "end": 11.396
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "그런데 왜 그렇게 할까요?",
   "start": 11.776,
   "end": 13.142
  },
  {
   "n": 5,
   "role": "host",
   "part": "도입",
   "text": "혹시 여러분도 자리에서 일어나기 전에 그릇부터 모으고 계신가요?",
   "start": 13.522,
   "end": 17.458
  },
  {
   "n": 6,
   "role": "host",
   "part": "도입",
   "text": "결론부터 말씀드리겠습니다.",
   "start": 17.838,
   "end": 19.368
  },
  {
   "n": 7,
   "role": "host",
   "part": "도입",
   "text": "이런 분들에게서 볼 수 있는 특징은 세 가지입니다.",
   "start": 19.748,
   "end": 22.353
  },
  {
   "n": 8,
   "role": "host",
   "part": "도입",
   "text": "첫째, 하던 일을 끝까지 마무리하려는 성향입니다.",
   "start": 22.733,
   "end": 25.852
  },
  {
   "n": 9,
   "role": "host",
   "part": "도입",
   "text": "둘째, 그릇을 치울 사람의 수고를 먼저 떠올리는 마음입니다.",
   "start": 26.232,
   "end": 29.952
  },
  {
   "n": 10,
   "role": "host",
   "part": "도입",
   "text": "셋째, 착해서만이 아니라, 어질러진 채로 일어나면 마음이 불편한 것입니다.",
   "start": 30.332,
   "end": 35.332
  },
  {
   "n": 11,
   "role": "host",
   "part": "도입",
   "text": "흔히 '배려심이 깊다'로 설명하는데, 연구와 댓글로 보면 어디까지 맞을까요?",
   "start": 35.712,
   "end": 40.712
  },
  {
   "n": 12,
   "role": "host",
   "part": "도입",
   "text": "오늘은 닮은 행동을 다룬 연구와, 비슷한 영상에 달린 실제 댓글로 짚어 보겠습니다.",
   "start": 41.092,
   "end": 46.529
  },
  {
   "n": 13,
   "role": "host",
   "part": "도입",
   "text": "물론 예절로 배웠거나 식당 일을 해 봐서 그런 분도 많고, 하나만 맞는 분도 있습니다.",
   "start": 46.909,
   "end": 52.329
  },
  {
   "n": 14,
   "role": "host",
   "part": "도입",
   "text": "지나칠 때 알아 둘 점과, 집에서 습관이 다를 때 할 일도 끝에 말씀드리겠습니다.",
   "start": 52.709,
   "end": 57.469
  },
  {
   "n": 15,
   "role": "host",
   "part": "도입",
   "text": "먼저 첫 번째부터 보겠습니다.",
   "start": 57.849,
   "end": 59.608
  },
  {
   "n": 16,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "첫 번째는, 하던 일을 끝까지 마무리하려는 성향입니다.",
   "start": 60.608,
   "end": 63.859
  },
  {
   "n": 17,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "심리학 연구에서 가장 널리 쓰는 성격 이론은 성격을 다섯 가지 성향으로 봅니다.",
   "start": 64.239,
   "end": 68.926
  },
  {
   "n": 18,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "그중 하나가 성실성입니다.",
   "start": 69.306,
   "end": 71.046
  },
  {
   "n": 19,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "성실성은 계획을 세우고, 정리하고, 일을 끝까지 마무리하는 성향을 말합니다.",
   "start": 71.426,
   "end": 76.598
  },
  {
   "n": 20,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "성실성이 높은 분에게는 밥을 먹는 것도 하나의 일일 수 있습니다.",
   "start": 76.978,
   "end": 80.918
  },
  {
   "n": 21,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "수저를 내려놓는 순간이 아니라, 그릇을 정리한 순간이 그 일이 끝나는 순간입니다.",
   "start": 81.298,
   "end": 86.221
  },
  {
   "n": 22,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "그래서 그릇을 모으는 것까지가 식사의 마지막 순서가 될 수 있습니다.",
   "start": 86.601,
   "end": 90.498
  },
  {
   "n": 23,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "다만 식당에서는 모으는데 집은 어수선한 분도 있습니다.",
   "start": 90.878,
   "end": 94.16
  },
  {
   "n": 24,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "그럴 땐 남이 치우는 곳이라 더 신경 쓰이거나, 남의 눈이 쓰여서일 수도 있습니다.",
   "start": 94.54,
   "end": 99.0
  },
  {
   "n": 25,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "여행지 숙소를 나올 때 이불을 개어 두는 분도 이쪽에 가깝습니다.",
   "start": 99.38,
   "end": 103.19
  },
  {
   "n": 26,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "회의가 끝나면 다 쓴 컵을 챙기고, 의자를 넣고 나오는 분도 있습니다.",
   "start": 103.57,
   "end": 107.96
  },
  {
   "n": 27,
   "role": "host",
   "part": "첫 번째, 끝까지 마무리하려는 성향",
   "text": "한마디로, 그릇을 모으는 손에는 끝까지 마무리하려는 성향이 묻어 있을 수 있습니다.",
   "start": 108.34,
   "end": 113.55
  },
  {
   "n": 28,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "두 번째는, 그릇을 치울 사람의 수고를 먼저 떠올리는 마음입니다.",
   "start": 114.55,
   "end": 118.584
  },
  {
   "n": 29,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "식당 직원은 하루에도 많은 테이블을 치웁니다.",
   "start": 118.964,
   "end": 121.712
  },
  {
   "n": 30,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "그릇이 테이블 여기저기 흩어져 있으면, 그만큼 손이 여러 번 더 갑니다.",
   "start": 122.092,
   "end": 126.612
  },
  {
   "n": 31,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "그래서 일어나기 전에 '치우는 사람이 덜 힘들었으면' 하는 생각이 들 수 있습니다.",
   "start": 126.992,
   "end": 131.312
  },
  {
   "n": 32,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "모임에서 빈 컵을 먼저 모으는 분도 이쪽에 가깝습니다.",
   "start": 131.692,
   "end": 135.333
  },
  {
   "n": 33,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "심리학에서는 남의 입장에 서서 그 사람의 마음을 느껴 보는 힘을 공감이라고 부릅니다.",
   "start": 135.713,
   "end": 140.783
  },
  {
   "n": 34,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "의자를 다시 넣는 사람을 다룬 한 영상에도, '치울 때 편하시라고'라는 댓글이 있었습니다.",
   "start": 141.163,
   "end": 146.292
  },
  {
   "n": 35,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "'일하시는 분들이 조금이라도 덜 힘들었으면 해서'라는 댓글도 있었습니다.",
   "start": 146.672,
   "end": 150.739
  },
  {
   "n": 36,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "그런데 식당에서는 알아 둘 것이 하나 있습니다.",
   "start": 151.119,
   "end": 153.599
  },
  {
   "n": 37,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "식당에 따라서는 직원이 정해진 순서대로 치웁니다.",
   "start": 153.979,
   "end": 157.144
  },
  {
   "n": 38,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "음식이 남은 그릇을 겹치면 바닥까지 묻어 오히려 일이 늘 수 있습니다.",
   "start": 157.524,
   "end": 161.734
  },
  {
   "n": 39,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "그럴 땐 겹치지 말고 한쪽에 모아만 두면 됩니다.",
   "start": 162.114,
   "end": 164.723
  },
  {
   "n": 40,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "그래서 직원이 \"그대로 두셔도 됩니다\"라고 하면, 그 말을 따르는 것이 배려입니다.",
   "start": 165.103,
   "end": 169.879
  },
  {
   "n": 41,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "그릇을 모으지 않는 사람이 나쁜 사람이라는 뜻도 아닙니다.",
   "start": 170.259,
   "end": 173.458
  },
  {
   "n": 42,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "사람마다 남을 생각하는 방식이 다를 뿐입니다.",
   "start": 173.838,
   "end": 176.537
  },
  {
   "n": 43,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "한마디로, 그릇을 모으는 손에는 다음 사람을 생각하는 마음이 들어 있을 수 있습니다.",
   "start": 176.917,
   "end": 181.857
  },
  {
   "n": 44,
   "role": "host",
   "part": "두 번째, 치울 사람을 먼저 떠올림",
   "text": "첫째가 끝내려는 성향, 둘째가 남을 향한 마음이라면, 셋째는 안 할 때의 불편함입니다.",
   "start": 182.237,
   "end": 187.527
  },
  {
   "n": 45,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "세 번째는, 어질러진 채로 일어나면 마음이 불편하다는 것입니다.",
   "start": 188.527,
   "end": 192.647
  },
  {
   "n": 46,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "앞에서 본 의자 영상의 댓글을 다시 보겠습니다.",
   "start": 193.027,
   "end": 195.727
  },
  {
   "n": 47,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "좋아요를 가장 많이 받은 댓글은 '의자 넣는 건 기본 아닌가'였습니다.",
   "start": 196.107,
   "end": 200.147
  },
  {
   "n": 48,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "가장 많은 분이 그냥 배운 예절로 본 것입니다.",
   "start": 200.527,
   "end": 203.157
  },
  {
   "n": 49,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "그다음으로 좋아요를 많이 받은 댓글은 뜻이 조금 달랐습니다.",
   "start": 203.537,
   "end": 207.293
  },
  {
   "n": 50,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "'착해서가 아니라, 안 넣고 가면 거슬려서 그냥 못 지나친다'는 말이었습니다.",
   "start": 207.673,
   "end": 212.231
  },
  {
   "n": 51,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "좋아요 다섯째 댓글도 '머문 자리를 지저분하게 두고 나오면 불편하다'였습니다.",
   "start": 212.611,
   "end": 217.441
  },
  {
   "n": 52,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "심리학에는 '딱 맞지 않는 느낌'이라는 말이 있습니다.",
   "start": 217.821,
   "end": 220.798
  },
  {
   "n": 53,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "물건이 제자리에 있지 않거나, 뭔가 어긋나 보일 때 드는 찜찜한 느낌입니다.",
   "start": 221.178,
   "end": 226.058
  },
  {
   "n": 54,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "2022년에 여러 연구를 모아 결과를 다시 계산한 분석이 있습니다.",
   "start": 226.438,
   "end": 230.435
  },
  {
   "n": 55,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "이 느낌이 강할수록 강박 증상 점수도 높았습니다.",
   "start": 230.815,
   "end": 233.772
  },
  {
   "n": 56,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "강박증이 없는 일반인에게서도 마찬가지였습니다.",
   "start": 234.152,
   "end": 236.812
  },
  {
   "n": 57,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "그렇다고 그릇을 모으는 사람이 강박증이라는 뜻은 아닙니다.",
   "start": 237.192,
   "end": 240.729
  },
  {
   "n": 58,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "강박증은 원치 않는 생각이나 찜찜함 때문에 행동을 못 멈춰, 생활이 힘든 상태입니다.",
   "start": 241.109,
   "end": 246.689
  },
  {
   "n": 59,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "그 진단은 전문가가 합니다.",
   "start": 247.069,
   "end": 248.492
  },
  {
   "n": 60,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "식당에서 그릇을 잠깐 모으고 일어나는 행동은 이와 다릅니다.",
   "start": 248.872,
   "end": 252.517
  },
  {
   "n": 61,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "앞의 댓글처럼, 그릇을 모으는 분 중에는 이 찜찜함을 더 느끼는 분이 있을 수 있습니다.",
   "start": 252.897,
   "end": 258.482
  },
  {
   "n": 62,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "그런 분이라면 그릇을 모으고 나서 마음이 풀린다고 느낄 수 있습니다.",
   "start": 258.862,
   "end": 263.053
  },
  {
   "n": 63,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "신발 끈이 한쪽만 풀려 있으면, 걷는 내내 그쪽이 신경 쓰이는 것과 비슷합니다.",
   "start": 263.433,
   "end": 268.613
  },
  {
   "n": 64,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "끈을 묶고 나서야 비로소 걸음에 집중할 수 있습니다.",
   "start": 268.993,
   "end": 271.996
  },
  {
   "n": 65,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "한마디로, 그릇을 모으는 일은 남을 위하면서 내 마음도 편하게 하는 일일 수 있습니다.",
   "start": 272.376,
   "end": 277.596
  },
  {
   "n": 66,
   "role": "host",
   "part": "세 번째, 착해서만이 아니라 불편해서",
   "text": "그렇다면 이 습관이 지나치면 어떤 일이 생길까요?",
   "start": 277.976,
   "end": 281.022
  },
  {
   "n": 67,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "그릇을 모아 두는 것 자체는 나쁜 습관이 아닙니다.",
   "start": 282.022,
   "end": 284.913
  },
  {
   "n": 68,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "하지만 정리를 하지 않으면 자리에서 일어나지 못할 정도라면 이야기가 다릅니다.",
   "start": 285.293,
   "end": 289.553
  },
  {
   "n": 69,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "예를 들어 같이 간 사람이 그릇을 흩어 놓았을 때 화가 날 정도라면 한번 살펴볼 만합니다.",
   "start": 289.933,
   "end": 294.946
  },
  {
   "n": 70,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "집에서도 가족이 어쩌다 컵 하나 안 치운 일로 하루 종일 기분이 상한다면 마찬가지입니다.",
   "start": 295.326,
   "end": 300.253
  },
  {
   "n": 71,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "이럴 때는 정리를 '반드시 해야 하는 일'이 아니라 '하면 좋은 일'로 바꿔 보세요.",
   "start": 300.633,
   "end": 304.993
  },
  {
   "n": 72,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "방법은 이렇습니다.",
   "start": 305.373,
   "end": 306.437
  },
  {
   "n": 73,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "이것은 치료가 아니라, 내 마음을 살펴보는 작은 연습입니다.",
   "start": 306.817,
   "end": 310.714
  },
  {
   "n": 74,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "집에서 다 마신 컵 하나를 바로 씻지 말고, 30분 뒤에 씻어 보세요.",
   "start": 311.094,
   "end": 315.434
  },
  {
   "n": 75,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "그리고 그동안 찜찜함이 어떻게 달라지는지 지켜봅니다.",
   "start": 315.814,
   "end": 318.915
  },
  {
   "n": 76,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "찜찜함이 줄어든다면, 정리는 꼭 해야 하는 일이 아니라 내가 고르는 일입니다.",
   "start": 319.295,
   "end": 324.031
  },
  {
   "n": 77,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "그대로라면 일주일쯤 더 해 보셔도 됩니다.",
   "start": 324.411,
   "end": 326.681
  },
  {
   "n": 78,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "다만 일주일쯤 해도 줄지 않고 정리를 멈추지 못해 힘들다면, 전문가와 이야기해 보세요.",
   "start": 327.061,
   "end": 332.402
  },
  {
   "n": 79,
   "role": "host",
   "part": "지나칠 때 알아 둘 점",
   "text": "그런데 이 차이가 더 자주 부딪치는 곳은 식당보다 집입니다.",
   "start": 332.782,
   "end": 336.292
  },
  {
   "n": 80,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "부부나 가족 사이에 정리 습관이 다르면, 작은 일로 다투기도 합니다.",
   "start": 337.292,
   "end": 341.27
  },
  {
   "n": 81,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "한 사람은 컵을 바로 씻고, 다른 사람은 모아 두었다가 한 번에 씻습니다.",
   "start": 341.65,
   "end": 346.076
  },
  {
   "n": 82,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "명절에 설거지를 누가 먼저 시작하느냐로 서운해지는 집도 있습니다.",
   "start": 346.456,
   "end": 350.245
  },
  {
   "n": 83,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "먼저 정리하는 쪽은 '왜 나만 치우지' 하고 서운해지기 쉽습니다.",
   "start": 350.625,
   "end": 354.583
  },
  {
   "n": 84,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "나중에 정리하는 쪽은 '왜 나를 게으른 사람으로 보지' 하고 억울해지기 쉽습니다.",
   "start": 354.963,
   "end": 359.46
  },
  {
   "n": 85,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "여기서 먼저 나눠 볼 것이 있습니다.",
   "start": 359.84,
   "end": 361.84
  },
  {
   "n": 86,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "나중에라도 치운다면, 둘 다 정리를 안 하는 것이 아니라 때가 다를 뿐입니다.",
   "start": 362.22,
   "end": 367.003
  },
  {
   "n": 87,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "그때는 '왜 안 치워'라고 말하기보다, 언제까지 치울지를 같이 정하는 것이 좋습니다.",
   "start": 367.383,
   "end": 372.523
  },
  {
   "n": 88,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "예를 들어 '설거지는 자기 전에 끝내자'처럼 끝나는 시각을 정하는 겁니다.",
   "start": 372.903,
   "end": 376.943
  },
  {
   "n": 89,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "이렇게 하면 먼저 치우는 사람은 기다리기 쉽고, 나중에 치우는 사람은 덜 쫓깁니다.",
   "start": 377.323,
   "end": 382.173
  },
  {
   "n": 90,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "하지만 늘 한 사람만 치운다면, 그것은 때의 차이가 아니라 일을 나누는 문제입니다.",
   "start": 382.553,
   "end": 387.643
  },
  {
   "n": 91,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "그때는 끝나는 시각과 함께, 누가 무엇을 맡을지도 정하세요.",
   "start": 388.023,
   "end": 392.018
  },
  {
   "n": 92,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "예를 들어 '저녁 설거지는 당신, 아침은 나'처럼 나누는 겁니다.",
   "start": 392.398,
   "end": 396.405
  },
  {
   "n": 93,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "정한 몫은 각자 지키고, 상대 몫을 대신 하지 않으면 됩니다.",
   "start": 396.785,
   "end": 400.399
  },
  {
   "n": 94,
   "role": "host",
   "part": "집에서 습관이 다를 때",
   "text": "정한 몫이 자꾸 어긋나면, 대신 치우기 전에 한 번 말하고 나누는 방법을 다시 정하세요.",
   "start": 400.779,
   "end": 406.399
  },
  {
   "n": 95,
   "role": "host",
   "part": "정리",
   "text": "자, 마지막으로 오늘 내용을 정리하겠습니다.",
   "start": 407.399,
   "end": 410.285
  },
  {
   "n": 96,
   "role": "host",
   "part": "정리",
   "text": "식당에서 그릇을 모아 두는 분들에게서 볼 수 있는 특징은 세 가지였습니다.",
   "start": 410.665,
   "end": 414.574
  },
  {
   "n": 97,
   "role": "host",
   "part": "정리",
   "text": "첫째, 하던 일을 끝까지 마무리하려는 성향입니다.",
   "start": 414.954,
   "end": 418.073
  },
  {
   "n": 98,
   "role": "host",
   "part": "정리",
   "text": "둘째, 그릇을 치울 사람의 수고를 먼저 떠올리는 마음입니다.",
   "start": 418.453,
   "end": 422.173
  },
  {
   "n": 99,
   "role": "host",
   "part": "정리",
   "text": "셋째, 착해서만이 아니라, 어질러진 채로 일어나면 마음이 불편한 것입니다.",
   "start": 422.553,
   "end": 427.553
  },
  {
   "n": 100,
   "role": "host",
   "part": "정리",
   "text": "첫째는 성격 이론, 둘째는 댓글, 셋째는 닮은 연구와 댓글로 짚어 본 것입니다.",
   "start": 427.933,
   "end": 432.937
  },
  {
   "n": 101,
   "role": "host",
   "part": "정리",
   "text": "이 습관 때문에 불안해진다면, 조금 느슨해져도 괜찮습니다.",
   "start": 433.317,
   "end": 437.227
  },
  {
   "n": 102,
   "role": "host",
   "part": "정리",
   "text": "다음에 그릇을 모을 때, 세 가지 중 어느 마음인지, 그냥 배운 습관인지 골라 보세요.",
   "start": 437.607,
   "end": 442.947
  },
  {
   "n": 103,
   "role": "host",
   "part": "정리",
   "text": "시청해주셔서 감사합니다.",
   "start": 443.327,
   "end": 444.857
  }
 ],
 "voice_sha1": "67155a53ae90a91a"
}