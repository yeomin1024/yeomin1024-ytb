 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "나스닥100을 2배, 3배로 따라가는 QLD와 TQQQ.",
   "start": 0.3,
   "end": 4.48
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "오래 모으면 훨씬 많이 남을 것 같지만, 폭락이 오면 얼마나 버틸까요?",
   "start": 4.93,
   "end": 9.01
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "1999년부터, 1배·2배·3배를 백테스트로 비교해 보겠습니다.",
   "start": 9.46,
   "end": 13.69
  },
  {
   "n": 4,
   "role": "host",
   "part": "규칙",
   "text": "2배와 3배는 QLD·TQQQ처럼, 매일 지수의 2배·3배에서 비용을 뺀 계산값이에요.",
   "start": 14.69,
   "end": 21.03
  },
  {
   "n": 5,
   "role": "host",
   "part": "규칙",
   "text": "매달 첫 거래일에 500달러씩 매수하고, 수수료는 0.25%입니다.",
   "start": 21.48,
   "end": 26.35
  },
  {
   "n": 6,
   "role": "host",
   "part": "경주",
   "text": "이제 날짜를 흘려 보겠습니다.",
   "start": 27.35,
   "end": 28.94
  },
  {
   "n": 7,
   "role": "host",
   "part": "경주",
   "text": "파란 선이 나스닥100을 1배로 따라가는 QQQ, 보라 선이 2배, 주황 선이 3배예요.",
   "start": 29.39,
   "end": 35.56
  },
  {
   "n": 8,
   "role": "host",
   "part": "경주",
   "text": "노란 점선은 지금까지 넣은 돈입니다.",
   "start": 36.01,
   "end": 38.0
  },
  {
   "n": 9,
   "role": "host",
   "part": "경주",
   "text": "세로 눈금은 한 칸 오를 때마다 10배입니다.",
   "start": 38.45,
   "end": 40.85
  },
  {
   "n": 10,
   "role": "host",
   "part": "경주",
   "text": "세 계좌 모두 나스닥100의 배당을 다시 넣은 값이에요.",
   "start": 41.3,
   "end": 44.41
  },
  {
   "n": 11,
   "role": "host",
   "part": "경주",
   "text": "1999년 말, 3배 계좌는 넣은 돈 4,500달러의 3.28배였어요.",
   "start": 44.86,
   "end": 50.03
  },
  {
   "n": 12,
   "role": "host",
   "part": "경주",
   "text": "2000년 3월부터 닷컴 거품이 꺼지기 시작합니다.",
   "start": 50.48,
   "end": 53.42
  },
  {
   "n": 13,
   "role": "host",
   "part": "경주",
   "text": "2001년 3월 29일, 3배 계좌는 넣은 돈 1만 2천 달러의 92.3%를 잃었어요.",
   "start": 53.87,
   "end": 60.68
  },
  {
   "n": 14,
   "role": "host",
   "part": "경주",
   "text": "4월 4일에는 2배가 80.7%, 1배가 49.9% 줄어, 셋 다 넣은 돈보다 적었어요.",
   "start": 61.13,
   "end": 67.53
  },
  {
   "n": 15,
   "role": "host",
   "part": "경주",
   "text": "그래도 세 계좌 모두 매달 500달러씩 계속 매수했어요.",
   "start": 67.98,
   "end": 71.19
  },
  {
   "n": 16,
   "role": "host",
   "part": "경주",
   "text": "2003년, 3배는 167.4% 올랐습니다.",
   "start": 71.64,
   "end": 75.48
  },
  {
   "n": 17,
   "role": "host",
   "part": "경주",
   "text": "2007년 말에는 세 계좌가 거의 같아졌어요.",
   "start": 75.93,
   "end": 78.48
  },
  {
   "n": 18,
   "role": "host",
   "part": "금융위기",
   "text": "그리고 2008년 금융위기가 왔어요.",
   "start": 79.48,
   "end": 81.4
  },
  {
   "n": 19,
   "role": "host",
   "part": "금융위기",
   "text": "11월 20일, 3배 계좌는 넣은 돈 5만 8천 달러의 89.5%를 잃었어요.",
   "start": 81.85,
   "end": 87.61
  },
  {
   "n": 20,
   "role": "host",
   "part": "금융위기",
   "text": "같은 날 2배는 72.8%, 1배는 36.4%를 잃은 상태였고요.",
   "start": 88.06,
   "end": 93.89
  },
  {
   "n": 21,
   "role": "host",
   "part": "금융위기",
   "text": "2009년, 3배는 196.4% 올랐습니다.",
   "start": 94.34,
   "end": 97.87
  },
  {
   "n": 22,
   "role": "host",
   "part": "금융위기",
   "text": "2012년 말까지도 1배가 가장 많았지만, 2013년 7월 3일 3배가 1배를 앞섰습니다.",
   "start": 98.32,
   "end": 104.06
  },
  {
   "n": 23,
   "role": "host",
   "part": "금융위기",
   "text": "2017년 6월, 3배 계좌가 100만 달러를 넘었습니다.",
   "start": 104.51,
   "end": 107.98
  },
  {
   "n": 24,
   "role": "host",
   "part": "금융위기",
   "text": "코로나 폭락 때는 3배 69.7%, 2배 51.9%, 1배 28.5%가 줄었어요.",
   "start": 108.43,
   "end": 116.19
  },
  {
   "n": 25,
   "role": "host",
   "part": "금융위기",
   "text": "그래도 3배 계좌는 약 97만 달러로, 넣은 돈 12만 6천 달러보다 많았어요.",
   "start": 116.64,
   "end": 121.83
  },
  {
   "n": 26,
   "role": "host",
   "part": "금융위기",
   "text": "2021년 말 3배 계좌는 약 910만 달러로, 1배의 8.66배까지 벌어졌어요.",
   "start": 122.28,
   "end": 128.36
  },
  {
   "n": 27,
   "role": "host",
   "part": "긴 하락",
   "text": "2022년, 긴 하락이 왔습니다.",
   "start": 129.36,
   "end": 131.54
  },
  {
   "n": 28,
   "role": "host",
   "part": "긴 하락",
   "text": "3배 계좌는 1월 3일 약 930만 달러에서, 12월 28일 약 180만 달러로 줄었어요.",
   "start": 131.99,
   "end": 138.4
  },
  {
   "n": 29,
   "role": "host",
   "part": "긴 하락",
   "text": "80.9%를 잃은 거예요.",
   "start": 138.85,
   "end": 140.53
  },
  {
   "n": 30,
   "role": "host",
   "part": "긴 하락",
   "text": "2배는 62.8%, 1배는 34.4% 줄었어요.",
   "start": 140.98,
   "end": 145.46
  },
  {
   "n": 31,
   "role": "host",
   "part": "긴 하락",
   "text": "2023년, 3배는 198.2% 올랐습니다.",
   "start": 145.91,
   "end": 149.83
  },
  {
   "n": 32,
   "role": "host",
   "part": "긴 하락",
   "text": "2024년 12월, 3배 계좌가 1,000만 달러를 넘었어요.",
   "start": 150.28,
   "end": 154.12
  },
  {
   "n": 33,
   "role": "host",
   "part": "긴 하락",
   "text": "2025년 4월 급락 때는 3배 56.8%, 2배 41.8%, 1배 22.7%가 줄었어요.",
   "start": 154.57,
   "end": 162.5
  },
  {
   "n": 34,
   "role": "host",
   "part": "결과",
   "text": "2026년 10월 15일, 결과입니다.",
   "start": 163.5,
   "end": 166.22
  },
  {
   "n": 35,
   "role": "host",
   "part": "결과",
   "text": "세 계좌 모두 331번, 약 17만 달러를 넣었어요.",
   "start": 166.67,
   "end": 170.81
  },
  {
   "n": 36,
   "role": "host",
   "part": "결과",
   "text": "1배 계좌는 약 200만 달러, 2배는 약 790만 달러예요.",
   "start": 171.26,
   "end": 175.49
  },
  {
   "n": 37,
   "role": "host",
   "part": "결과",
   "text": "3배 계좌는 약 1,700만 달러였습니다.",
   "start": 175.94,
   "end": 178.82
  },
  {
   "n": 38,
   "role": "host",
   "part": "결과",
   "text": "3배 계좌가 가장 많았던 날은 2026년 6월 2일, 약 2,000만 달러였어요.",
   "start": 179.27,
   "end": 185.19
  },
  {
   "n": 39,
   "role": "host",
   "part": "결과",
   "text": "3배가 1배의 8.55배, 2배는 3.91배였어요.",
   "start": 185.64,
   "end": 189.42
  },
  {
   "n": 40,
   "role": "host",
   "part": "결과",
   "text": "2013년 7월 3일 뒤로, 3배는 계속 1배보다 많았습니다.",
   "start": 189.87,
   "end": 193.62
  },
  {
   "n": 41,
   "role": "host",
   "part": "결과",
   "text": "그 전 14.3년 동안은, 3배가 1배보다 많았던 날이 10.8%뿐이었어요.",
   "start": 194.07,
   "end": 199.66
  },
  {
   "n": 42,
   "role": "host",
   "part": "결과",
   "text": "넣은 돈보다 많았던 날도 1배 78.1%, 3배 64.7%로, 3배가 적었어요.",
   "start": 200.11,
   "end": 207.46
  },
  {
   "n": 43,
   "role": "host",
   "part": "매일 맞추기",
   "text": "3배는 왜 폭락 때 그렇게 많이 줄었을까요?",
   "start": 208.46,
   "end": 211.02
  },
  {
   "n": 44,
   "role": "host",
   "part": "매일 맞추기",
   "text": "레버리지 ETF가 매일 배수를 맞춘다는 게 무슨 뜻인지 보겠습니다.",
   "start": 211.47,
   "end": 215.15
  },
  {
   "n": 45,
   "role": "host",
   "part": "매일 맞추기",
   "text": "지수가 하루에 10% 오르고, 다음 날 10% 떨어졌다고 해 볼게요.",
   "start": 215.6,
   "end": 220.01
  },
  {
   "n": 46,
   "role": "host",
   "part": "매일 맞추기",
   "text": "1배는 1% 손해입니다.",
   "start": 220.46,
   "end": 222.73
  },
  {
   "n": 47,
   "role": "host",
   "part": "매일 맞추기",
   "text": "2배는 20% 올랐다가 20% 떨어져서, 4% 손해예요.",
   "start": 223.18,
   "end": 227.36
  },
  {
   "n": 48,
   "role": "host",
   "part": "매일 맞추기",
   "text": "3배는 30% 올랐다가 30% 떨어져서, 9% 손해고요.",
   "start": 227.81,
   "end": 232.31
  },
  {
   "n": 49,
   "role": "host",
   "part": "매일 맞추기",
   "text": "오르내림이 반복될수록, 배수가 클수록 더 깎입니다.",
   "start": 232.76,
   "end": 236.2
  },
  {
   "n": 50,
   "role": "host",
   "part": "매일 맞추기",
   "text": "지수가 제자리로 돌아와도, 배수 계좌는 처음보다 적어지는 거죠.",
   "start": 236.65,
   "end": 240.41
  },
  {
   "n": 51,
   "role": "host",
   "part": "매일 맞추기",
   "text": "실제로 2018년, 1배는 0.1% 떨어져 거의 제자리였어요.",
   "start": 240.86,
   "end": 245.55
  },
  {
   "n": 52,
   "role": "host",
   "part": "매일 맞추기",
   "text": "그해 2배는 8.6%, 3배는 20.1% 떨어졌습니다.",
   "start": 246.0,
   "end": 250.42
  },
  {
   "n": 53,
   "role": "host",
   "part": "한 번에",
   "text": "그런데 매달 나눠 넣지 않고, 처음에 한 번만 넣었다면요?",
   "start": 251.42,
   "end": 254.78
  },
  {
   "n": 54,
   "role": "host",
   "part": "한 번에",
   "text": "1999년 4월 1일, 세 계좌에 1만 달러씩 넣었습니다.",
   "start": 255.23,
   "end": 259.47
  },
  {
   "n": 55,
   "role": "host",
   "part": "한 번에",
   "text": "2009년 3월 9일, 3배 계좌에는 13달러만 남아, 99.87%가 사라졌어요.",
   "start": 259.92,
   "end": 266.65
  },
  {
   "n": 56,
   "role": "host",
   "part": "한 번에",
   "text": "2배는 450달러였고요.",
   "start": 267.1,
   "end": 268.86
  },
  {
   "n": 57,
   "role": "host",
   "part": "한 번에",
   "text": "1배는 2002년 10월 9일, 3,736달러가 가장 적었습니다.",
   "start": 269.31,
   "end": 273.79
  },
  {
   "n": 58,
   "role": "host",
   "part": "한 번에",
   "text": "2026년 10월 15일 값은 이렇습니다.",
   "start": 274.24,
   "end": 277.04
  },
  {
   "n": 59,
   "role": "host",
   "part": "한 번에",
   "text": "1배 약 16만 달러, 2배 약 13만 달러, 3배 약 1만 8천 달러였어요.",
   "start": 277.49,
   "end": 282.99
  },
  {
   "n": 60,
   "role": "host",
   "part": "한 번에",
   "text": "한 번에 넣은 돈은, 3배가 1배의 11.4%만 남았습니다.",
   "start": 283.44,
   "end": 287.42
  },
  {
   "n": 61,
   "role": "host",
   "part": "한 번에",
   "text": "매달 넣은 계좌는, 폭락으로 싸진 값에도 계속 매수했어요.",
   "start": 287.87,
   "end": 291.6
  },
  {
   "n": 62,
   "role": "host",
   "part": "시작 시점",
   "text": "1999년 4월은 닷컴 폭락 바로 앞이라, 시작이 나빴을 수도 있어요.",
   "start": 292.6,
   "end": 297.0
  },
  {
   "n": 63,
   "role": "host",
   "part": "시작 시점",
   "text": "시작한 달이 달랐다면 어땠을까요?",
   "start": 297.45,
   "end": 299.6
  },
  {
   "n": 64,
   "role": "host",
   "part": "시작 시점",
   "text": "1999년 4월부터 2016년 10월까지, 달마다 시작한 10년 적립 계좌를 만들었어요.",
   "start": 300.05,
   "end": 306.36
  },
  {
   "n": 65,
   "role": "host",
   "part": "시작 시점",
   "text": "모두 211개입니다.",
   "start": 306.81,
   "end": 308.46
  },
  {
   "n": 66,
   "role": "host",
   "part": "시작 시점",
   "text": "10년 뒤 3배가 1배보다 많았던 건 211개 중 175개였어요.",
   "start": 308.91,
   "end": 313.59
  },
  {
   "n": 67,
   "role": "host",
   "part": "시작 시점",
   "text": "2배가 1배보다 많았던 건 183개였습니다.",
   "start": 314.04,
   "end": 317.16
  },
  {
   "n": 68,
   "role": "host",
   "part": "시작 시점",
   "text": "넣은 돈보다 적게 남은 계좌는 1배 4개, 2배 16개, 3배 20개였어요.",
   "start": 317.61,
   "end": 322.73
  },
  {
   "n": 69,
   "role": "host",
   "part": "시작 시점",
   "text": "가장 나빴던 건 1999년 4월에 시작한 계좌였습니다.",
   "start": 323.18,
   "end": 326.86
  },
  {
   "n": 70,
   "role": "host",
   "part": "시작 시점",
   "text": "넣은 돈 약 6만 1천 달러가, 3배는 약 1만 2천 달러로 1배의 24.9%였어요.",
   "start": 327.31,
   "end": 333.04
  },
  {
   "n": 71,
   "role": "host",
   "part": "시작 시점",
   "text": "가장 좋았던 건 2008년 9월에 시작한 계좌로, 3배가 1배의 6.49배였습니다.",
   "start": 333.49,
   "end": 338.69
  },
  {
   "n": 72,
   "role": "host",
   "part": "시작 시점",
   "text": "25년 적립 계좌 31개에서는, 모두 3배가 가장 많았어요.",
   "start": 339.14,
   "end": 343.14
  },
  {
   "n": 73,
   "role": "host",
   "part": "실제 ETF",
   "text": "계산한 2배·3배가 실제 ETF와 얼마나 같은지도 봐야겠죠.",
   "start": 344.14,
   "end": 348.0
  },
  {
   "n": 74,
   "role": "host",
   "part": "실제 ETF",
   "text": "2배와 3배 계좌는 이렇게 계산했습니다.",
   "start": 348.45,
   "end": 350.77
  },
  {
   "n": 75,
   "role": "host",
   "part": "실제 ETF",
   "text": "두 ETF는 2006년과 2010년에 생겨서, 1999년부터는 직접 계산해야 해요.",
   "start": 351.22,
   "end": 357.26
  },
  {
   "n": 76,
   "role": "host",
   "part": "실제 ETF",
   "text": "매일 나스닥100 하루 수익률의 2배, 3배를 따라가요.",
   "start": 357.71,
   "end": 361.11
  },
  {
   "n": 77,
   "role": "host",
   "part": "실제 ETF",
   "text": "여기서 보수 0.95%와 빌린 돈의 이자를 뺍니다.",
   "start": 361.56,
   "end": 364.97
  },
  {
   "n": 78,
   "role": "host",
   "part": "실제 ETF",
   "text": "이자는 미국 정부의 석 달짜리 금리에 1.02%를 더했어요.",
   "start": 365.42,
   "end": 369.5
  },
  {
   "n": 79,
   "role": "host",
   "part": "실제 ETF",
   "text": "1.02%는 2006년 6월부터 실제 QLD와 끝 값이 같도록 정한 값입니다.",
   "start": 369.95,
   "end": 375.44
  },
  {
   "n": 80,
   "role": "host",
   "part": "실제 ETF",
   "text": "같은 값으로 TQQQ를 계산하면, 실제보다 1년에 0.57% 적게 나왔어요.",
   "start": 375.89,
   "end": 381.36
  },
  {
   "n": 81,
   "role": "host",
   "part": "실제 ETF",
   "text": "이번엔 실제 ETF로 보겠습니다.",
   "start": 381.81,
   "end": 383.82
  },
  {
   "n": 82,
   "role": "host",
   "part": "실제 ETF",
   "text": "TQQQ가 생긴 다음 달, 2010년 3월부터 매달 500달러씩이에요.",
   "start": 384.27,
   "end": 389.07
  },
  {
   "n": 83,
   "role": "host",
   "part": "실제 ETF",
   "text": "넣은 돈은 10만 달러입니다.",
   "start": 389.52,
   "end": 391.2
  },
  {
   "n": 84,
   "role": "host",
   "part": "실제 ETF",
   "text": "QQQ 약 62만 달러, QLD 약 220만 달러가 됐어요.",
   "start": 391.65,
   "end": 396.21
  },
  {
   "n": 85,
   "role": "host",
   "part": "실제 ETF",
   "text": "TQQQ는 약 530만 달러였습니다.",
   "start": 396.66,
   "end": 399.84
  },
  {
   "n": 86,
   "role": "host",
   "part": "실제 ETF",
   "text": "같은 기간 계산한 3배는 약 510만 달러로, 실제보다 조금 적었습니다.",
   "start": 400.29,
   "end": 405.33
  },
  {
   "n": 87,
   "role": "host",
   "part": "실제 ETF",
   "text": "실제 TQQQ 계좌도 2022년에 81.5%, QLD 계좌는 63.3% 줄었어요.",
   "start": 405.78,
   "end": 413.15
  },
  {
   "n": 88,
   "role": "host",
   "part": "정리",
   "text": "정리하겠습니다.",
   "start": 414.15,
   "end": 415.27
  },
  {
   "n": 89,
   "role": "host",
   "part": "정리",
   "text": "1999년부터 매달 모은 결과, 3배가 1배의 8.55배였어요.",
   "start": 415.72,
   "end": 420.6
  },
  {
   "n": 90,
   "role": "host",
   "part": "정리",
   "text": "하지만 2001년에는 넣은 돈의 92.3%가 줄어든 때가 있었습니다.",
   "start": 421.05,
   "end": 425.43
  },
  {
   "n": 91,
   "role": "host",
   "part": "정리",
   "text": "2008년에도 89.5%가 줄었고요.",
   "start": 425.88,
   "end": 428.59
  },
  {
   "n": 92,
   "role": "host",
   "part": "정리",
   "text": "3배가 1배를 계속 앞서기 시작한 건 14.3년 뒤였어요.",
   "start": 429.04,
   "end": 432.84
  },
  {
   "n": 93,
   "role": "host",
   "part": "정리",
   "text": "처음에 한 번에 넣었다면, 3배는 1배의 11.4%만 남았습니다.",
   "start": 433.29,
   "end": 437.92
  },
  {
   "n": 94,
   "role": "host",
   "part": "정리",
   "text": "시작 달을 바꾼 10년 계좌에서도, 211개 중 20개는 3배가 넣은 돈보다 적었어요.",
   "start": 438.37,
   "end": 443.94
  },
  {
   "n": 95,
   "role": "host",
   "part": "한계",
   "text": "이 기간 나스닥100은 크게 올랐습니다.",
   "start": 444.94,
   "end": 447.09
  },
  {
   "n": 96,
   "role": "host",
   "part": "한계",
   "text": "2배와 3배의 본 실험 값은, 실제 ETF가 아니라 계산한 값이에요.",
   "start": 447.54,
   "end": 452.18
  },
  {
   "n": 97,
   "role": "host",
   "part": "한계",
   "text": "금리와 보수가 바뀌면 결과도 달라집니다.",
   "start": 452.63,
   "end": 454.79
  },
  {
   "n": 98,
   "role": "host",
   "part": "한계",
   "text": "그리고 3배를 고르려면, 넣은 돈의 90% 안팎이 사라지는 때를 두 번 견뎌야 했어요.",
   "start": 455.24,
   "end": 460.65
  },
  {
   "n": 99,
   "role": "host",
   "part": "한계",
   "text": "세금과 환율, 물가는 넣지 않았어요.",
   "start": 461.1,
   "end": 463.57
  },
  {
   "n": 100,
   "role": "host",
   "part": "한계",
   "text": "투자 권유가 아니라, 규칙을 코드로 확인해 본 결과입니다.",
   "start": 464.02,
   "end": 467.31
  },
  {
   "n": 101,
   "role": "host",
   "part": "마무리",
   "text": "다음에 백테스트로 확인해 볼 가설이 있다면 댓글로 알려 주세요.",
   "start": 468.31,
   "end": 472.08
  },
  {
   "n": 102,
   "role": "host",
   "part": "마무리",
   "text": "시청해주셔서 감사합니다.",
   "start": 472.53,
