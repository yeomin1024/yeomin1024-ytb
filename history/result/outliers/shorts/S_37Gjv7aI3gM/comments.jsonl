{"id": "UgwoiVLfFzHLVthHp914AaABAg.AbtdvOtF8g6Abtzw7TFEsz", "parent": "UgwoiVLfFzHLVthHp914AaABAg", "likes": 2, "text": "발해를 하늘이\n도왔군요.", "published": "2026-10-13T09:27:28", "replies": 0, "creator": false}
