 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "빨리 부자 되려던 김 과장",
   "text": "마흔둘 김 과장은 빨리 부자가 되려다, 1억 원이 석 달도 안 돼 3천만 원이 됐습니다.",
   "start": 0.3,
   "end": 5.111
  },
  {
   "n": 2,
   "role": "host",
   "part": "빨리 부자 되려던 김 과장",
   "text": "4월, 동료가 5천만 원을 벌었다는 말에 비상금으로 SK하이닉스를 샀습니다.",
   "start": 5.491,
   "end": 10.61
  },
  {
   "n": 3,
   "role": "host",
   "part": "빨리 부자 되려던 김 과장",
   "text": "한 달 만에 58%를 벌자, 적금까지 깨서 1억 원을 채웠습니다.",
   "start": 10.99,
   "end": 15.649
  },
  {
   "n": 4,
   "role": "host",
   "part": "빨리 부자 되려던 김 과장",
   "text": "코스피가 처음 9,000을 넘은 날엔, 1억 원을 더 빌려 샀습니다.",
   "start": 16.029,
   "end": 19.759
  },
  {
   "n": 5,
   "role": "host",
   "part": "빨리 부자 되려던 김 과장",
   "text": "7월 13일 하루에 15%가 떨어져도, 팔지 않으면 손해가 아니라며 버텼습니다.",
   "start": 20.139,
   "end": 25.179
  },
  {
   "n": 6,
   "role": "host",
   "part": "빨리 부자 되려던 김 과장",
   "text": "7월 29일 아침, 주식은 김 과장이 아니라 증권사가 팔았습니다.",
   "start": 25.559,
   "end": 29.989
  },
  {
   "n": 7,
   "role": "host",
   "part": "빨리 부자 되려던 김 과장",
   "text": "이틀 뒤 상한가가 오자, 남은 돈을 모두 레버리지 ETF에 넣었습니다.",
   "start": 30.369,
   "end": 34.774
  },
  {
   "n": 8,
   "role": "host",
   "part": "빨리 부자 되려던 김 과장",
   "text": "8월 12일, 남은 돈은 2,960만 원이었습니다.",
   "start": 35.154,
   "end": 38.734
  },
  {
   "n": 9,
   "role": "host",
   "part": "빨리 부자 되려던 김 과장",
   "text": "김 과장은 어느 장면에서 멈췄어야 했을까요?",
