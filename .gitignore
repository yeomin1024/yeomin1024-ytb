# 비밀 정보 — 절대 커밋하지 않음
.env
cookies*.txt

# 실행 산출물 (결과는 스크립트가 GitHub의 <PROJECT_FOLDER>/<RESULT_FOLDER>로 따로 푸시함)
output/
.yt_work/

# 파이썬 환경
.venv/
venv/
__pycache__/
*.pyc
# 영상 제작 (Remotion) — 렌더 결과 영상은 용량이 커서 올리지 않음 (썸네일·스토리보드 이미지는 올림)
node_modules/
**/out/**/*.mp4
**/out/**/*.mov
video/.remotion/
# 실행기(run_analyzer)가 받는 중인 임시 파일·설정 백업
*.download
*.toml.bak
video/public/fonts/
video/public/audio/
*.srt.bak-*
# Claude Code 임시 작업 공간 (에이전트 worktree) — 커밋하지 않음
.claude/worktrees/
# 성공 사례 수집(tools/outlier_research.py): 다른 채널의 자막·댓글 원문·썸네일·캐시는 공개 저장소에 올리지 않음.
# 저장소가 비공개면 PC 실행(분석기 v2.5.0 --push-only)이 사례 폴더를 git add -f 로 올린다 (사용자 지시 2026-10-13)
*/result/outliers/.cache/
*/result/outliers/[0-9][0-9]_*/
*/result/outliers/P[0-9][0-9]_*/
*/result/outliers/_old/
