 },
 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "배당이 들어오면 든든해서, 배당 ETF를 모으는 분이 많죠.",
   "start": 0.3,
   "end": 3.91
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "그런데 받을 때마다 떼는 세금까지 빼도, 지수 ETF보다 더 남을까요?",
   "start": 4.36,
   "end": 9.0
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "미국 배당주 ETF인 SCHD와, S&P 500 ETF인 SPY로 백테스트해 보겠습니다.",
   "start": 9.45,
   "end": 16.0
  },
  {
   "n": 4,
   "role": "host",
   "part": "규칙",
   "text": "2011년부터 매달 첫 거래일에 1,000달러씩 매수해요.",
   "start": 17.0,
   "end": 20.44
  },
  {
   "n": 5,
   "role": "host",
   "part": "규칙",
   "text": "배당은 15%를 떼고 다시 매수하고, 수수료는 0.25%예요.",
   "start": 20.89,
   "end": 25.86
  },
  {
   "n": 6,
   "role": "host",
   "part": "경주",
   "text": "이제 날짜를 흘려 보겠습니다.",
   "start": 26.86,
   "end": 28.45
  },
  {
   "n": 7,
   "role": "host",
   "part": "경주",
   "text": "보라 선이 SCHD 계좌, 파란 선이 SPY 계좌예요.",
   "start": 28.9,
   "end": 32.7
  },
  {
   "n": 8,
   "role": "host",
   "part": "경주",
   "text": "노란 점선은 지금까지 넣은 돈이에요.",
   "start": 33.15,
   "end": 35.63
  },
  {
   "n": 9,
   "role": "host",
   "part": "경주",
   "text": "위 숫자는 각 계좌가 받은 배당과 낸 세금입니다.",
   "start": 36.08,
   "end": 39.16
  },
  {
   "n": 10,
   "role": "host",
   "part": "경주",
   "text": "1,000달러로 매수할 수 있는 만큼, 소수점 주식까지 셉니다.",
   "start": 39.61,
   "end": 43.29
  },
  {
   "n": 11,
   "role": "host",
   "part": "경주",
   "text": "2017년까지는 앞선 계좌가 43번 바뀌며, 두 계좌가 엎치락뒤치락했어요.",
   "start": 43.74,
   "end": 49.1
  },
  {
   "n": 12,
   "role": "host",
   "part": "경주",
   "text": "2018년 1월 2일부터는 SPY가 앞섰습니다.",
   "start": 49.55,
   "end": 52.67
  },
  {
   "n": 13,
   "role": "host",
   "part": "경주",
   "text": "2019년 배당은 SCHD가 SPY보다 63.1% 많았지만, 계좌는 SPY가 앞섰어요.",
   "start": 53.12,
   "end": 60.54
  },
  {
   "n": 14,
   "role": "host",
   "part": "경주",
   "text": "코로나 폭락 때는 3월 23일까지 두 계좌가 함께 떨어졌어요.",
   "start": 60.99,
   "end": 65.19
  },
  {
   "n": 15,
   "role": "host",
   "part": "경주",
   "text": "SCHD 계좌는 32.8%, SPY 계좌는 33.4% 줄어, 손해가 비슷했어요.",
   "start": 65.64,
   "end": 73.88
  },
  {
   "n": 16,
   "role": "host",
   "part": "하락장",
   "text": "2022년, 긴 하락장이 왔어요.",
   "start": 74.88,
   "end": 77.2
  },
  {
   "n": 17,
   "role": "host",
   "part": "하락장",
   "text": "4월에는 SCHD가 다시 앞섰습니다.",
   "start": 77.65,
   "end": 80.13
  },
  {
   "n": 18,
   "role": "host",
   "part": "하락장",
   "text": "그해 SCHD는 14.6%, SPY는 22.2% 줄어, SCHD가 덜 떨어졌어요.",
   "start": 80.58,
   "end": 87.62
  },
  {
   "n": 19,
   "role": "host",
   "part": "하락장",
   "text": "2023년 1월 6일에는 SCHD가 약 3만 3천 달러까지 앞섰어요.",
   "start": 88.07,
   "end": 93.1
  },
  {
   "n": 20,
   "role": "host",
   "part": "하락장",
   "text": "그런데 2023년 4월 26일, SPY가 다시 앞섰습니다.",
   "start": 93.55,
   "end": 97.38
  },
  {
   "n": 21,
   "role": "host",
   "part": "하락장",
   "text": "2025년에도 배당은 SCHD가 SPY의 2.6배였지만, 계좌 차이는 더 벌어졌어요.",
   "start": 97.83,
   "end": 104.15
  },
  {
   "n": 22,
   "role": "host",
   "part": "결과",
   "text": "2026년 10월 15일, 결과입니다.",
   "start": 105.15,
   "end": 107.87
  },
  {
   "n": 23,
   "role": "host",
   "part": "결과",
   "text": "두 계좌 모두 180번, 18만 달러를 넣었어요.",
   "start": 108.32,
   "end": 111.5
  },
  {
   "n": 24,
   "role": "host",
   "part": "결과",
   "text": "SCHD 계좌는 약 48만 달러, SPY 계좌는 약 59만 달러였어요.",
   "start": 111.95,
   "end": 117.55
  },
  {
   "n": 25,
   "role": "host",
   "part": "결과",
   "text": "SPY 계좌가 1.22배, 약 11만 달러 더 많았습니다.",
   "start": 118.0,
   "end": 122.71
  },
  {
   "n": 26,
   "role": "host",
   "part": "결과",
   "text": "2023년 4월 26일 뒤로, SCHD는 다시 앞서지 못했어요.",
   "start": 123.16,
   "end": 127.84
  },
  {
   "n": 27,
   "role": "host",
   "part": "결과",
   "text": "SCHD가 앞선 날은 전체 거래일의 20.1%뿐이었습니다.",
   "start": 128.29,
   "end": 132.67
  },
  {
   "n": 28,
   "role": "host",
   "part": "결과",
   "text": "받은 배당은 SCHD가 약 8만 7천 달러로, SPY의 2.1배였어요.",
   "start": 133.12,
   "end": 138.64
  },
  {
   "n": 29,
   "role": "host",
   "part": "결과",
   "text": "그만큼 세금도 약 1만 3천 달러로, SPY의 2.1배를 냈습니다.",
   "start": 139.09,
   "end": 143.9
  },
  {
   "n": 30,
   "role": "host",
   "part": "결과",
   "text": "지난 1년 배당은 SCHD가 약 1만 5천 달러로, SPY의 2.5배예요.",
   "start": 144.35,
   "end": 149.64
  },
  {
   "n": 31,
   "role": "host",
   "part": "결과",
   "text": "2012년부터는 해마다, 손에 들어온 배당이 SCHD 계좌가 더 많았습니다.",
   "start": 150.09,
   "end": 155.03
  },
  {
   "n": 32,
   "role": "host",
   "part": "구조",
   "text": "배당을 더 많이 받았는데, 왜 덜 남았을까요?",
   "start": 156.03,
   "end": 158.91
  },
  {
   "n": 33,
   "role": "host",
   "part": "구조",
   "text": "배당이 어디서 나오는지 보겠습니다.",
   "start": 159.36,
   "end": 161.59
  },
  {
   "n": 34,
   "role": "host",
   "part": "구조",
   "text": "배당을 주는 날, 주가는 보통 배당만큼 내려가요.",
   "start": 162.04,
   "end": 165.28
  },
  {
   "n": 35,
   "role": "host",
   "part": "구조",
   "text": "회사 돈이 주주에게 나가니, 그만큼 회사 값이 줄어드는 거죠.",
   "start": 165.73,
   "end": 169.47
  },
  {
   "n": 36,
   "role": "host",
   "part": "구조",
   "text": "그래서 배당을 받는 순간에는, 계좌 전체 값이 늘지 않습니다.",
   "start": 169.92,
   "end": 173.63
  },
  {
   "n": 37,
   "role": "host",
   "part": "구조",
   "text": "대신 세금은 배당을 받는 순간 떼어 가요.",
   "start": 174.08,
   "end": 176.66
  },
  {
   "n": 38,
   "role": "host",
   "part": "구조",
   "text": "실제 계좌로 한 번 보겠습니다.",
   "start": 177.11,
   "end": 178.88
  },
  {
   "n": 39,
   "role": "host",
   "part": "구조",
   "text": "2025년 12월 10일, SCHD는 1주에 0.278달러를 배당했어요.",
   "start": 179.33,
   "end": 185.09
  },
  {
   "n": 40,
   "role": "host",
   "part": "구조",
   "text": "계좌 전체로는 3,743달러였습니다.",
   "start": 185.54,
   "end": 188.4
  },
  {
   "n": 41,
   "role": "host",
   "part": "구조",
   "text": "세금 15%, 561달러를 떼고, 3,181달러가 남았어요.",
   "start": 188.85,
   "end": 194.3
  },
  {
   "n": 42,
   "role": "host",
   "part": "구조",
   "text": "이 돈으로 수수료를 빼고 27.57달러에 115.1주를 다시 매수했습니다.",
   "start": 194.75,
   "end": 199.9
  },
  {
   "n": 43,
   "role": "host",
   "part": "구조",
   "text": "지수 ETF도 배당을 주지만, 그 양이 적어요.",
   "start": 200.35,
   "end": 203.47
  },
  {
   "n": 44,
   "role": "host",
   "part": "구조",
   "text": "2025년 배당률은 SCHD 3.8%, SPY 1.2%였습니다.",
   "start": 203.92,
   "end": 210.0
  },
  {
   "n": 45,
   "role": "host",
   "part": "구조",
   "text": "배당을 많이 받을수록, 세금도 일찍 많이 내는 구조예요.",
   "start": 210.45,
   "end": 214.04
  },
  {
   "n": 46,
   "role": "host",
   "part": "해마다",
   "text": "매달 넣는 순서를 빼고, 상품 자체만 보면 어땠을까요?",
   "start": 215.04,
   "end": 218.47
  },
  {
   "n": 47,
   "role": "host",
   "part": "해마다",
   "text": "세금과 수수료를 빼고, 배당을 다시 넣은 1년 수익률을 해마다 비교했어요.",
   "start": 218.92,
   "end": 223.75
  },
  {
   "n": 48,
   "role": "host",
   "part": "해마다",
   "text": "2012년부터 2025년까지 14년 중, SCHD가 더 많이 오른 해는 4번이었습니다.",
   "start": 224.2,
   "end": 229.88
  },
  {
   "n": 49,
   "role": "host",
   "part": "해마다",
   "text": "2022년에는 SCHD 3.2% 하락, SPY 18.2% 하락이었어요.",
   "start": 230.33,
   "end": 236.41
  },
  {
   "n": 50,
   "role": "host",
   "part": "해마다",
   "text": "2023년에는 SCHD 4.6%, SPY 26.2% 상승이었고요.",
   "start": 236.86,
   "end": 242.91
  },
  {
   "n": 51,
   "role": "host",
   "part": "해마다",
   "text": "2024년에는 SCHD 11.7%, SPY 24.9% 상승이었습니다.",
   "start": 243.36,
   "end": 249.92
  },
  {
   "n": 52,
   "role": "host",
   "part": "해마다",
   "text": "2025년에는 SCHD 4.3%, SPY 17.7% 상승이었어요.",
   "start": 250.37,
   "end": 256.45
  },
  {
   "n": 53,
   "role": "host",
   "part": "다른 조건",
   "text": "세금이 차이를 만든 걸까요?",
   "start": 257.45,
   "end": 259.12
  },
  {
   "n": 54,
   "role": "host",
   "part": "다른 조건",
   "text": "15%는 많은 나라 투자자가 미국 배당을 받을 때 미리 떼이는 세율이에요.",
   "start": 259.57,
   "end": 264.16
  },
  {
   "n": 55,
   "role": "host",
   "part": "다른 조건",
   "text": "세금을 0%로 하면, SCHD 약 51만 달러, SPY 약 60만 달러였어요.",
   "start": 264.61,
   "end": 270.98
  },
  {
   "n": 56,
   "role": "host",
   "part": "다른 조건",
   "text": "세금이 없어도 SPY가 1.19배 많았습니다.",
   "start": 271.43,
   "end": 274.56
  },
  {
   "n": 57,
   "role": "host",
   "part": "다른 조건",
   "text": "30%를 떼면, 차이는 1.25배로 커졌어요.",
   "start": 275.01,
   "end": 278.57
  },
  {
   "n": 58,
   "role": "host",
   "part": "다른 조건",
   "text": "끝에 모두 매도하고, 늘어난 돈에 15% 세금을 내면 어떨까요?",
   "start": 279.02,
   "end": 283.16
  },
  {
   "n": 59,
   "role": "host",
   "part": "다른 조건",
   "text": "SCHD 약 45만 달러, SPY 약 53만 달러로, 차이는 1.19배로 줄었습니다.",
   "start": 283.61,
   "end": 290.17
  },
  {
   "n": 60,
   "role": "host",
   "part": "다른 조건",
   "text": "SCHD는 배당으로 세금을 미리 냈기 때문이에요.",
   "start": 290.62,
   "end": 293.76
  },
  {
   "n": 61,
   "role": "host",
   "part": "다른 조건",
   "text": "매달 모으지 않고, 처음에 10만 달러를 한 번에 넣었다면요?",
   "start": 294.21,
   "end": 297.91
  },
  {
   "n": 62,
   "role": "host",
   "part": "다른 조건",
   "text": "SCHD 약 61만 달러, SPY 약 79만 달러로, SPY가 1.29배였어요.",
   "start": 298.36,
   "end": 305.4
  },
  {
   "n": 63,
   "role": "host",
   "part": "시작 시점",
   "text": "2011년 11월이라는 시작이 결과를 바꿨을 수도 있죠.",
   "start": 306.4,
   "end": 309.84
  },
  {
   "n": 64,
   "role": "host",
   "part": "시작 시점",
   "text": "시작한 달이 달랐다면 어땠을까요?",
   "start": 310.29,
   "end": 312.44
  },
  {
   "n": 65,
   "role": "host",
   "part": "시작 시점",
   "text": "2011년 11월부터 2021년 10월까지, 달마다 시작한 5년 적립 계좌를 만들었어요.",
   "start": 312.89,
   "end": 318.97
  },
  {
   "n": 66,
   "role": "host",
   "part": "시작 시점",
   "text": "모두 120개입니다.",
   "start": 319.42,
   "end": 320.86
  },
  {
   "n": 67,
   "role": "host",
   "part": "시작 시점",
   "text": "SCHD가 더 많이 남은 건 120개 중 25개뿐이었어요.",
   "start": 321.31,
   "end": 325.4
  },
  {
   "n": 68,
   "role": "host",
   "part": "시작 시점",
   "text": "가장 크게 앞선 건 2018년 1월에 시작한 계좌로, SCHD가 1.15배였습니다.",
   "start": 325.85,
   "end": 331.73
  },
  {
   "n": 69,
   "role": "host",
   "part": "시작 시점",
   "text": "반대로 2020년 11월에 시작한 계좌는 SPY가 1.34배였어요.",
   "start": 332.18,
   "end": 336.89
  },
  {
   "n": 70,
   "role": "host",
   "part": "시작 시점",
   "text": "10년 적립 계좌 60개에서는, SCHD가 앞선 게 12개였습니다.",
   "start": 337.34,
   "end": 341.82
  },
  {
   "n": 71,
   "role": "host",
   "part": "더 긴 기간",
   "text": "SCHD는 2011년에 생겨서, 2008년 금융위기를 겪지 않았어요.",
   "start": 342.82,
   "end": 347.46
  },
  {
   "n": 72,
   "role": "host",
   "part": "더 긴 기간",
   "text": "배당주가 하락장에 강하다면, 금융위기가 든 기간은 다를 수 있어요.",
   "start": 347.91,
   "end": 351.94
  },
  {
   "n": 73,
   "role": "host",
   "part": "더 긴 기간",
   "text": "그래서 2006년에 생긴 미국 고배당주 ETF, VYM으로도 해 봤습니다.",
   "start": 352.39,
   "end": 357.03
  },
  {
   "n": 74,
   "role": "host",
   "part": "더 긴 기간",
   "text": "2006년 12월부터, 같은 규칙으로 매달 1,000달러씩이에요.",
   "start": 357.48,
   "end": 361.16
  },
  {
   "n": 75,
   "role": "host",
   "part": "더 긴 기간",
   "text": "금융위기 때 VYM은 29.2%, SPY는 33.7% 줄어, VYM이 덜 떨어졌어요.",
   "start": 361.61,
   "end": 369.72
  },
  {
   "n": 76,
   "role": "host",
   "part": "더 긴 기간",
   "text": "2011년 10월 말까지는 VYM이 약 6만 7천 달러로, SPY보다 앞섰어요.",
   "start": 370.17,
   "end": 376.33
  },
  {
   "n": 77,
   "role": "host",
   "part": "더 긴 기간",
   "text": "2026년 10월 15일까지 넣은 돈은 23만 9천 달러예요.",
   "start": 376.78,
   "end": 381.82
  },
  {
   "n": 78,
   "role": "host",
   "part": "더 긴 기간",
   "text": "VYM 약 81만 달러, SPY 약 110만 달러로, SPY가 1.35배 많았어요.",
   "start": 382.27,
   "end": 388.43
  },
  {
   "n": 79,
   "role": "host",
   "part": "더 긴 기간",
   "text": "10년 적립 계좌 119개 중, VYM이 더 많이 남은 건 5개뿐이었습니다.",
   "start": 388.88,
   "end": 393.75
  },
  {
   "n": 80,
   "role": "host",
   "part": "정리",
   "text": "정리하겠습니다.",
   "start": 394.75,
   "end": 395.87
  },
  {
   "n": 81,
   "role": "host",
   "part": "정리",
   "text": "세금 15%를 떼고 15년 동안 매달 모았어요.",
   "start": 396.32,
   "end": 399.52
  },
  {
   "n": 82,
   "role": "host",
   "part": "정리",
   "text": "SPY 계좌가 SCHD 계좌의 1.22배였습니다.",
   "start": 399.97,
   "end": 403.8
  },
  {
   "n": 83,
   "role": "host",
   "part": "정리",
   "text": "세금이 없어도 1.19배였습니다.",
   "start": 404.25,
   "end": 406.33
  },
  {
   "n": 84,
   "role": "host",
   "part": "정리",
   "text": "SCHD는 배당을 2.1배 받았고, 세금도 그만큼 더 냈어요.",
   "start": 406.78,
   "end": 411.31
  },
  {
   "n": 85,
   "role": "host",
   "part": "정리",
   "text": "2022년 같은 하락장에서는 SCHD가 덜 떨어졌습니다.",
   "start": 411.76,
   "end": 415.96
  },
  {
   "n": 86,
   "role": "host",
   "part": "정리",
   "text": "시작한 달을 바꾸면 SCHD가 앞선 계좌도 있었지만, 120개 중 25개였어요.",
   "start": 416.41,
   "end": 422.26
  },
  {
   "n": 87,
   "role": "host",
   "part": "정리",
   "text": "2006년부터 본 VYM도, 10년 계좌 119개 중 114개에서 SPY보다 적었습니다.",
   "start": 422.71,
   "end": 429.36
  },
  {
   "n": 88,
   "role": "host",
   "part": "한계",
   "text": "이 기간은 미국 대형 성장주가 크게 오른 때였어요.",
   "start": 430.36,
   "end": 433.67
  },
  {
   "n": 89,
   "role": "host",
   "part": "한계",
   "text": "배당주가 더 강했던 기간이라면, 결과가 다를 수 있습니다.",
   "start": 434.12,
   "end": 437.36
  },
  {
   "n": 90,
   "role": "host",
   "part": "한계",
   "text": "배당을 꺼내 생활비로 쓰는 경우는 이번 계산에 넣지 않았어요.",
   "start": 437.81,
   "end": 441.32
  },
  {
   "n": 91,
   "role": "host",
   "part": "한계",
   "text": "세율은 나라와 계좌마다 다르고, 건강보험료와 환율, 물가도 넣지 않았습니다.",
   "start": 441.77,
   "end": 447.57
  },
  {
   "n": 92,
   "role": "host",
   "part": "한계",
   "text": "그리고 SPY 쪽은 2022년처럼 22.2% 줄어드는 해를 견뎌야 했어요.",
   "start": 448.02,
   "end": 453.3
  },
  {
   "n": 93,
   "role": "host",
   "part": "한계",
   "text": "투자 권유가 아니라, 규칙을 코드로 확인해 본 결과입니다.",
   "start": 453.75,
   "end": 457.04
  },
  {
   "n": 94,
   "role": "host",
   "part": "마무리",
   "text": "다음에 백테스트로 확인해 볼 가설이 있다면 댓글로 알려 주세요.",
   "start": 458.04,
   "end": 461.81
  },
  {
   "n": 95,
   "role": "host",
   "part": "마무리",
   "text": "시청해주셔서 감사합니다.",
   "start": 462.26,
   "end": 463.81
  }
 ],
 "voice_sha1": "f0d0f801940b36b1"
