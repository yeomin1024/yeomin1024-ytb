{"id": "UgxoozjXe4CLSp_aakp4AaABAg.AW8VLJ_dk79AWZs_13UWSB", "parent": "UgxoozjXe4CLSp_aakp4AaABAg", "likes": 0, "text": "4rrrrrrrrrrrrrrrrrrrrrrrrrŕř😢⁵þ⁵😮😢😢⁵", "published": "2026-05-09T01:30:44", "replies": 0, "creator": false}
