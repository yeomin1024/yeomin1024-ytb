{"id": "UgwTDFsRuNcwKQq5eUR4AaABAg.Ab5Mfc47cZBAb71bfaRfvn", "parent": "UgwTDFsRuNcwKQq5eUR4AaABAg", "likes": 2, "text": "저도 가 보았습니다~ 춘천 근처", "published": "2026-09-23T23:48:52", "replies": 0, "creator": false}
