{"id": "Ugy1bYq7gxRJHOk7EAV4AaABAg", "parent": null, "likes": 1, "text": "좋은 영상 올려주셔서 정말 감사드립니다", "published": "2026-05-19T21:20:36", "replies": 0, "creator": false}
