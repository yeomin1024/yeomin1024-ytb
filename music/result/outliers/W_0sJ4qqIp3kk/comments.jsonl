{"id": "UgycSM-IzCT6BwWUKch4AaABAg.AXEXwykZNimAXID6vjzHhJ", "parent": "UgycSM-IzCT6BwWUKch4AaABAg", "likes": 0, "text": "本当にいつ聴いても心に響く、時を超えた名曲ですよね✨", "published": "2026-05-27T01:24:03", "replies": 0, "creator": true}
