{"id": "UgyvfK91x3BSiQO4R694AaABAg.A_kqWaFYZu3A_ppdDNztyk", "parent": "UgyvfK91x3BSiQO4R694AaABAg", "likes": 3, "text": "주는데 안받으면 기분 나쁘더라구요", "published": "2026-08-23T01:37:45", "replies": 0, "creator": false}
