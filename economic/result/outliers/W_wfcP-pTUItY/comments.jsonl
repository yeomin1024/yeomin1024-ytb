{"id": "UgxI4Etc2eGKCnqQJPR4AaABAg.Ac-ptZbX0wyAc0Q0DuxTa7", "parent": "UgxI4Etc2eGKCnqQJPR4AaABAg", "likes": 0, "text": "네  알겠습니다", "published": "2026-10-16T06:38:46", "replies": 0, "creator": false}
