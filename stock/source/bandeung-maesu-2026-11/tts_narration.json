 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "폭락 뒤에 주가가 반등했는데, 반갑기보다 불안합니다.",
   "start": 0.3,
   "end": 3.644
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "또 떨어지려는 건 아닐까 싶어서죠.",
   "start": 4.024,
   "end": 5.984
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "그 불안은 틀리지 않았습니다.",
   "start": 6.364,
   "end": 7.888
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "미국 증시가 1년 최고가보다 10% 넘게 빠진 뒤, 하루 3% 넘게 오른 날을 셌습니다.",
   "start": 8.268,
   "end": 14.103
  },
  {
   "n": 5,
   "role": "host",
   "part": "도입",
   "text": "2000년부터 83번이었고, 그중 56번은 반년 안에 저점을 다시 깼습니다.",
   "start": 14.483,
   "end": 19.813
  },
  {
   "n": 6,
   "role": "host",
   "part": "도입",
   "text": "코스피도 같은 기준으로 세면, 137번 중 98번이 그랬습니다.",
   "start": 20.193,
   "end": 24.872
  },
  {
   "n": 7,
   "role": "host",
   "part": "도입",
   "text": "그럼 닷컴 버블, 금융위기, 코로나 때처럼 30% 넘게 물린 채 급반등을 맞았다면요.",
   "start": 25.252,
   "end": 31.082
  },
  {
   "n": 8,
   "role": "host",
   "part": "도입",
   "text": "팔았어야 할까요, 버텼어야 할까요?",
   "start": 31.462,
   "end": 33.803
  },
  {
   "n": 9,
   "role": "host",
   "part": "도입",
   "text": "미국에서 그대로 버텼다면, 본전까지 가운데 값으로 3.7년이 걸렸습니다.",
   "start": 34.183,
   "end": 38.993
  },
  {
   "n": 10,
   "role": "host",
   "part": "도입",
   "text": "절반을 매도한 뒤, 10% 더 떨어지기 전에 10% 올라 버린 경우도 있습니다.",
   "start": 39.373,
   "end": 44.252
  },
  {
   "n": 11,
   "role": "host",
   "part": "도입",
   "text": "미국은 32번 중 14번, 코스피는 70번 중 39번이었습니다.",
   "start": 44.633,
   "end": 49.315
  },
  {
   "n": 12,
   "role": "host",
   "part": "도입",
   "text": "팔았다면 얼마를 잃었는지, 그리고 팔지 버틸지를 가르는 기준까지 보여 드리겠습니다.",
   "start": 49.695,
   "end": 55.105
  },
  {
   "n": 13,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "83번 중 56번, 세 번 중 두 번이라는 숫자부터 따져 보겠습니다.",
   "start": 56.105,
   "end": 60.785
  },
  {
   "n": 14,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "기록은 닷컴 버블 꼭대기인 2000년부터 2026년 10월까지의 미국 S&P 500입니다.",
   "start": 61.165,
   "end": 66.828
  },
  {
   "n": 15,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "저점은 반등 직전 20거래일 가운데 가장 낮았던 종가로 잡았습니다.",
   "start": 67.208,
   "end": 71.404
  },
  {
   "n": 16,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "깨진 56번 가운데 절반은 17거래일, 한 달이 채 안 돼서 깨졌습니다.",
   "start": 71.784,
   "end": 76.625
  },
  {
   "n": 17,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "기준을 여섯 가지로 바꿔도, 가짜는 열 번 중 여섯 번 안팎이었습니다.",
   "start": 77.005,
   "end": 81.242
  },
  {
   "n": 18,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "그럼 아주 크게 오른 날은 믿어도 될까요?",
   "start": 81.622,
   "end": 83.968
  },
  {
   "n": 19,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "2000년 이후 미국 증시가 하루에 가장 크게 오른 날은 2008년 10월 13일입니다.",
   "start": 84.348,
   "end": 89.133
  },
  {
   "n": 20,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "이날 S&P 500 지수는 하루에 11.6% 올랐습니다.",
   "start": 89.513,
   "end": 93.523
  },
  {
   "n": 21,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "이만큼 오르면, 이제 바닥이라고 믿고 싶어집니다.",
   "start": 93.903,
   "end": 97.009
  },
  {
   "n": 22,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "하지만 지수는 그날보다 32.6% 더 떨어졌습니다.",
   "start": 97.389,
   "end": 101.074
  },
  {
   "n": 23,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "가장 크게 오른 날 20번 가운데 19번이 이렇게 하락 중에 나왔습니다.",
   "start": 101.454,
   "end": 105.619
  },
  {
   "n": 24,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "그럼 전문가들이 말하는 차트 신호는 어땠을까요?",
   "start": 105.999,
   "end": 108.727
  },
  {
   "n": 25,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "차트를 볼 때 흔히 쓰는 신호 하나를 골랐습니다.",
   "start": 109.107,
   "end": 111.781
  },
  {
   "n": 26,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "거래가 평소보다 늘면서 주가가 20일 평균 위로 올라서면 진짜라는 신호입니다.",
   "start": 112.161,
   "end": 117.161
  },
  {
   "n": 27,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "앞의 83번에는 며칠 사이로 붙어 나온 날이 여러 번 들어 있습니다.",
   "start": 117.541,
   "end": 121.451
  },
  {
   "n": 28,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "석 달 안에 붙은 날을 하나로 묶으면 반등은 스무 번이고, 그중 15번이 가짜였습니다.",
   "start": 121.831,
   "end": 127.088
  },
  {
   "n": 29,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "묶어서 세면 네 번 중 세 번이니, 세 번 중 두 번은 낮춰 잡은 숫자입니다.",
   "start": 127.468,
   "end": 131.891
  },
  {
   "n": 30,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "이 스무 번에 신호를 대 보니 13번을 맞혔습니다.",
   "start": 132.271,
   "end": 135.331
  },
  {
   "n": 31,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "그런데 아무것도 보지 않고 전부 가짜라고 했다면 15번을 맞혔습니다.",
   "start": 135.711,
   "end": 139.655
  },
  {
   "n": 32,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "스무 번뿐이라 크게 말할 수는 없지만, 신호를 본다고 더 잘 맞히지는 못했습니다.",
   "start": 140.035,
   "end": 145.113
  },
  {
   "n": 33,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "그러니 반등에 속은 건 여러분의 실력 문제가 아닙니다.",
   "start": 145.493,
   "end": 148.336
  },
  {
   "n": 34,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "기록에서는 속는 쪽이 보통이었습니다.",
   "start": 148.716,
   "end": 151.026
  },
  {
   "n": 35,
   "role": "host",
   "part": "속는 쪽이 보통이었다",
   "text": "그럼 속아서 매수한 사람들은 그 뒤 어떻게 됐을까요?",
   "start": 151.406,
   "end": 154.488
  },
  {
   "n": 36,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "가짜였던 15번의 반등 다음 날 매수했더라도, 15번 모두 매수가를 되찾았습니다.",
   "start": 155.488,
   "end": 160.754
  },
  {
   "n": 37,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "9번은 1년이 걸리지 않았고, 가장 오래 걸린 경우는 약 6년이었습니다.",
   "start": 161.134,
   "end": 165.97
  },
  {
   "n": 38,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "더 나쁜 경우도 보겠습니다.",
   "start": 166.35,
   "end": 167.853
  },
  {
   "n": 39,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "하락이 시작되기 직전, 최고가에 매수한 사람입니다.",
   "start": 168.233,
   "end": 171.462
  },
  {
   "n": 40,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "2000년 이후 미국 증시가 최고가에서 15% 넘게 빠진 하락은 여섯 번입니다.",
   "start": 171.842,
   "end": 176.99
  },
  {
   "n": 41,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "가장 깊었던 금융위기 때는 55.2%가 빠졌습니다.",
   "start": 177.37,
   "end": 181.239
  },
  {
   "n": 42,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "여섯 번 모두 최고가를 되찾았습니다.",
   "start": 181.619,
   "end": 183.759
  },
  {
   "n": 43,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "세 번은 1년 안에 되찾았고, 가장 오래 걸린 닷컴 버블은 6.6년이었습니다.",
   "start": 184.139,
   "end": 189.17
  },
  {
   "n": 44,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "그런데 닷컴 버블 꼭대기에 매수한 사람은, 본전을 찾자마자 금융위기를 만났습니다.",
   "start": 189.55,
   "end": 194.63
  },
  {
   "n": 45,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "다시 본전 아래로 내려갔고, 완전히 벗어난 건 매수한 지 11.7년 뒤였습니다.",
   "start": 195.01,
   "end": 200.052
  },
  {
   "n": 46,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "미국 지수는 그 뒤 최고가를 다시 썼으니, 어느 하락에서 매수했든 지금은 본전 위입니다.",
   "start": 200.432,
   "end": 205.982
  },
  {
   "n": 47,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "그래서 볼 것은 되찾았느냐가 아니라, 얼마나 걸렸느냐입니다.",
   "start": 206.362,
   "end": 209.942
  },
  {
   "n": 48,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "그럼 코스피는 어땠을까요?",
   "start": 210.322,
   "end": 211.836
  },
  {
   "n": 49,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "코스피는 30% 넘게 빠진 지난 네 번을 모두 되찾았지만, 길게는 5.5년이 걸렸습니다.",
   "start": 212.216,
   "end": 218.306
  },
  {
   "n": 50,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "30%까지는 빠지지 않았던 2011년 최고가도, 되찾는 데 6년이 걸렸습니다.",
   "start": 218.686,
   "end": 224.036
  },
  {
   "n": 51,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "그리고 이것은 지수의 기록이지, 종목의 기록이 아닙니다.",
   "start": 224.416,
   "end": 227.779
  },
  {
   "n": 52,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "2000년 무렵 미국에서 시가총액이 가장 컸던 회사들 가운데 여덟 곳을 봤습니다.",
   "start": 228.159,
   "end": 232.909
  },
  {
   "n": 53,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "그중 여섯 곳은 그때 최고가를 되찾는 데 10년이 넘게 걸렸습니다.",
   "start": 233.289,
   "end": 237.399
  },
  {
   "n": 54,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "시스코는 21년이 걸렸습니다.",
   "start": 237.779,
   "end": 239.769
  },
  {
   "n": 55,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "되찾지 못한 곳도 있습니다.",
   "start": 240.149,
   "end": 241.583
  },
  {
   "n": 56,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "2007년 최고가에 매수한 씨티그룹은 지금도 67% 아래에 있습니다.",
   "start": 241.963,
   "end": 246.462
  },
  {
   "n": 57,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "종목에 물린 분께 기록이 어디까지 말해 주는지는, 조금 뒤에 따로 보겠습니다.",
   "start": 246.842,
   "end": 251.59
  },
  {
   "n": 58,
   "role": "host",
   "part": "그래도 돌아왔다, 다만",
   "text": "그럼 반대로, 매도하고 기다리면 안전할까요?",
   "start": 251.97,
   "end": 254.803
  },
  {
   "n": 59,
   "role": "host",
   "part": "매도하고 기다려도 공짜가 아니었다",
   "text": "여섯 번의 바닥 뒤 한 달 동안, 주가는 가운데 값으로 15.0% 올랐습니다.",
   "start": 255.803,
   "end": 261.071
  },
  {
   "n": 60,
   "role": "host",
   "part": "매도하고 기다려도 공짜가 아니었다",
   "text": "가장 덜 오른 2022년에도 10.7%가 올랐습니다.",
   "start": 261.451,
   "end": 265.235
  },
  {
   "n": 61,
   "role": "host",
   "part": "매도하고 기다려도 공짜가 아니었다",
   "text": "물론 바닥은 지나고 나서야 알 수 있습니다.",
   "start": 265.615,
