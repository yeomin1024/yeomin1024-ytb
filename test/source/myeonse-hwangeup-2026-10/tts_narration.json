 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "11월 1일부터 일본 면세는, 출국하는 공항에서 세관 확인을 받아야 세금을 돌려받습니다.",
   "start": 0.3,
   "end": 5.939
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "방법을 모르고 가면, 붐비는 날에는 면세를 받는 데만 2시간 넘게 걸릴 수 있습니다.",
   "start": 6.319,
   "end": 11.448
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "알고 가면, 줄을 거의 서지 않고 2분 정도면 끝낼 수 있습니다.",
   "start": 11.828,
   "end": 15.678
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "그럼 어떻게 해야 가장 빠르게 면세를 받을 수 있을까요?",
   "start": 16.058,
   "end": 19.117
  },
  {
   "n": 5,
   "role": "host",
   "part": "도입",
   "text": "11월 이후에 일본에서 직접 면세를 받는다고 가정해 보겠습니다.",
   "start": 19.497,
   "end": 23.457
  },
  {
   "n": 6,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "A씨와 B씨는 11월에 각자 도쿄로 3박 4일 여행을 가려고 준비하고 있습니다.",
   "start": 24.457,
   "end": 29.487
  },
  {
   "n": 7,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "그런데 출국 전에 꼭 해 둘 일이 있습니다.",
   "start": 29.867,
   "end": 32.288
  },
  {
   "n": 8,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "바로 비지트 재팬 웹에 여권 정보를 등록해 두는 겁니다.",
   "start": 32.668,
   "end": 36.318
  },
  {
   "n": 9,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "비지트 재팬 웹은 입국 심사와 세관 신고에도 쓰는 일본 정부의 웹 서비스입니다.",
   "start": 36.698,
   "end": 41.662
  },
  {
   "n": 10,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "여권을 등록해 두면, 일곱 개 공항에서 휴대전화로 면세 수속을 할 수 있습니다.",
   "start": 42.042,
   "end": 46.982
  },
  {
   "n": 11,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "나리타, 하네다, 간사이, 주부, 후쿠오카, 신치토세, 나하 공항입니다.",
   "start": 47.362,
   "end": 53.213
  },
  {
   "n": 12,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "출발 로비의 면세 수속 단말기 앞에 줄을 서지 않고, 휴대전화로 세관 확인을 받는 겁니다.",
   "start": 53.593,
   "end": 59.082
  },
  {
   "n": 13,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "A씨는 출국 전에 등록을 마쳤지만, B씨는 하지 않았습니다.",
   "start": 59.462,
   "end": 63.289
  },
  {
   "n": 14,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "다만 주의할 점이 있습니다.",
   "start": 63.669,
   "end": 65.311
  },
  {
   "n": 15,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "휴대전화 수속은 공항 밖에서는 할 수 없습니다.",
   "start": 65.691,
   "end": 68.436
  },
  {
   "n": 16,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "공항 출발 로비에서 보안 검사를 받기 전에, 전용 와이파이에 연결해야만 할 수 있습니다.",
   "start": 68.816,
   "end": 74.064
  },
  {
   "n": 17,
   "role": "host",
   "part": "여행 가기 전 사전 준비",
   "text": "그래서 첫 번째는, 출국 전에 비지트 재팬 웹에 여권 정보를 등록해 두는 것입니다.",
   "start": 74.444,
   "end": 79.784
  },
  {
   "n": 18,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "B씨는 일본에 도착한 첫날, 돈키호테에서 과자와 화장품을 한 번에 계산했습니다.",
   "start": 80.784,
   "end": 86.285
  },
  {
   "n": 19,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "그런데 이 과자를 한 봉지라도 먹으면, 같이 산 화장품도 면세를 받을 수 없습니다.",
   "start": 86.665,
   "end": 91.955
  },
  {
   "n": 20,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "일본에서 먹을 과자와 화장품을 한 영수증으로 계산한 것이 실수였죠.",
   "start": 92.335,
   "end": 96.605
  },
  {
   "n": 21,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "세관 확인은 영수증 단위로 하기 때문입니다.",
   "start": 96.985,
   "end": 99.523
  },
  {
   "n": 22,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "한 영수증에 있는 물건 중 하나라도 없으면, 그 영수증 전체가 환급되지 않습니다.",
   "start": 99.903,
   "end": 104.819
  },
  {
   "n": 23,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "과자 한 봉지 때문에, 같이 산 화장품의 세금까지 돌려받지 못하게 된 겁니다.",
   "start": 105.199,
   "end": 109.946
  },
  {
   "n": 24,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "게다가 먹어서 없어진 물건이 있으면, 단말기로는 확인을 받을 수 없습니다.",
   "start": 110.326,
   "end": 114.664
  },
  {
   "n": 25,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "그래서 공항에 가면 세관 창구를 찾아가, 먹은 물건이 있다고 직접 신고해야 합니다.",
   "start": 115.044,
   "end": 119.996
  },
  {
   "n": 26,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "그래서 두 번째는, 일본에서 먹거나 쓸 물건을 면세품과 따로 계산하는 것입니다.",
   "start": 120.376,
   "end": 125.556
  },
  {
   "n": 27,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "A씨처럼 따로 계산하면, 과자를 먹어도 화장품 영수증은 그대로 환급받을 수 있습니다.",
   "start": 125.936,
   "end": 131.674
  },
  {
   "n": 28,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "둘째 날, 두 사람은 세금을 포함해 2만 2천 엔짜리 니트를 하나씩 샀습니다.",
   "start": 132.054,
   "end": 137.041
  },
  {
   "n": 29,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "이 가운데 2천 엔은 소비세라서, 나중에 돌려받을 수 있습니다.",
   "start": 137.421,
   "end": 141.251
  },
  {
   "n": 30,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "여기서 B씨는 세 번째 실수를 합니다.",
   "start": 141.631,
   "end": 143.759
  },
  {
   "n": 31,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "계산할 때 환급 방법을 정하는데, 공항에서 현금으로 받겠다고 한 겁니다.",
   "start": 144.139,
   "end": 148.979
  },
  {
   "n": 32,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "업계 발표로는, 공항 현금 환급 단말기가 하네다, 나리타, 나하 다섯 곳에 생깁니다.",
   "start": 149.359,
   "end": 154.989
  },
  {
   "n": 33,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "현금으로 받으려면, 출국하는 날 그 단말기 앞에 줄을 서야 합니다.",
   "start": 155.369,
   "end": 159.698
  },
  {
   "n": 34,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "반면 A씨는 계산할 때, 환급은 카드로 받겠다고 말했습니다.",
   "start": 160.078,
   "end": 163.968
  },
  {
   "n": 35,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "카드로 받으면 공항에서 줄을 설 필요가 없습니다.",
   "start": 164.348,
   "end": 167.5
  },
  {
   "n": 36,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "고를 수 있는 환급 방법은 매장과 환급 업체마다 다릅니다.",
   "start": 167.88,
   "end": 171.33
  },
  {
   "n": 37,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "그래서 세 번째는, 계산할 때 직원에게 환급은 카드로 받겠다고 말하는 것입니다.",
   "start": 171.71,
   "end": 176.66
  },
  {
   "n": 38,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "환급 수수료도 매장마다 달라서, 실제로 받는 돈은 2천 엔보다 조금 적을 수 있습니다.",
   "start": 177.04,
   "end": 182.293
  },
  {
   "n": 39,
   "role": "host",
   "part": "일본에서 쇼핑할 때 주의사항",
   "text": "그리고 면세품은 산 날부터 90일 안에 출국해야, 세관 확인을 받고 환급받을 수 있습니다.",
   "start": 182.673,
   "end": 188.483
  },
  {
   "n": 40,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "여행을 마친 두 사람은, 오후 6시에 출발하는 비행기를 탑니다.",
   "start": 189.483,
   "end": 193.533
  },
  {
   "n": 41,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "A씨는 앞의 방법을 모두 지켰고, B씨는 그렇지 않았습니다.",
   "start": 193.913,
   "end": 197.973
  },
  {
   "n": 42,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "공항에 도착해서 비행기를 타기 전까지, 두 사람을 단계별로 비교해 보겠습니다.",
   "start": 198.353,
   "end": 203.183
  },
  {
   "n": 43,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "두 사람 모두 출발 3시간 전인 오후 3시에 나리타 공항에 도착합니다.",
   "start": 203.563,
   "end": 208.242
  },
  {
   "n": 44,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "공항은 출국하는 사람이 많이 몰리는 시간대라고 해 보겠습니다.",
   "start": 208.622,
   "end": 212.215
  },
  {
   "n": 45,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "첫 단계는, 공항에 도착해서 가장 먼저 하는 일입니다.",
   "start": 212.595,
   "end": 215.824
  },
  {
   "n": 46,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "B씨는 늘 하던 대로 체크인 카운터로 가서, 면세품이 든 캐리어부터 맡기려고 합니다.",
   "start": 216.204,
   "end": 221.286
  },
  {
   "n": 47,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "그런데 세관 확인은 짐을 맡기기 전에 받아야 합니다.",
   "start": 221.666,
   "end": 224.796
  },
  {
   "n": 48,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "한 번 맡긴 짐은 다시 꺼낼 수 없습니다.",
   "start": 225.176,
   "end": 227.622
  },
  {
   "n": 49,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "그대로 맡기면 캐리어 속 면세품의 세금은, 한 푼도 돌려받지 못합니다.",
   "start": 228.002,
   "end": 232.479
  },
  {
   "n": 50,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "다행히 B씨는 맡기기 직전에 이걸 떠올리고, 면세 수속부터 하러 갑니다.",
   "start": 232.859,
   "end": 237.507
  },
  {
   "n": 51,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "A씨는 도착하자마자, 면세품을 모아 둔 가방 하나를 들고 면세 수속부터 합니다.",
   "start": 237.887,
   "end": 243.174
  },
  {
   "n": 52,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "그래서 네 번째는, 공항에 도착하면 체크인보다 먼저 면세 수속부터 하는 것입니다.",
   "start": 243.554,
   "end": 248.454
  },
  {
   "n": 53,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "면세품을 가방 하나에 모아 두면, 검사를 받게 돼도 그 가방만 열어 보여 주면 됩니다.",
   "start": 248.834,
   "end": 254.224
  },
  {
   "n": 54,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "두 번째 단계는 세관 확인입니다.",
   "start": 254.604,
   "end": 256.518
  },
  {
   "n": 55,
   "role": "host",
   "part": "여행을 마치고 공항에서 수속 준비",
   "text": "세관 확인은 단말기에 여권을 대거나 휴대전화로 수속하면, 화면에 결과가 뜨는 방식입니다.",
