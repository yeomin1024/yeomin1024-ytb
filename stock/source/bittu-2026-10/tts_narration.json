 "items": [
  {
   "n": 1,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "2026년 5월, SK하이닉스 주가가 한 달 만에 80% 넘게 올랐어요.",
   "start": 0.3,
   "end": 6.28
  },
  {
   "n": 2,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "이렇게 오르는 장에 제 돈 3천만 원만 넣기에는 너무 아깝더라고요.",
   "start": 6.73,
   "end": 12.39
  },
  {
   "n": 3,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "그래서 증권사에서 3천만 원을 빌려 6천만 원어치를 샀죠.",
   "start": 12.84,
   "end": 17.93
  },
  {
   "n": 4,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "산 주식을 담보로 증권사 돈을 빌리는 신용 거래였어요.",
   "start": 18.38,
   "end": 22.52
  },
  {
   "n": 5,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "6월 22일 주가가 290만 원을 넘으면서 수익이 1,500만 원이 됐어요.",
   "start": 22.97,
   "end": 29.91
  },
  {
   "n": 6,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "제 돈만 넣었다면 750만 원이었을 수익이 빚 덕분에 두 배가 된 거죠.",
   "start": 30.36,
   "end": 37.06
  },
  {
   "n": 7,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "하지만 빚은 수익만 두 배로 키우는 게 아니었습니다.",
   "start": 37.51,
   "end": 41.41
  },
  {
   "n": 8,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "7월 28일 저녁, 증권사에서 담보가 부족하다는 문자가 왔어요.",
   "start": 41.86,
   "end": 46.56
  },
  {
   "n": 9,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "추가로 넣을 돈은 없었어요.",
   "start": 47.01,
   "end": 49.14
  },
  {
   "n": 10,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "이틀 뒤 아침, 장이 열리자마자 제 주식이 전부 강제로 팔렸어요.",
   "start": 49.59,
   "end": 55.49
  },
  {
   "n": 11,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "빚을 갚고 남은 돈은 500만 원, -2,500만 원이었어요.",
   "start": 55.94,
   "end": 60.47
  },
  {
   "n": 12,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "7월 28일 하루에만 코스피가 10% 넘게, SK하이닉스는 15% 가까이 떨어졌더라고요.",
   "start": 60.92,
   "end": 68.82
  },
  {
   "n": 13,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "중국의 메모리 반도체 회사가 상장해 큰돈을 모았다는 소식에 AI 투자 걱정까지 겹쳤대요.",
   "start": 69.27,
   "end": 76.93
  },
  {
   "n": 14,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "그런데 강제로 팔린 바로 다음 날, 주가는 하루 만에 30% 가까이 올랐어요.",
   "start": 77.38,
   "end": 83.51
  },
  {
   "n": 15,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "수익을 두 배로 만들어 준 3천만 원의 빚이 제 돈까지 거의 다 가져가 버렸어요.",
   "start": 83.96,
   "end": 91.38
  },
  {
   "n": 16,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "빚만 없었어도 그 하루를 버틸 수 있었을 텐데요.",
   "start": 91.83,
   "end": 96.04
  },
  {
   "n": 17,
   "role": "host",
   "part": "진행자 파트",
   "text": "주가가 쭉쭉 오를 때면 많은 분들이 이런 생각을 하죠.",
   "start": 97.04,
   "end": 100.07
  },
  {
   "n": 18,
   "role": "host",
   "part": "진행자 파트",
   "text": "조금만 빌렸다가 오르면 바로 갚으면 되지.",
   "start": 100.52,
   "end": 102.91
  },
  {
   "n": 19,
   "role": "host",
   "part": "진행자 파트",
   "text": "내 돈만 넣기엔 이 상승장이 아까워.",
   "start": 103.36,
   "end": 105.75
  },
  {
   "n": 20,
   "role": "host",
   "part": "진행자 파트",
   "text": "설마 반대매매까지 가겠어?",
   "start": 106.2,
   "end": 107.93
  },
  {
   "n": 21,
   "role": "host",
   "part": "진행자 파트",
   "text": "이런 식으로 오르는 장에서는 빚의 무게가 잘 느껴지지 않습니다.",
   "start": 108.38,
   "end": 112.79
  },
  {
   "n": 22,
   "role": "host",
   "part": "진행자 파트",
   "text": "실제로 6월 24일, 신용융자 잔고는 38조 6천억 원으로 사상 최대였습니다.",
   "start": 113.24,
   "end": 119.22
  },
  {
   "n": 23,
   "role": "host",
   "part": "진행자 파트",
   "text": "개인 투자자가 증권사 돈을 빌려 산 주식이 그만큼 많았던 거죠.",
   "start": 119.67,
   "end": 123.96
  },
  {
   "n": 24,
   "role": "host",
   "part": "진행자 파트",
   "text": "6월 한 달 증권사 10곳에서 신용 반대매매로 팔린 주식은 3,935억 원어치였습니다.",
   "start": 124.41,
   "end": 130.76
  },
  {
   "n": 25,
   "role": "host",
   "part": "진행자 파트",
   "text": "1월보다 7배 가까이 늘어난 금액입니다.",
   "start": 131.21,
   "end": 133.89
  },
  {
   "n": 26,
   "role": "host",
   "part": "진행자 파트",
   "text": "빚투가 몇몇 사람만의 이야기가 아니라는 뜻입니다.",
   "start": 134.34,
   "end": 137.34
  },
  {
   "n": 27,
   "role": "host",
   "part": "진행자 파트",
   "text": "그럼 빚을 내서 하는 투자가 왜 위험한지 하나씩 짚어 보겠습니다.",
   "start": 137.79,
   "end": 141.86
  },
  {
   "n": 28,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "첫 번째 문제는 빚이 수익뿐 아니라 손실도 똑같이 키운다는 것입니다.",
   "start": 149.86,
   "end": 154.75
  },
  {
   "n": 29,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사연자의 주식이 팔린 날, 주가는 산 가격보다 42% 가까이 낮았습니다.",
   "start": 155.2,
   "end": 160.83
  },
  {
   "n": 30,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그런데 사연자의 돈 3천만 원은 83%가 사라졌죠.",
   "start": 161.28,
   "end": 165.29
  },
  {
   "n": 31,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "빌린 3천만 원은 주가와 상관없이 그대로 갚아야 하기 때문입니다.",
   "start": 165.74,
   "end": 170.45
  },
  {
   "n": 32,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "내 돈과 같은 금액을 빌렸다면, 주가가 절반만 떨어져도 내 돈은 하나도 남지 않습니다.",
   "start": 170.9,
   "end": 176.7
  },
  {
   "n": 33,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "두 번째는 반대매매가 가장 나쁜 때에 가장 나쁜 가격으로 판다는 것입니다.",
   "start": 177.15,
   "end": 181.98
  },
  {
   "n": 34,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "증권사는 보통 주식 가치가 빌려준 돈의 140% 이상이 되도록 요구합니다.",
   "start": 182.43,
   "end": 188.18
  },
  {
   "n": 35,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "이 선 아래로 떨어지면 정해진 날까지 돈을 더 넣으라고 하죠.",
   "start": 188.63,
   "end": 192.49
  },
  {
   "n": 36,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "넣지 못하면 장이 열리자마자 주식을 팔아 빌려준 돈을 거둬 갑니다.",
   "start": 192.94,
   "end": 197.15
  },
  {
   "n": 37,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "팔 수량은 전날 종가보다 15~30% 낮은 가격을 기준으로 정합니다.",
   "start": 197.6,
   "end": 202.25
  },
  {
   "n": 38,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그래서 모자란 돈보다 훨씬 많은 주식이 팔릴 수 있습니다.",
   "start": 202.7,
   "end": 206.18
  },
  {
   "n": 39,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "금융감독원이 소개한 사례에서는 모자란 담보가 201만 원이었습니다.",
   "start": 206.63,
   "end": 211.47
  },
  {
   "n": 40,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그런데 주식 405주, 3,090만 원어치가 전부 팔렸죠.",
   "start": 211.92,
   "end": 215.67
  },
  {
   "n": 41,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사연자처럼 다음 날 주가가 30% 가까이 올라도, 이미 팔린 주식은 돌아오지 않습니다.",
   "start": 216.12,
   "end": 222.55
  },
  {
   "n": 42,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "빚이 없었다면 기다릴지 말지를 스스로 정할 수 있었을 겁니다.",
   "start": 223.0,
   "end": 226.98
  },
  {
   "n": 43,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "세 번째는 이자가 주가와 상관없이 매일 쌓인다는 것입니다.",
   "start": 227.43,
   "end": 231.7
  },
  {
   "n": 44,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2026년 5월 증권사 10곳의 신용 이자는 90일이 넘으면 평균 연 9.38%였습니다.",
   "start": 232.15,
   "end": 238.69
  },
  {
   "n": 45,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "이 금리로 3천만 원을 1년 빌리면 이자만 280만 원이 넘습니다.",
   "start": 239.14,
   "end": 244.14
  },
  {
   "n": 46,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "빌린 돈으로 산 부분은 1년에 9% 넘게 오르지 않으면 오히려 손해인 셈이죠.",
   "start": 244.59,
   "end": 249.96
  },
  {
   "n": 47,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "네 번째는 실제로 빚을 낸 투자자가 하락장에서 훨씬 크게 잃었다는 것입니다.",
   "start": 250.41,
   "end": 255.76
  },
  {
   "n": 48,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "국내 대형 증권사 두 곳의 개인 계좌 460만 개를 분석한 결과가 있습니다.",
   "start": 256.21,
   "end": 261.84
  },
  {
   "n": 49,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2026년 3월 1일부터 9일까지 폭락장에서 신용을 쓴 계좌는 평균 19% 잃었습니다.",
   "start": 262.29,
   "end": 268.52
  },
  {
   "n": 50,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "신용을 쓰지 않은 계좌의 손실 8.2%보다 2.3배 컸죠.",
   "start": 268.97,
   "end": 273.71
  },
  {
   "n": 51,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "미국에서는 2010년 개인 외환 거래에 쓸 수 있는 빚의 한도를 줄인 적이 있습니다.",
   "start": 274.16,
   "end": 279.36
  },
  {
   "n": 52,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그 뒤 빚을 많이 쓰던 투자자들의 손실이 40% 줄었다는 연구가 나왔죠.",
   "start": 279.81,
   "end": 284.95
  },
  {
   "n": 53,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "물론 빚 덕분에 크게 번 사람도 있습니다.",
   "start": 285.4,
   "end": 288.19
  },
  {
   "n": 54,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사연자도 6월까지는 그랬죠.",
   "start": 288.64,
   "end": 290.82
  },
  {
   "n": 55,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "문제는 한 번의 폭락이 그동안 번 돈에 내 돈까지 한꺼번에 가져갈 수 있다는 겁니다.",
   "start": 291.27,
   "end": 296.85
  },
  {
   "n": 56,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그렇다면 빚을 내서 투자할 때는 어떤 기준을 지켜야 할까요?",
   "start": 297.3,
   "end": 300.72
  },
  {
   "n": 57,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "첫째, 빌리기 전에 반대매매가 되는 가격부터 계산하는 것입니다.",
   "start": 301.72,
   "end": 306.29
  },
  {
   "n": 58,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "내 돈만큼 빌렸다면, 주가가 30%만 떨어져도 담보가 140% 아래로 내려갑니다.",
   "start": 306.74,
   "end": 312.82
  },
  {
   "n": 59,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "사연자라면 233만 3천 원의 70%인 163만 3천 원이 그 가격입니다.",
   "start": 313.27,
   "end": 319.83
  },
  {
   "n": 60,
   "role": "host",
