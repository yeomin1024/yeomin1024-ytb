 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "김 씨는 국민연금을 당겨 받고, 평생 매달 27만 원씩 덜 받는다는 걸 알게 됐습니다.",
   "start": 0.3,
   "end": 6.22
  },
  {
   "n": 2,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "김 씨는 59세에 퇴직했는데, 연금은 64세부터였어요.",
   "start": 6.67,
   "end": 10.86
  },
  {
   "n": 3,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "5년 동안 월급도 연금도 없어서, 퇴직한 다음 달 바로 신청했죠.",
   "start": 11.31,
   "end": 15.37
  },
  {
   "n": 4,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "64세부터 받을 연금은 월 90만 원이었는데, 통장에는 63만 원이 들어왔습니다.",
   "start": 15.82,
   "end": 21.4
  },
  {
   "n": 5,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "그래도 64세가 되면, 원래대로 돌아올 줄 알았어요.",
   "start": 21.85,
   "end": 25.24
  },
  {
   "n": 6,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "그런데 1년쯤 지나, 동창 모임에서 친구가 물었습니다.",
   "start": 25.69,
   "end": 28.88
  },
  {
   "n": 7,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "너, 그거 평생 30% 깎이는 거 알고 신청했어?",
   "start": 29.33,
   "end": 32.65
  },
  {
   "n": 8,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "집에 와 계산기를 두드린 김 씨는, 84세까지 6,480만 원을 잃었다고 믿었습니다.",
   "start": 33.1,
   "end": 38.94
  },
  {
   "n": 9,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "신청서 한 장 때문에, 평생 손해를 봤다는 거예요.",
   "start": 39.39,
   "end": 42.63
  },
  {
   "n": 10,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "정말 그만큼 잃은 걸까요, 지금이라도 덜 깎이게 할 수 있을까요?",
   "start": 43.08,
   "end": 46.6
  },
  {
   "n": 11,
   "role": "host",
   "part": "신청서 한 장, 평생 27만 원",
   "text": "김 씨가 찾아낸 진짜 범인과 지금 할 일까지, 아래 영상에서 확인하세요.",
   "start": 47.05,
   "end": 51.05
