 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "일행과 함께 등산하다가, 몸 상태가 안 좋아진 경험 한 번쯤 있으시죠?",
   "start": 0.3,
   "end": 4.69
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "그럴 때 당신은 어떻게 하시나요?",
   "start": 5.07,
   "end": 6.73
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "만약 먼저 내려가겠다고 한다면, 당신은 사고를 당할 위험이 큽니다.",
   "start": 7.11,
   "end": 11.256
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "왜 그런지, 실제로 사망 사고가 있었던 한라산 사례로 알아보겠습니다.",
   "start": 11.636,
   "end": 16.308
  },
  {
   "n": 5,
   "role": "host",
   "part": "도입",
   "text": "그리고 등산 전에 조심해야 할 것도 같이 알아보겠습니다.",
   "start": 16.688,
   "end": 19.958
  },
  {
   "n": 6,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "2023년 3월 26일 일요일, 한라산 둘레길에서 있었던 일입니다.",
   "start": 20.958,
   "end": 25.964
  },
  {
   "n": 7,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "제주에 사는 54세 김 씨는, 일행과 함께 둘레길 산행에 나섰습니다.",
   "start": 26.344,
   "end": 30.754
  },
  {
   "n": 8,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "한라산 둘레길은 정상으로 오르는 길이 아니라, 해발 600에서 800미터 사이 숲길이죠.",
   "start": 31.134,
   "end": 36.443
  },
  {
   "n": 9,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "그래서 가벼운 산책쯤으로 여기는 분이 많습니다.",
   "start": 36.823,
   "end": 39.388
  },
  {
   "n": 10,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "그런데 걷던 중, 김 씨는 몸 상태가 좋지 않다고 느꼈습니다.",
   "start": 39.768,
   "end": 43.588
  },
  {
   "n": 11,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "그리고 일행에게 이렇게 말했죠.",
   "start": 43.968,
   "end": 45.64
  },
  {
   "n": 12,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "\"몸이 좋지 않아 먼저 내려가겠다.\"",
   "start": 46.02,
   "end": 48.13
  },
  {
   "n": 13,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "김 씨는 혼자 왔던 길을 돌아갔습니다.",
   "start": 48.51,
   "end": 50.839
  },
  {
   "n": 14,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "누구나 할 법한 결정입니다.",
   "start": 51.219,
   "end": 52.839
  },
  {
   "n": 15,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "일행도 괜찮다는 말을 믿을 수밖에 없죠.",
   "start": 53.219,
   "end": 55.489
  },
  {
   "n": 16,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "하지만 먼저 내려갔다던 김 씨는, 어디에서도 보이지 않았습니다.",
   "start": 55.869,
   "end": 59.907
  },
  {
   "n": 17,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "일행은 오후 1시 48분쯤, 119에 실종 신고를 했습니다.",
   "start": 60.287,
   "end": 64.427
  },
  {
   "n": 18,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "119 구조대가 주변을 수색했고, 1시간쯤 뒤에 쓰러진 김 씨를 찾았습니다.",
   "start": 64.807,
   "end": 69.38
  },
  {
   "n": 19,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "발견됐을 때, 김 씨는 이미 심장이 멈춘 심정지 상태였습니다.",
   "start": 69.76,
   "end": 73.604
  },
  {
   "n": 20,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "병원으로 옮겼지만, 김 씨는 오후 3시 28분쯤 숨졌습니다.",
   "start": 73.984,
   "end": 78.162
  },
  {
   "n": 21,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "신고하고 1시간 40분 뒤였죠.",
   "start": 78.542,
   "end": 80.702
  },
  {
   "n": 22,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "김 씨가 언제 쓰러졌는지는 아무도 모릅니다.",
   "start": 81.082,
   "end": 83.892
  },
  {
   "n": 23,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "쓰러지는 순간, 옆에 아무도 없었기 때문입니다.",
   "start": 84.272,
   "end": 87.262
  },
  {
   "n": 24,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "심장이 왜 멈췄는지, 정확한 원인도 알려지지 않았습니다.",
   "start": 87.642,
   "end": 91.482
  },
  {
   "n": 25,
   "role": "host",
   "part": "한라산 둘레길, 그날 있었던 일",
   "text": "그렇다면 이런 일은, 김 씨에게만 일어난 걸까요?",
   "start": 91.862,
   "end": 94.89
  },
  {
   "n": 26,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "김 씨뿐만이 아닙니다.",
   "start": 95.89,
   "end": 97.085
  },
  {
   "n": 27,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "숫자로 보면, 산에서 숨진 원인 가운데 등산 중 심정지가 얼마나 큰지 보입니다.",
   "start": 97.465,
   "end": 102.636
  },
  {
   "n": 28,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "국립공원공단이 지리산과 설악산, 북한산 같은 국립공원의 사망 사고를 살펴봤습니다.",
   "start": 103.016,
   "end": 108.64
  },
  {
   "n": 29,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "2014년부터 10년 동안 숨진 사람은 167명이었습니다.",
   "start": 109.02,
   "end": 113.063
  },
  {
   "n": 30,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "그 가운데 84명은, 심장이 갑자기 멈추는 심장 돌연사였죠.",
   "start": 113.443,
   "end": 117.623
  },
  {
   "n": 31,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "떨어져서 숨진 54명보다 30명이나 많습니다.",
   "start": 118.003,
   "end": 121.118
  },
  {
   "n": 32,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "국립공원에서 숨진 사람의 절반은, 낙사가 아닌 등산 중 심정지 때문이었습니다.",
   "start": 121.498,
   "end": 126.604
  },
  {
   "n": 33,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "한라산은 제주도가 따로 관리해서, 김 씨의 사고는 이 숫자에 들어 있지도 않습니다.",
   "start": 126.984,
   "end": 132.251
  },
  {
   "n": 34,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "그 뒤에도 비슷한 사고는 이어졌습니다.",
   "start": 132.631,
   "end": 134.851
  },
  {
   "n": 35,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "2025년 3월, 한라산 성판악 코스를 오르던 60대 관광객이 심정지로 쓰러져 숨졌죠.",
   "start": 135.231,
   "end": 141.272
  },
  {
   "n": 36,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "같은 해 10월에는 한라산 성판악에서, 하산하던 50대 관광객이 심정지로 숨졌습니다.",
   "start": 141.652,
   "end": 147.414
  },
  {
   "n": 37,
   "role": "host",
   "part": "숫자로 본 등산 중 심정지",
   "text": "그럼 도대체, 이런 사고가 많이 일어나는 이유는 뭘까요?",
   "start": 147.794,
   "end": 151.436
  },
  {
   "n": 38,
   "role": "host",
   "part": "등산 중 심장이 멈추는 이유",
   "text": "등산 중에 심장이 멈추는 데는 이유가 있습니다.",
   "start": 152.436,
   "end": 155.102
  },
  {
   "n": 39,
   "role": "host",
   "part": "등산 중 심장이 멈추는 이유",
   "text": "나이가 들수록, 심장에 피를 보내는 혈관은 조용히 좁아질 수 있습니다.",
   "start": 155.482,
   "end": 159.68
  },
  {
   "n": 40,
   "role": "host",
   "part": "등산 중 심장이 멈추는 이유",
   "text": "아무 증상이 없어서, 겉으로는 건강해 보이는 사람도 많죠.",
   "start": 160.06,
   "end": 163.894
  },
  {
   "n": 41,
   "role": "host",
   "part": "등산 중 심장이 멈추는 이유",
   "text": "고혈압과 당뇨, 높은 콜레스테롤, 담배는 이 혈관을 더 좁게 만듭니다.",
   "start": 164.274,
   "end": 169.293
  },
  {
   "n": 42,
   "role": "host",
   "part": "등산 중 심장이 멈추는 이유",
   "text": "이런 심장에는, 완만한 숲길을 오래 걷는 것도 부담이 됩니다.",
   "start": 169.673,
   "end": 173.433
  },
  {
   "n": 43,
   "role": "host",
   "part": "등산 중 심장이 멈추는 이유",
   "text": "산 중턱의 찬 공기는 혈관을 더 좁게 만들고요.",
   "start": 173.813,
   "end": 176.738
  },
  {
   "n": 44,
   "role": "host",
   "part": "등산 중 심장이 멈추는 이유",
   "text": "땀을 흘려 몸에서 물이 빠지면, 피는 더 끈끈해집니다.",
   "start": 177.118,
   "end": 180.628
  },
  {
   "n": 45,
   "role": "host",
   "part": "등산 중 심장이 멈추는 이유",
   "text": "그렇다면 심장이 멈추기 전에, 우리 몸은 아무 신호도 보내지 않을까요?",
   "start": 181.008,
   "end": 185.4
  },
  {
   "n": 46,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "심정지가 오기 전, 몸은 신호를 보내기도 합니다.",
   "start": 186.4,
   "end": 189.468
  },
  {
   "n": 47,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "가슴이 조이거나 답답해지고, 명치가 체한 것처럼 꽉 막힙니다.",
   "start": 189.848,
   "end": 193.758
  },
  {
   "n": 48,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "식은땀이 나거나, 숨이 평소보다 심하게 차기도 하죠.",
   "start": 194.138,
   "end": 197.44
  },
  {
   "n": 49,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "그 통증이 팔이나 턱, 등으로 번지기도 합니다.",
   "start": 197.82,
   "end": 200.72
  },
  {
   "n": 50,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "문제는 이 신호를, 조금 쉬면 괜찮아질 거라고 넘기기 쉽다는 겁니다.",
   "start": 201.1,
   "end": 205.608
  },
  {
   "n": 51,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "2016년 미국 오리건주의 연구팀이, 갑자기 심정지가 온 사람들을 살펴봤습니다.",
   "start": 205.988,
   "end": 211.255
  },
  {
   "n": 52,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "35세에서 65세 환자의 절반 정도는, 그 전 4주 안에 신호가 있었습니다.",
   "start": 211.635,
   "end": 216.823
  },
  {
   "n": 53,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "가장 많은 신호는 가슴 통증과 숨참이었죠.",
   "start": 217.203,
   "end": 220.05
  },
  {
   "n": 54,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "하지만 신호를 느끼고 구급차를 먼저 부른 사람은, 다섯 명 중 한 명도 안 됐습니다.",
   "start": 220.43,
   "end": 225.464
  },
  {
   "n": 55,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "김 씨가 느낀 것이 이런 신호였는지는 알 수 없습니다.",
   "start": 225.844,
   "end": 229.068
  },
  {
   "n": 56,
   "role": "host",
   "part": "심정지 전 몸이 보내는 신호",
   "text": "그런데 이런 신호가 왔을 때, 혼자 먼저 내려가는 건 왜 위험할까요?",
   "start": 229.448,
   "end": 233.685
  },
  {
   "n": 57,
   "role": "host",
   "part": "혼자 먼저 내려가면 위험한 이유",
   "text": "혼자 먼저 내려가면 위험한 이유는 두 가지입니다.",
   "start": 234.685,
   "end": 237.265
  },
  {
   "n": 58,
   "role": "host",
   "part": "혼자 먼저 내려가면 위험한 이유",
   "text": "첫 번째, 신호가 와도 멈추지 않고 계속 걷게 됩니다.",
   "start": 237.645,
   "end": 240.985
  },
  {
   "n": 59,
   "role": "host",
   "part": "혼자 먼저 내려가면 위험한 이유",
   "text": "걷는 동안에는 심장이 쉬지 못하죠.",
