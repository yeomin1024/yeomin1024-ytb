 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "분배금을 매달 주는 커버드콜 ETF는, 그 돈을 꺼내 써도 원금이 잘 안 깎인다고 하죠.",
   "start": 0.3,
   "end": 5.6
  },
  {
   "n": 2,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "정말 그런지, AI가 짠 파이썬 코드로 과거 실제 가격을 넣어 백테스트해 봤습니다.",
   "start": 6.05,
   "end": 11.49
  },
  {
   "n": 3,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "시험한 건 나스닥100 커버드콜 ETF인 QYLD예요.",
   "start": 11.94,
   "end": 15.61
  },
  {
   "n": 4,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "비교 상대는 커버드콜 없이 나스닥100을 그대로 따라가는 ETF, QQQ입니다.",
   "start": 16.06,
   "end": 21.98
  },
  {
   "n": 5,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "2013년 12월, 두 계좌에 원금 10만 달러씩 넣었어요.",
   "start": 22.43,
   "end": 26.75
  },
  {
   "n": 6,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "QYLD는 분배금이 나올 때마다 전부 꺼내 썼고요.",
   "start": 27.2,
   "end": 30.42
  },
  {
   "n": 7,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "공정하게 비교하려고, QQQ에서도 같은 날 같은 금액을 매도해서 꺼냈어요.",
   "start": 30.87,
   "end": 35.71
  },
  {
   "n": 8,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "2026년까지 두 계좌가 꺼낸 돈은, 똑같이 약 11만 달러였어요.",
   "start": 36.16,
   "end": 41.25
  },
  {
   "n": 9,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "QYLD 계좌에 남은 돈은 약 7만 5천 달러로, 원금보다 25.3% 적어요.",
   "start": 41.7,
   "end": 47.38
  },
  {
   "n": 10,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "QQQ 계좌에는 약 51만 달러, QYLD의 6.83배가 남았습니다.",
   "start": 47.83,
   "end": 52.81
  },
  {
   "n": 11,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "같은 돈을 꺼냈는데, 왜 이렇게 차이가 났을까요?",
   "start": 53.26,
   "end": 56.19
  },
  {
   "n": 12,
   "role": "host",
   "part": "커버드콜 vs QQQ",
   "text": "그 이유와, 다른 달에 시작해도 결과가 같은지는 아래 영상에서 확인하세요.",
   "start": 56.64,
   "end": 61.47
  }
 ],
