 },
 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "원금은 잘 안 깎인다는 나스닥100 커버드콜 ETF, QYLD.",
   "start": 0.3,
   "end": 4.69
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "분배금을 매달 꺼내 써도, 원금이 정말 지켜질까요?",
   "start": 5.14,
   "end": 8.4
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "나스닥100을 따라가는 ETF인 QQQ와, 백테스트로 비교해 보겠습니다.",
   "start": 8.85,
   "end": 13.3
  },
  {
   "n": 4,
   "role": "host",
   "part": "규칙",
   "text": "2013년 12월, 10만 달러씩 매수해요.",
   "start": 14.3,
   "end": 17.1
  },
  {
   "n": 5,
   "role": "host",
   "part": "규칙",
   "text": "QYLD는 분배금을 꺼내고, QQQ는 같은 금액을 매도해 꺼냅니다.",
   "start": 17.55,
   "end": 22.0
  },
  {
   "n": 6,
   "role": "host",
   "part": "규칙",
   "text": "수수료는 0.25%예요.",
   "start": 22.45,
   "end": 24.37
  },
  {
   "n": 7,
   "role": "host",
   "part": "경주",
   "text": "이제 날짜를 흘려 보겠습니다.",
   "start": 25.37,
   "end": 26.96
  },
  {
   "n": 8,
   "role": "host",
   "part": "경주",
   "text": "주황 선이 QYLD 계좌, 파란 선이 QQQ 계좌예요.",
   "start": 27.41,
   "end": 31.17
  },
  {
   "n": 9,
   "role": "host",
   "part": "경주",
   "text": "노란 점선은 처음 넣은 10만 달러, 원금입니다.",
   "start": 31.62,
   "end": 34.64
  },
  {
   "n": 10,
   "role": "host",
   "part": "경주",
   "text": "가운데 위 숫자는 두 계좌가 똑같이 꺼낸 돈이에요.",
   "start": 35.09,
   "end": 38.13
  },
  {
   "n": 11,
   "role": "host",
   "part": "경주",
   "text": "QQQ의 작은 배당은 다시 매수하고, 세금은 계산에 넣지 않았어요.",
   "start": 38.58,
   "end": 42.82
  },
  {
   "n": 12,
   "role": "host",
   "part": "경주",
   "text": "첫 분배금은 2014년 1월, 1,024달러였어요.",
   "start": 43.27,
   "end": 47.07
  },
  {
   "n": 13,
   "role": "host",
   "part": "경주",
   "text": "2014년 3월엔 QYLD 계좌가 원금보다 3.4% 많아, 원금이 지켜지는 듯했어요.",
   "start": 47.52,
   "end": 53.68
  },
  {
   "n": 14,
   "role": "host",
   "part": "경주",
   "text": "하지만 2016년 2월에는 원금보다 17.5% 적어졌습니다.",
   "start": 54.13,
   "end": 58.42
  },
  {
   "n": 15,
   "role": "host",
   "part": "경주",
   "text": "QQQ 계좌도 다음 날 잠깐 원금 아래로 내려가, 둘 다 손해였어요.",
   "start": 58.87,
   "end": 63.05
  },
  {
   "n": 16,
   "role": "host",
   "part": "경주",
   "text": "2018년 3월 15일, QYLD 계좌는 원금보다 0.9% 많아 다시 원금 위였어요.",
   "start": 63.5,
   "end": 69.94
  },
  {
   "n": 17,
   "role": "host",
   "part": "경주",
   "text": "그런데 12월 24일까지 QYLD는 21%, QQQ는 19.8% 줄어 비슷했어요.",
   "start": 70.39,
   "end": 77.01
  },
  {
   "n": 18,
   "role": "host",
   "part": "경주",
   "text": "2019년 11월, 두 계좌가 꺼낸 돈이 5만 달러를 넘었어요.",
   "start": 77.46,
   "end": 81.83
  },
  {
   "n": 19,
   "role": "host",
   "part": "경주",
   "text": "코로나 폭락이 온 2020년 3월 16일, QYLD 계좌는 원금보다 28.3% 적었어요.",
   "start": 82.28,
   "end": 89.08
  },
  {
   "n": 20,
   "role": "host",
   "part": "경주",
   "text": "같은 날 QQQ 계좌는 원금보다 41.1% 많았고요.",
   "start": 89.53,
   "end": 94.09
  },
  {
   "n": 21,
   "role": "host",
   "part": "긴 하락",
   "text": "2021년 11월 19일, QQQ 값이 그때까지 가장 높았던 날입니다.",
   "start": 95.09,
   "end": 99.81
  },
  {
   "n": 22,
   "role": "host",
   "part": "긴 하락",
   "text": "이날 QYLD 계좌는 원금보다 8.2% 적었고, QQQ 계좌는 원금의 3.16배였어요.",
   "start": 100.26,
   "end": 107.5
  },
  {
   "n": 23,
   "role": "host",
   "part": "긴 하락",
   "text": "흰 점선이 이날의 두 계좌 값입니다.",
   "start": 107.95,
   "end": 110.1
  },
  {
   "n": 24,
   "role": "host",
   "part": "긴 하락",
   "text": "그리고 2022년, 긴 하락이 시작됐어요.",
   "start": 110.55,
   "end": 113.31
  },
  {
   "n": 25,
   "role": "host",
   "part": "긴 하락",
   "text": "QYLD 계좌는 10월 14일까지, 11월 19일보다 33.2% 줄었어요.",
   "start": 113.76,
   "end": 119.6
  },
  {
   "n": 26,
   "role": "host",
   "part": "긴 하락",
   "text": "QQQ 계좌는 12월 28일까지 37.8% 줄어, 조금 더 크게 떨어졌어요.",
   "start": 120.05,
   "end": 126.32
  },
  {
   "n": 27,
   "role": "host",
   "part": "긴 하락",
   "text": "이렇게 떨어지는 동안에도 두 계좌는 같은 돈, 8,720달러를 꺼냈습니다.",
   "start": 126.77,
   "end": 131.55
  },
  {
   "n": 28,
   "role": "host",
   "part": "긴 하락",
   "text": "회복은 어땠을까요?",
   "start": 132.0,
   "end": 133.14
  },
  {
   "n": 29,
   "role": "host",
   "part": "긴 하락",
   "text": "QQQ 계좌는 2024년 2월 7일, 810일 만에 11월 19일 값을 다시 넘었어요.",
   "start": 133.59,
   "end": 139.52
  },
  {
   "n": 30,
   "role": "host",
   "part": "끝까지",
   "text": "2025년 3월, 꺼낸 돈이 처음 넣은 원금 10만 달러를 넘었어요.",
   "start": 140.52,
   "end": 145.31
  },
  {
   "n": 31,
   "role": "host",
   "part": "끝까지",
   "text": "4월 8일 급락 때, QYLD 계좌는 원금보다 40.4% 적었어요.",
   "start": 145.76,
   "end": 150.88
  },
  {
   "n": 32,
   "role": "host",
   "part": "끝까지",
   "text": "같은 날 QQQ 계좌는 원금의 2.98배였고요.",
   "start": 151.33,
   "end": 155.16
  },
  {
   "n": 33,
   "role": "host",
   "part": "결과",
   "text": "2026년 10월 15일, 결과입니다.",
   "start": 156.16,
   "end": 158.88
  },
  {
   "n": 34,
   "role": "host",
   "part": "결과",
   "text": "두 계좌가 꺼낸 돈은 똑같이 148번, 약 11만 달러였어요.",
   "start": 159.33,
   "end": 163.41
  },
  {
   "n": 35,
   "role": "host",
   "part": "결과",
   "text": "QYLD 계좌에 남은 돈은 약 7만 5천 달러로, 원금보다 25.3% 적어요.",
   "start": 163.86,
   "end": 169.54
  },
  {
   "n": 36,
   "role": "host",
   "part": "결과",
   "text": "2021년 11월 19일 값도, 끝까지 다시 넘지 못했고요.",
   "start": 169.99,
   "end": 174.07
  },
  {
   "n": 37,
   "role": "host",
   "part": "결과",
   "text": "QQQ 계좌에 남은 돈은 약 51만 달러로, 같은 돈을 꺼냈는데 6.83배 많았어요.",
   "start": 174.52,
   "end": 180.33
  },
  {
   "n": 38,
   "role": "host",
   "part": "결과",
   "text": "QYLD 1주 값도 25.04달러에서 18.74달러로 떨어졌습니다.",
   "start": 180.78,
   "end": 186.21
  },
  {
   "n": 39,
   "role": "host",
   "part": "결과",
   "text": "전체 거래일의 94.7%는 QYLD 계좌가 원금 아래였어요.",
   "start": 186.66,
   "end": 191.06
  },
  {
   "n": 40,
   "role": "host",
   "part": "구조",
   "text": "왜 이렇게 차이가 났을까요?",
   "start": 192.06,
   "end": 194.34
  },
  {
   "n": 41,
   "role": "host",
   "part": "구조",
   "text": "커버드콜이 분배금을 어떻게 만드는지 보겠습니다.",
   "start": 194.79,
   "end": 197.6
  },
  {
   "n": 42,
   "role": "host",
   "part": "구조",
   "text": "커버드콜 ETF는 주식을 들고, 그 주식을 정해진 값에 매수할 권리를 매도해요.",
   "start": 198.05,
   "end": 202.93
  },
  {
   "n": 43,
   "role": "host",
   "part": "구조",
   "text": "권리를 매도한 값이 매달 들어오고, 이게 분배금의 재료가 돼요.",
   "start": 203.38,
   "end": 207.21
  },
  {
   "n": 44,
   "role": "host",
   "part": "구조",
   "text": "대신 주가가 정해진 값보다 오르면, 그 위의 몫은 권리를 매수한 사람이 가져갑니다.",
   "start": 207.66,
   "end": 212.82
  },
  {
   "n": 45,
   "role": "host",
   "part": "구조",
   "text": "떨어질 때는 받은 값만큼만 덜 떨어지고, 거의 같이 떨어지고요.",
   "start": 213.27,
   "end": 217.19
  },
  {
   "n": 46,
   "role": "host",
   "part": "구조",
   "text": "실제로 그런지, 하루 움직임으로 확인해 봤어요.",
   "start": 217.64,
   "end": 220.43
  },
  {
   "n": 47,
   "role": "host",
   "part": "구조",
   "text": "QQQ가 하루에 1% 넘게 오른 날은 595일이었습니다.",
   "start": 220.88,
   "end": 224.8
  },
  {
   "n": 48,
   "role": "host",
   "part": "구조",
   "text": "그날 QQQ는 평균 1.84% 올랐는데, QYLD는 0.95%로 51.3%만 따라갔어요.",
   "start": 225.25,
   "end": 233.01
  },
  {
   "n": 49,
   "role": "host",
   "part": "구조",
   "text": "QQQ가 하루에 1% 넘게 떨어진 날은 498일이었고요.",
   "start": 233.46,
   "end": 237.46
  },
  {
   "n": 50,
   "role": "host",
   "part": "구조",
   "text": "그날 QQQ는 평균 2.04%, QYLD는 1.28% 떨어져, 62.7%나 따라갔어요.",
   "start": 237.91,
   "end": 245.35
  },
  {
   "n": 51,
   "role": "host",
   "part": "시작 시점",
   "text": "시작한 날이 나빴던 건 아닐까요?",
   "start": 246.35,
   "end": 248.39
  },
  {
   "n": 52,
   "role": "host",
   "part": "시작 시점",
   "text": "2014년 1월부터 2021년 10월까지, 매달 새로 시작한 계좌를 만들었어요.",
   "start": 248.84,
   "end": 254.2
  },
  {
   "n": 53,
   "role": "host",
   "part": "시작 시점",
   "text": "매달 첫 거래일에 시작한 계좌, 모두 94개입니다.",
   "start": 254.65,
   "end": 257.85
  },
  {
   "n": 54,
   "role": "host",
   "part": "시작 시점",
   "text": "각 계좌는 5년 동안 같은 규칙으로 꺼내 씁니다.",
   "start": 258.3,
   "end": 261.02
  },
  {
   "n": 55,
   "role": "host",
   "part": "시작 시점",
   "text": "5년 뒤 QYLD 계좌가 원금 아래였던 건 94개 중 83개였어요.",
   "start": 261.47,
   "end": 266.03
  },
  {
   "n": 56,
   "role": "host",
   "part": "시작 시점",
   "text": "QQQ 계좌는 원금 아래가 하나도 없었습니다.",
   "start": 266.48,
   "end": 269.31
  },
  {
   "n": 57,
   "role": "host",
   "part": "시작 시점",
   "text": "94개 모두 QQQ 계좌가 더 많이 남았어요.",
   "start": 269.76,
   "end": 272.69
  },
  {
   "n": 58,
   "role": "host",
   "part": "시작 시점",
   "text": "가운데 값은 QYLD가 원금보다 18.7% 적었고, QQQ는 원금의 1.49배였어요.",
   "start": 273.14,
   "end": 279.54
  },
  {
   "n": 59,
   "role": "host",
   "part": "시작 시점",
   "text": "가장 나빴던 건 2018년 1월에 시작한 QYLD 계좌로, 원금보다 35.9% 적었어요.",
   "start": 279.99,
   "end": 286.49
  },
  {
   "n": 60,
   "role": "host",
   "part": "시작 시점",
   "text": "기간을 3년으로 줄이면, 2022년 하락에 걸린 계좌가 많아집니다.",
   "start": 286.94,
   "end": 290.85
  },
  {
   "n": 61,
   "role": "host",
   "part": "시작 시점",
   "text": "이때는 QQQ 계좌도 118개 중 19개가 원금 아래였어요.",
   "start": 291.3,
   "end": 295.14
  },
  {
   "n": 62,
   "role": "host",
   "part": "시작 시점",
   "text": "QYLD 계좌는 81개가 원금 아래였고요.",
   "start": 295.59,
   "end": 298.75
  },
  {
   "n": 63,
   "role": "host",
   "part": "시작 시점",
   "text": "그래도 118개 모두 QQQ 계좌가 더 많이 남았습니다.",
   "start": 299.2,
   "end": 302.55
  },
  {
   "n": 64,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "다른 커버드콜 ETF도 같을까요?",
   "start": 303.55,
   "end": 305.83
  },
  {
   "n": 65,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "QYLD가 따르는 나스닥100은 크게 오르내리는 편이에요.",
   "start": 306.28,
   "end": 310.11
  },
  {
   "n": 66,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "그래서 덜 흔들리는 S&P 500 커버드콜 ETF, XYLD도 봤어요.",
   "start": 310.56,
   "end": 315.65
  },
  {
   "n": 67,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "비교 상대는 S&P 500을 따라가는 ETF인 SPY예요.",
   "start": 316.1,
   "end": 319.86
  },
  {
   "n": 68,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "2013년 6월부터 13.3년 동안, 꺼낸 돈은 약 11만 달러입니다.",
   "start": 320.31,
   "end": 325.43
  },
  {
   "n": 69,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "XYLD 계좌는 원금보다 5.4% 늘었지만, SPY 계좌는 원금의 3.33배가 됐어요.",
   "start": 325.88,
   "end": 333.33
  },
  {
   "n": 70,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "시작 달을 바꾼 5년 계좌 100개에서도, 모두 SPY 쪽이 더 많았어요.",
   "start": 333.78,
   "end": 338.38
  },
  {
   "n": 71,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "XYLD는 100개 중 60개가 원금 아래였고요.",
   "start": 338.83,
   "end": 342.1
  },
  {
   "n": 72,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "JEPI는 방식이 조금 다른 커버드콜 ETF예요.",
   "start": 342.55,
   "end": 345.84
  },
  {
   "n": 73,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "주식에, 권리를 매도한 것과 같은 효과를 내는 증권을 섞었어요.",
   "start": 346.29,
   "end": 350.22
  },
  {
   "n": 74,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "2020년 5월부터 6.4년 동안, 꺼낸 돈은 약 6만 1천 달러였습니다.",
   "start": 350.67,
   "end": 356.18
  },
  {
   "n": 75,
   "role": "host",
   "part": "다른 커버드콜",
   "text": "JEPI 계좌는 원금보다 14.2% 늘었지만, SPY 계좌는 원금의 1.79배였어요.",
   "start": 356.63,
   "end": 363.32
  },
  {
   "n": 76,
   "role": "host",
   "part": "다른 조건",
   "text": "지금까지는 세금을 넣지 않았는데, 넣으면 어떨까요?",
   "start": 364.32,
   "end": 367.8
  },
  {
   "n": 77,
   "role": "host",
   "part": "다른 조건",
   "text": "미국 ETF 분배금은, 받을 때 15%를 미리 떼는 나라가 많아요.",
   "start": 368.25,
   "end": 372.73
  },
  {
   "n": 78,
   "role": "host",
   "part": "다른 조건",
   "text": "15%를 떼면, QYLD에서 손에 쥔 돈은 약 9만 6천 달러로 줄어듭니다.",
   "start": 373.18,
   "end": 378.62
  },
  {
   "n": 79,
   "role": "host",
   "part": "다른 조건",
   "text": "QQQ 계좌도 그만큼만 매도하니, 약 56만 달러가 남았어요.",
   "start": 379.07,
   "end": 383.33
  },
  {
   "n": 80,
   "role": "host",
   "part": "다른 조건",
   "text": "QYLD 계좌는 주식 수가 같아서, 그대로 약 7만 5천 달러고요.",
   "start": 383.78,
   "end": 388.18
  },
  {
   "n": 81,
   "role": "host",
   "part": "다른 조건",
   "text": "생활비가 따로 있어, 분배금을 다시 매수하는 분도 있죠.",
   "start": 388.63,
   "end": 392.24
  },
  {
   "n": 82,
   "role": "host",
   "part": "다른 조건",
   "text": "그렇게 했다면, QYLD는 약 29만 달러, QQQ는 약 95만 달러였어요.",
   "start": 392.69,
   "end": 398.21
  },
  {
   "n": 83,
   "role": "host",
   "part": "다른 조건",
   "text": "다시 매수해도 QQQ 쪽이 3.25배였습니다.",
   "start": 398.66,
   "end": 402.09
  },
  {
   "n": 84,
   "role": "host",
   "part": "정리",
   "text": "정리하겠습니다.",
   "start": 403.09,
   "end": 404.21
  },
  {
   "n": 85,
   "role": "host",
   "part": "정리",
   "text": "분배금을 매달 꺼내 쓴 QYLD 계좌는, 12.8년 뒤 원금이 25.3% 줄었어요.",
   "start": 404.66,
   "end": 410.74
  },
  {
   "n": 86,
   "role": "host",
   "part": "정리",
   "text": "같은 돈을 매도해서 꺼낸 QQQ 계좌는, 원금의 5.1배가 남았습니다.",
   "start": 411.19,
   "end": 415.75
  },
  {
   "n": 87,
   "role": "host",
   "part": "정리",
   "text": "시작 달을 바꾼 계좌에서도, 모두 QQQ 쪽이 더 많이 남았어요.",
   "start": 416.2,
   "end": 420.24
  },
  {
   "n": 88,
   "role": "host",
   "part": "정리",
   "text": "XYLD와 JEPI는 원금이 줄지 않았지만, 같은 돈을 꺼낸 SPY 계좌보다 적었습니다.",
   "start": 420.69,
   "end": 426.96
  },
  {
   "n": 89,
   "role": "host",
   "part": "정리",
   "text": "오를 때는 덜 오르고, 떨어질 때는 많이 따라 떨어진 차이가 쌓인 거예요.",
   "start": 427.41,
   "end": 431.49
  },
  {
   "n": 90,
   "role": "host",
   "part": "한계",
   "text": "이 기간 나스닥100과 S&P 500은 크게 올랐습니다.",
   "start": 432.49,
   "end": 436.15
  },
  {
   "n": 91,
   "role": "host",
   "part": "한계",
   "text": "주가가 오래 제자리였던 기간이라면, 결과가 다를 수 있어요.",
   "start": 436.6,
   "end": 440.36
  },
  {
   "n": 92,
   "role": "host",
   "part": "한계",
   "text": "분배금은 지급일이 아니라, 배당락일에 꺼낸 것으로 계산했습니다.",
   "start": 440.81,
   "end": 444.49
  },
  {
   "n": 93,
   "role": "host",
   "part": "한계",
   "text": "꺼낸 금액은 QYLD 분배금에 맞춘 것이라, 실제 생활비 계획과는 다를 수 있어요.",
   "start": 444.94,
   "end": 450.3
  },
  {
   "n": 94,
   "role": "host",
   "part": "한계",
   "text": "계좌 종류에 따른 세금과 건강보험료, 물가와 환율도 넣지 않았어요.",
   "start": 450.75,
   "end": 455.63
  },
  {
   "n": 95,
   "role": "host",
   "part": "한계",
   "text": "그리고 QQQ 쪽은 2022년처럼 37.8% 줄어드는 때를 견뎌야 했습니다.",
   "start": 456.08,
   "end": 461.6
  },
  {
   "n": 96,
   "role": "host",
   "part": "한계",
   "text": "투자 권유가 아니라, 규칙을 코드로 확인해 본 결과입니다.",
   "start": 462.05,
   "end": 465.34
  },
  {
   "n": 97,
   "role": "host",
   "part": "마무리",
   "text": "다음에 백테스트로 확인해 볼 가설이 있다면 댓글로 알려 주세요.",
   "start": 466.34,
   "end": 470.11
  },
  {
   "n": 98,
   "role": "host",
   "part": "마무리",
   "text": "시청해주셔서 감사합니다.",
   "start": 470.56,
   "end": 472.11
  }
