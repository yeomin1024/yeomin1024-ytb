 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "지난 9월 15일, 도쿄 이케부쿠로의 한 쓰레기 집적소 앞.",
   "start": 0.3,
   "end": 3.945
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "주인 없는 캐리어 하나가 놓여 있었습니다.",
   "start": 4.325,
   "end": 6.49
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "구청은 경고 스티커를 붙이고 주인을 기다렸습니다.",
   "start": 6.87,
   "end": 9.79
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "하지만 일주일이 지나도 주인은 나타나지 않았고, 캐리어는 결국 대형 쓰레기로 수거됐습니다.",
   "start": 10.17,
   "end": 15.493
  },
  {
   "n": 5,
   "role": "host",
   "part": "도입",
   "text": "이케부쿠로가 있는 곳은 도쿄 도시마구입니다.",
   "start": 15.873,
   "end": 18.623
  },
  {
   "n": 6,
   "role": "host",
   "part": "도입",
   "text": "이곳에서만 지난해 이렇게 버려진 캐리어가 약 290개 나왔습니다.",
   "start": 19.003,
   "end": 23.334
  },
  {
   "n": 7,
   "role": "host",
   "part": "도입",
   "text": "도쿄 경찰에 습득물로 들어온 캐리어도 지난해 약 4,600개였습니다.",
   "start": 23.714,
   "end": 27.961
  },
  {
   "n": 8,
   "role": "host",
   "part": "도입",
   "text": "3년 전의 1.8배예요.",
   "start": 28.341,
   "end": 29.941
  },
  {
   "n": 9,
   "role": "host",
   "part": "도입",
   "text": "잃어버린 가방도 섞인 숫자지만, 약 70%는 끝내 주인이 찾아가지 않았습니다.",
   "start": 30.321,
   "end": 35.322
  },
  {
   "n": 10,
   "role": "host",
   "part": "도입",
   "text": "깨끗하기로 유명한 일본에서, 왜 이런 일이 벌어지는 걸까요?",
   "start": 35.702,
   "end": 39.63
  },
  {
   "n": 11,
   "role": "host",
   "part": "도입",
   "text": "그냥 쓰레기로 버리면 되는 것 아닐까요?",
   "start": 40.01,
   "end": 42.551
  },
  {
   "n": 12,
   "role": "host",
   "part": "도입",
   "text": "결론부터 말하면, 구청의 대형 쓰레기 제도는 주민을 위한 것입니다.",
   "start": 42.931,
   "end": 47.25
  },
  {
   "n": 13,
   "role": "host",
   "part": "도입",
   "text": "그래서 여행자는 버릴 곳을 따로 찾아야 하죠.",
   "start": 47.63,
   "end": 50.06
  },
  {
   "n": 14,
   "role": "host",
   "part": "도입",
   "text": "왜 그런지 네 가지 이유로 알아보겠습니다.",
   "start": 50.44,
   "end": 52.86
  },
  {
   "n": 15,
   "role": "host",
   "part": "첫째, 일본에서 새로 산 캐리어",
   "text": "첫 번째 이유는 여행객이 일본에서 캐리어를 새로 사기 때문입니다.",
   "start": 53.86,
   "end": 57.6
  },
  {
   "n": 16,
   "role": "host",
   "part": "첫째, 일본에서 새로 산 캐리어",
   "text": "도시마구는 엔화 약세로 싸고 튼튼한 일본산 캐리어를 사는 여행객이 늘었다고 봅니다.",
   "start": 57.98,
   "end": 63.118
  },
  {
   "n": 17,
   "role": "host",
   "part": "첫째, 일본에서 새로 산 캐리어",
   "text": "기념품 때문에 더 큰 가방으로 바꾸는 경우도 있을 것으로 보고 있고요.",
   "start": 63.498,
   "end": 67.506
  },
  {
   "n": 18,
   "role": "host",
   "part": "첫째, 일본에서 새로 산 캐리어",
   "text": "그러면 원래 가져온 가방이 남게 되죠.",
   "start": 67.886,
   "end": 70.06
  },
  {
   "n": 19,
   "role": "host",
   "part": "첫째, 일본에서 새로 산 캐리어",
   "text": "공항에서도 주인 없는 캐리어가 늘고 있습니다.",
   "start": 70.44,
   "end": 73.016
  },
  {
   "n": 20,
   "role": "host",
   "part": "첫째, 일본에서 새로 산 캐리어",
   "text": "나리타공항에서 나온 캐리어는 지난해 1,200개가 넘었습니다.",
   "start": 73.396,
   "end": 77.124
  },
  {
   "n": 21,
   "role": "host",
   "part": "첫째, 일본에서 새로 산 캐리어",
   "text": "도쿄신문은 이 가운데 약 90%가 주인을 찾지 못하고 폐기된다고 전했습니다.",
   "start": 77.504,
   "end": 82.714
  },
  {
   "n": 22,
   "role": "host",
   "part": "첫째, 일본에서 새로 산 캐리어",
   "text": "그렇다면 남은 가방은 왜 제대로 버리지 못하는 걸까요?",
   "start": 83.094,
   "end": 86.332
  },
  {
   "n": 23,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "두 번째 이유는 일본의 대형 쓰레기 제도입니다.",
   "start": 87.332,
   "end": 90.167
  },
  {
   "n": 24,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "도쿄의 구들은 보통 한 변이 30센티미터를 넘는 물건을 대형 쓰레기로 분류합니다.",
   "start": 90.547,
   "end": 95.547
  },
  {
   "n": 25,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "캐리어도 여기에 들어가죠.",
   "start": 95.927,
   "end": 97.367
  },
  {
   "n": 26,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "대형 쓰레기를 버리려면 미리 수거 신청을 하고, 처리권 스티커를 사서 붙여야 합니다.",
   "start": 97.747,
   "end": 102.837
  },
  {
   "n": 27,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "신주쿠구의 경우 캐리어 한 개에 400엔이에요.",
   "start": 103.217,
   "end": 105.907
  },
  {
   "n": 28,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "비싸지 않아 보이지만, 결정적인 조건이 있습니다.",
   "start": 106.287,
   "end": 109.308
  },
  {
   "n": 29,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "이 제도는 그 구에 사는 주민을 위한 제도라는 겁니다.",
   "start": 109.688,
   "end": 112.892
  },
  {
   "n": 30,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "구 담당자도 일본 언론에 외국인 여행자를 위한 제도는 생각하지 않았다고 말했습니다.",
   "start": 113.272,
   "end": 118.562
  },
  {
   "n": 31,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "그래서 여행자는 민간 수거 업체나 공항 서비스 같은 다른 방법을 따로 찾아야 합니다.",
   "start": 118.942,
   "end": 124.329
  },
  {
   "n": 32,
   "role": "host",
   "part": "둘째, 대형 쓰레기는 주민 전용",
   "text": "그럼 묵었던 호텔에 두고 가면 어떨까요?",
   "start": 124.709,
   "end": 127.204
  },
  {
   "n": 33,
   "role": "host",
   "part": "셋째, 호텔도 돈이 든다",
   "text": "세 번째 이유는 호텔도 곤란하다는 점입니다.",
   "start": 128.204,
   "end": 130.894
  },
  {
   "n": 34,
   "role": "host",
   "part": "셋째, 호텔도 돈이 든다",
   "text": "손님이 두고 간 물건은 사업장 쓰레기로 분류됩니다.",
   "start": 131.274,
   "end": 134.364
  },
  {
   "n": 35,
   "role": "host",
   "part": "셋째, 호텔도 돈이 든다",
   "text": "그래서 호텔이 허가받은 업체에 돈을 내고 처리해야 합니다.",
   "start": 134.744,
   "end": 137.807
  },
  {
   "n": 36,
   "role": "host",
   "part": "셋째, 호텔도 돈이 든다",
   "text": "오사카의 한 호텔에는 한 해 200개 넘는 캐리어가 버려집니다.",
   "start": 138.187,
   "end": 141.865
  },
  {
   "n": 37,
   "role": "host",
   "part": "셋째, 호텔도 돈이 든다",
   "text": "처리비로만 1년에 15만 엔이 든다고 했습니다.",
   "start": 142.245,
   "end": 144.825
  },
  {
   "n": 38,
   "role": "host",
   "part": "셋째, 호텔도 돈이 든다",
   "text": "삿포로의 한 호텔 지배인도 보관할 공간이 없고 처리비가 꽤 든다고 말했습니다.",
   "start": 145.205,
   "end": 150.025
  },
  {
   "n": 39,
   "role": "host",
   "part": "셋째, 호텔도 돈이 든다",
   "text": "호텔 입장에서도 비용 부담인 겁니다.",
   "start": 150.405,
   "end": 152.609
  },
  {
   "n": 40,
   "role": "host",
   "part": "넷째, 쓰레기통 없는 나라",
   "text": "네 번째 이유는 일본 길거리에 쓰레기통이 드물다는 점입니다.",
   "start": 153.609,
   "end": 157.126
  },
  {
   "n": 41,
   "role": "host",
   "part": "넷째, 쓰레기통 없는 나라",
   "text": "일본 관광청 조사에서도 외국인 관광객이 꼽은 불편 1위가 '쓰레기통 부족'이었습니다.",
   "start": 157.506,
   "end": 163.046
  },
  {
   "n": 42,
   "role": "host",
   "part": "넷째, 쓰레기통 없는 나라",
   "text": "작은 쓰레기도 버릴 곳이 마땅치 않은데, 캐리어처럼 큰 물건은 더 어렵습니다.",
   "start": 163.426,
   "end": 168.376
  },
  {
   "n": 43,
   "role": "host",
   "part": "다른 목소리",
   "text": "그렇다면 버릴 곳을 찾기 어려우니, 길에 두고 가도 괜찮은 걸까요?",
   "start": 169.376,
   "end": 173.426
  },
  {
   "n": 44,
   "role": "host",
   "part": "다른 목소리",
   "text": "현지에서는 전혀 다른 이야기가 나옵니다.",
   "start": 173.806,
   "end": 176.116
  },
  {
   "n": 45,
   "role": "host",
   "part": "현지 반응",
   "text": "현지 주민들의 반응부터 보겠습니다.",
   "start": 177.116,
   "end": 179.056
  },
  {
   "n": 46,
   "role": "host",
   "part": "현지 반응",
   "text": "\"화가 납니다\", \"몇 년 사이 50개 넘게 봤다\"는 말이 나왔습니다.",
   "start": 179.436,
   "end": 183.056
  },
  {
   "n": 47,
   "role": "host",
   "part": "현지 반응",
   "text": "\"내용물을 몰라 무섭다\", \"폭발물인 줄 알았다\"는 반응도 있었습니다.",
   "start": 183.436,
   "end": 187.656
  },
  {
   "n": 48,
   "role": "host",
   "part": "현지 반응",
   "text": "실제로 주인 없는 가방은 유실물로 일정 기간 보관해야 하거든요.",
   "start": 188.036,
   "end": 191.749
  },
  {
   "n": 49,
   "role": "host",
   "part": "현지 반응",
   "text": "주부공항은 위험물인지 확인하려고 그때마다 X선 검사를 한다고 밝혔습니다.",
   "start": 192.129,
   "end": 197.051
  },
  {
   "n": 50,
   "role": "host",
   "part": "현지 반응",
   "text": "도시마구에선 이렇게 버려진 캐리어를 구청이 세금으로 수거하고 있습니다.",
   "start": 197.431,
   "end": 201.409
  },
  {
   "n": 51,
   "role": "host",
   "part": "현지 반응",
   "text": "게다가 길에 버리는 건 엄연한 불법입니다.",
   "start": 201.789,
   "end": 204.279
  },
  {
   "n": 52,
   "role": "host",
   "part": "현지 반응",
   "text": "일본 폐기물처리법은 쓰레기 무단 투기를 금지합니다.",
   "start": 204.659,
   "end": 208.022
  },
  {
   "n": 53,
   "role": "host",
   "part": "현지 반응",
   "text": "어기면 5년 이하 구금형이나 1,000만 엔 이하 벌금, 또는 둘 다 받을 수 있습니다.",
   "start": 208.402,
   "end": 213.412
  },
  {
   "n": 54,
   "role": "host",
   "part": "현지 반응",
   "text": "다만 이 문제를 외국인 관광객만의 탓으로 단정할 수는 없습니다.",
   "start": 213.792,
   "end": 217.697
  },
  {
   "n": 55,
   "role": "host",
   "part": "현지 반응",
   "text": "주부공항에서 이 혐의로 처음 적발된 사람은 일본인 남성이었습니다.",
   "start": 218.077,
   "end": 222.426
  },
  {
   "n": 56,
   "role": "host",
   "part": "현지 반응",
   "text": "그리고 지금, 일본 지자체들은 실제로 대책을 내놓기 시작했습니다.",
   "start": 222.806,
   "end": 226.998
  },
  {
   "n": 57,
   "role": "host",
   "part": "실제로 바뀐 것",
   "text": "도시마구는 올해 7월, 캐리어 재활용 업체 두 곳과 협정을 맺었습니다.",
   "start": 227.998,
   "end": 232.668
  },
  {
   "n": 58,
   "role": "host",
   "part": "실제로 바뀐 것",
   "text": "여러 나라 말로 된 경고 전단을 만들고, 이케부쿠로의 대형 전광판으로도 경고하고 있습니다.",
   "start": 233.048,
   "end": 238.324
  },
  {
   "n": 59,
   "role": "host",
   "part": "실제로 바뀐 것",
   "text": "캐리어 투기를 막는 조례도 검토하고 있어요.",
   "start": 238.704,
   "end": 241.187
  },
  {
   "n": 60,
   "role": "host",
   "part": "실제로 바뀐 것",
   "text": "삿포로는 올해 6월부터 호텔에 남은 캐리어를 거둬 고친 뒤 다시 파는 방식을 시작했습니다.",
   "start": 241.567,
   "end": 247.037
  },
  {
   "n": 61,
   "role": "host",
   "part": "실제로 바뀐 것",
   "text": "그럼 여행 중에 캐리어를 바꿨다면, 헌 가방은 어떻게 해야 할까요?",
   "start": 247.417,
   "end": 251.617
  },
  {
   "n": 62,
   "role": "host",
   "part": "실제로 바뀐 것",
