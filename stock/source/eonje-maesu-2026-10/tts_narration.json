 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "매수하자마자 떨어지면, 타이밍을 잘못 잡았나 싶죠.",
   "start": 0.3,
   "end": 3.88
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "많이 쓰는 매수 신호 10가지가 정말 성공 확률을 높일까요?",
   "start": 4.33,
   "end": 8.29
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "2016년부터, S&P 500을 따라가는 ETF인 SPY로 백테스트해 보겠습니다.",
   "start": 8.74,
   "end": 14.27
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "성공은 매수한 값보다 5% 오르는 것, 그 전에 2% 떨어지면 실패예요.",
   "start": 14.72,
   "end": 19.28
  },
  {
   "n": 5,
   "role": "host",
   "part": "도입",
   "text": "판정이 나면 다음 날 매도하고, 다음 신호에 다시 매수해요.",
   "start": 19.73,
   "end": 23.13
  },
  {
   "n": 6,
   "role": "host",
   "part": "도입",
   "text": "비교 상대는 날짜만 무작위로 매수한 계좌 2천 개예요.",
   "start": 23.58,
   "end": 27.02
  },
  {
   "n": 7,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "첫 번째는 신호 없이, 매달 첫 거래일에 매수합니다.",
   "start": 28.02,
   "end": 31.67
  },
  {
   "n": 8,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "신호가 쓸모 있는지 보려면, 신호 없는 방법부터 봐야 하니까요.",
   "start": 32.12,
   "end": 36.14
  },
  {
   "n": 9,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "초록은 성공, 빨강은 실패한 거래예요.",
   "start": 36.59,
   "end": 38.91
  },
  {
   "n": 10,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "오른쪽 위 숫자는 지금까지의 성공률, 그 아래는 무작위 계좌 평균입니다.",
   "start": 39.36,
   "end": 44.55
  },
  {
   "n": 11,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "무작위 계좌도 매도 규칙은 같고, 기다리는 날 수는 각 방법의 기록에서 뽑았어요.",
   "start": 45.0,
   "end": 49.8
  },
  {
   "n": 12,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "2021년 말에는 성공률 56.1%로, 무작위 평균 51.7%보다 높았습니다.",
   "start": 50.25,
   "end": 56.82
  },
  {
   "n": 13,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "그런데 2022년에는 판정 12번 중 11번이 실패였어요.",
   "start": 57.27,
   "end": 61.11
  },
  {
   "n": 14,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "2023년부터는 무작위 평균과 거의 붙어서 움직였어요.",
   "start": 61.56,
   "end": 65.24
  },
  {
   "n": 15,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "결과는 80번 중 37번 성공, 46.2%로 무작위 평균 47.1%보다 조금 낮았어요.",
   "start": 65.69,
   "end": 73.5
  },
  {
   "n": 16,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "회색 띠는 무작위 계좌 90%가 들어간 범위, 41.5%에서 53.2%입니다.",
   "start": 73.95,
   "end": 80.31
  },
  {
   "n": 17,
   "role": "host",
   "part": "매달 첫 거래일",
   "text": "이 띠 안이면 무작위와 차이가 없다는 뜻인데, 매달 첫 거래일 매수도 그 안이었어요.",
   "start": 80.76,
   "end": 85.72
  },
  {
   "n": 18,
   "role": "host",
   "part": "신고가 돌파",
   "text": "두 번째부터 다섯 번째까지는 오를 때 따라 매수하는 추세 신호입니다.",
   "start": 86.72,
   "end": 90.48
  },
  {
   "n": 19,
   "role": "host",
   "part": "신고가 돌파",
   "text": "오르기 시작하면 더 오른다고 보는 방법들이에요.",
   "start": 90.93,
   "end": 93.46
  },
  {
   "n": 20,
   "role": "host",
   "part": "신고가 돌파",
   "text": "두 번째, 20일 신고가 돌파 매수입니다.",
   "start": 93.91,
   "end": 96.6
  },
  {
   "n": 21,
   "role": "host",
   "part": "신고가 돌파",
   "text": "종가가 지난 20 거래일의 가장 높은 종가를 넘으면 매수해요.",
   "start": 97.05,
   "end": 100.51
  },
  {
   "n": 22,
   "role": "host",
   "part": "신고가 돌파",
   "text": "2019년 말 성공률은 58.8%로, 무작위 평균 50.3%보다 높았습니다.",
   "start": 100.96,
   "end": 106.96
  },
  {
   "n": 23,
   "role": "host",
   "part": "신고가 돌파",
   "text": "2022년 4월에 매도한 뒤로는 석 달 가까이 신호가 없었어요.",
   "start": 107.41,
   "end": 111.72
  },
  {
   "n": 24,
   "role": "host",
   "part": "신고가 돌파",
   "text": "그해 판정은 6번 중 5번이 실패였고요.",
   "start": 112.17,
   "end": 114.71
  },
  {
   "n": 25,
   "role": "host",
   "part": "신고가 돌파",
   "text": "판정이 20번 쌓인 뒤로는, 성공률이 무작위 평균보다 낮은 날이 없었어요.",
   "start": 115.16,
   "end": 120.44
  },
  {
   "n": 26,
   "role": "host",
   "part": "신고가 돌파",
   "text": "결과는 판정 63번 중 31번 성공, 49.2%입니다.",
   "start": 120.89,
   "end": 125.71
  },
  {
   "n": 27,
   "role": "host",
   "part": "신고가 돌파",
   "text": "무작위 평균 47.1%, 범위 41.3%에서 53.2% 안이라, 낫다고 할 수 없어요.",
   "start": 126.16,
   "end": 133.92
  },
  {
   "n": 28,
   "role": "host",
   "part": "모멘텀",
   "text": "세 번째는 신고가가 아니어도, 한 달 전보다 오르면 매수합니다.",
   "start": 134.92,
   "end": 138.52
  },
  {
   "n": 29,
   "role": "host",
   "part": "모멘텀",
   "text": "오늘 종가가 21 거래일 전 종가보다 높으면 매수해요.",
   "start": 138.97,
   "end": 142.49
  },
  {
   "n": 30,
   "role": "host",
   "part": "모멘텀",
   "text": "2020년 6월에는 성공률 63.0%로, 무작위 평균 50.9%보다 크게 앞섰습니다.",
   "start": 142.94,
   "end": 149.1
  },
  {
   "n": 31,
   "role": "host",
   "part": "모멘텀",
   "text": "하지만 2022년에는 판정 12번 중 10번이 실패했어요.",
   "start": 149.55,
   "end": 153.54
  },
  {
   "n": 32,
   "role": "host",
   "part": "모멘텀",
   "text": "2025년 2월 말에 매도한 뒤로는 두 달 넘게 신호가 없었어요.",
   "start": 153.99,
   "end": 157.98
  },
  {
   "n": 33,
   "role": "host",
   "part": "모멘텀",
   "text": "결과는 판정 81번 중 42번 성공, 51.9%입니다.",
   "start": 158.43,
   "end": 163.5
  },
  {
   "n": 34,
   "role": "host",
   "part": "모멘텀",
   "text": "무작위 범위 43.3%에서 52.6%의 위쪽 끝에 가까웠지만, 그 안이었어요.",
   "start": 163.95,
   "end": 170.19
  },
  {
   "n": 35,
   "role": "host",
   "part": "이동평균선",
   "text": "네 번째는 차트에 많이 그리는 20일 평균선입니다.",
   "start": 171.19,
   "end": 174.04
  },
  {
   "n": 36,
   "role": "host",
   "part": "이동평균선",
   "text": "종가가 20일 평균을 아래에서 위로 넘는 날, 매수해요.",
   "start": 174.49,
   "end": 178.3
  },
  {
   "n": 37,
   "role": "host",
   "part": "이동평균선",
   "text": "2016년 7월부터 2018년 1월까지 다섯 번 연속 성공했어요.",
   "start": 178.75,
   "end": 183.18
  },
  {
   "n": 38,
   "role": "host",
   "part": "이동평균선",
   "text": "2021년 12월에는 성공률 64.7%로, 무작위 평균 51.8%보다 크게 앞섰습니다.",
   "start": 183.63,
   "end": 190.84
  },
  {
   "n": 39,
   "role": "host",
   "part": "이동평균선",
   "text": "그 뒤 2022년 7월까지는 여섯 번 연속 실패했어요.",
   "start": 191.29,
   "end": 194.81
  },
  {
   "n": 40,
   "role": "host",
   "part": "이동평균선",
   "text": "판정이 20번 쌓인 뒤로는, 무작위 평균보다 낮은 날이 없었습니다.",
   "start": 195.26,
   "end": 199.1
  },
  {
   "n": 41,
   "role": "host",
   "part": "이동평균선",
   "text": "결과는 판정 71번 중 37번 성공, 52.1%로, 지금까지 본 네 가지 중 가장 높아요.",
   "start": 199.55,
   "end": 206.55
  },
  {
   "n": 42,
   "role": "host",
   "part": "이동평균선",
   "text": "그래도 무작위 범위 40.3%에서 54.3% 안이라, 낫다고 할 수 없어요.",
   "start": 207.0,
   "end": 212.7
  },
  {
   "n": 43,
   "role": "host",
   "part": "골든 크로스",
   "text": "다섯 번째는 평균선 두 개를 함께 봅니다.",
   "start": 213.7,
   "end": 216.02
  },
  {
   "n": 44,
   "role": "host",
   "part": "골든 크로스",
   "text": "짧은 5일 평균이 긴 20일 평균을 아래에서 위로 넘으면 매수해요.",
   "start": 216.47,
   "end": 220.55
  },
  {
   "n": 45,
   "role": "host",
   "part": "골든 크로스",
   "text": "2017년 9월에 매도한 뒤, 다음 매수는 2018년 2월이었어요.",
   "start": 221.0,
   "end": 225.51
  },
  {
   "n": 46,
   "role": "host",
   "part": "골든 크로스",
   "text": "2022년 7월에는 성공률 40.0%로, 무작위 평균 48.5%보다 낮았습니다.",
   "start": 225.96,
   "end": 232.29
  },
  {
   "n": 47,
   "role": "host",
   "part": "골든 크로스",
   "text": "바로 전에 여섯 번 연속 실패가 있었거든요.",
   "start": 232.74,
   "end": 235.22
  },
  {
   "n": 48,
   "role": "host",
   "part": "골든 크로스",
   "text": "그 뒤로는 2023년 6월까지 다섯 번 연속 성공했어요.",
   "start": 235.67,
   "end": 239.72
  },
  {
   "n": 49,
   "role": "host",
   "part": "골든 크로스",
   "text": "2024년부터는 판정 12번 중 7번이 성공했습니다.",
   "start": 240.17,
   "end": 243.93
  },
  {
   "n": 50,
   "role": "host",
   "part": "골든 크로스",
   "text": "결과는 판정 50번 중 25번 성공, 딱 50.0%입니다.",
   "start": 244.38,
   "end": 248.61
  },
  {
   "n": 51,
   "role": "host",
   "part": "골든 크로스",
   "text": "무작위 평균 47.4%, 범위 38.6%에서 56.2% 안이었어요.",
   "start": 249.06,
   "end": 255.28
  },
  {
   "n": 52,
   "role": "host",
   "part": "골든 크로스",
   "text": "판정이 10가지 중 가장 적어서, 범위도 넓었습니다.",
   "start": 255.73,
   "end": 258.93
  },
  {
   "n": 53,
   "role": "host",
   "part": "하루 하락",
   "text": "여섯 번째부터는 떨어질 때 매수하는 신호입니다.",
   "start": 259.93,
   "end": 262.81
  },
  {
   "n": 54,
   "role": "host",
   "part": "하루 하락",
   "text": "싸졌을 때 매수하면 더 잘 오를 거라는 생각이죠.",
   "start": 263.26,
   "end": 266.17
  },
  {
   "n": 55,
   "role": "host",
   "part": "하루 하락",
   "text": "여섯 번째, 하루에 1% 이상 떨어지면 다음 날 매수합니다.",
   "start": 266.62,
   "end": 270.54
  },
  {
   "n": 56,
   "role": "host",
   "part": "하루 하락",
   "text": "2019년 1월에는 성공률 35.0%로, 무작위 평균 46.9%보다 크게 뒤졌어요.",
   "start": 270.99,
   "end": 278.1
  },
  {
   "n": 57,
   "role": "host",
   "part": "하루 하락",
   "text": "2018년 한 해에만 판정 12번 중 8번이 실패했거든요.",
   "start": 278.55,
   "end": 282.47
  },
  {
   "n": 58,
   "role": "host",
   "part": "하루 하락",
   "text": "2022년에도 20번 중 13번이 실패였어요.",
   "start": 282.92,
   "end": 286.04
  },
  {
   "n": 59,
   "role": "host",
   "part": "하루 하락",
   "text": "판정이 20번 쌓인 뒤로는, 무작위 평균보다 높은 날이 하루도 없었습니다.",
   "start": 286.49,
   "end": 290.93
  },
  {
   "n": 60,
   "role": "host",
   "part": "하루 하락",
   "text": "결과는 판정 95번 중 44번 성공, 46.3%입니다.",
   "start": 291.38,
   "end": 296.4
  },
  {
   "n": 61,
   "role": "host",
   "part": "하루 하락",
   "text": "무작위 평균은 46.8%, 범위는 40.7%에서 52.8%로, 그 안이었어요.",
   "start": 296.85,
   "end": 304.2
  },
  {
   "n": 62,
   "role": "host",
   "part": "RSI",
   "text": "일곱 번째, RSI 40 아래 매수입니다.",
   "start": 305.2,
   "end": 308.2
  },
  {
   "n": 63,
   "role": "host",
   "part": "RSI",
   "text": "RSI는 최근 14일 동안 오른 폭과 내린 폭을 견준 숫자예요.",
   "start": 308.65,
   "end": 312.63
  },
  {
   "n": 64,
   "role": "host",
   "part": "RSI",
   "text": "40 아래면 많이 떨어진 상태로 보고 매수합니다.",
   "start": 313.08,
   "end": 316.03
  },
  {
   "n": 65,
   "role": "host",
   "part": "RSI",
   "text": "2019년 11월에는 성공률 61.9%로, 무작위 평균 49.3%보다 크게 앞섰어요.",
   "start": 316.48,
   "end": 323.51
  },
  {
   "n": 66,
   "role": "host",
   "part": "RSI",
   "text": "그런데 2020년 코로나 폭락 때는 판정 7번 중 5번이 실패였어요.",
   "start": 323.96,
   "end": 328.49
  },
  {
   "n": 67,
   "role": "host",
   "part": "RSI",
