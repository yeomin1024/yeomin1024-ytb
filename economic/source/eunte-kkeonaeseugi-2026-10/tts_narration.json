 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "지금 퇴직금이나 연금저축을 갖고 은퇴를 앞두고 계시다면, 이 숫자부터 보세요.",
   "start": 0.3,
   "end": 5.26
  },
  {
   "n": 2,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "같은 5억 원을 가진 두 부부가 있습니다.",
   "start": 5.71,
   "end": 7.86
  },
  {
   "n": 3,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "그런데 65세 첫해 세금이 한 부부는 334만 원, 다른 부부는 108만 원입니다.",
   "start": 8.31,
   "end": 13.98
  },
  {
   "n": 4,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "왜 이렇게 차이가 날까요?",
   "start": 14.43,
   "end": 15.77
  },
  {
   "n": 5,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "상품이나 수익률 때문이 아닙니다.",
   "start": 16.22,
   "end": 18.14
  },
  {
   "n": 6,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "돈을 꺼내는 순서가 달랐을 뿐입니다.",
   "start": 18.59,
   "end": 20.63
  },
  {
   "n": 7,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "세금 차이는 은퇴 후 10년 동안 월평균 15만 원이 넘고, 평생 합치면 약 2천만 원이 됩니다.",
   "start": 21.08,
   "end": 26.63
  },
  {
   "n": 8,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "게다가 한 부부는 5년 동안 자녀 건강보험의 피부양자에서도 빠집니다.",
   "start": 27.08,
   "end": 31.53
  },
  {
   "n": 9,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "결론부터 말씀드리겠습니다.",
   "start": 31.98,
   "end": 33.8
  },
  {
   "n": 10,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "예금부터 쓰고, 연금계좌는 나중에 쓰고, 부부가 나눠서 꺼낸다.",
   "start": 34.25,
   "end": 38.62
  },
  {
   "n": 11,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "이 세 가지입니다.",
   "start": 39.07,
   "end": 40.09
  },
  {
   "n": 12,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "이미 다른 순서로 꺼내고 계신 분이 어떻게 고치면 되는지도 끝까지 보여드릴게요.",
   "start": 40.54,
   "end": 45.25
  },
  {
   "n": 13,
   "role": "host",
   "part": "같은 5억, 다른 세금",
   "text": "먼저 두 부부의 경우를 통해 알아보겠습니다.",
   "start": 45.7,
   "end": 47.99
  },
  {
   "n": 14,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "두 부부는 모두 65세 동갑입니다.",
   "start": 48.99,
   "end": 51.14
  },
  {
   "n": 15,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "국민연금은 남편이 한 달에 110만 원, 아내가 40만 원, 합쳐서 150만 원이에요.",
   "start": 51.59,
   "end": 57.11
  },
  {
   "n": 16,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "생활비는 한 달에 300만 원이 들어서, 모자라는 150만 원은 모아 둔 돈에서 꺼냅니다.",
   "start": 57.56,
   "end": 62.75
  },
  {
   "n": 17,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "한 달 150만 원씩 12개월이니까, 1년에 1,800만 원이죠.",
   "start": 63.2,
   "end": 67.31
  },
  {
   "n": 18,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "모아 둔 5억 원은 남편 퇴직금 2억 원, 연금저축 1억 원, 정기예금 2억 원입니다.",
   "start": 67.76,
   "end": 73.47
  },
  {
   "n": 19,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "연금저축은 남편이 6천만 원, 아내가 4천만 원이고, 예금은 한 사람에 1억 원씩이에요.",
   "start": 73.92,
   "end": 79.91
  },
  {
   "n": 20,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "예금 금리는 3.5%이고, 물가도 그만큼 오른다고 봤습니다.",
   "start": 80.36,
   "end": 84.68
  },
  {
   "n": 21,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "A 부부는 퇴직금을 한 번에 받아 남편 이름의 예금에 넣고, 생활비는 남편 연금저축에서 먼저 꺼냅니다.",
   "start": 85.13,
   "end": 91.69
  },
  {
   "n": 22,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "B 부부는 퇴직금을 한 번에 받지 않고 개인형 퇴직연금인 IRP에 넣어 두고, 꺼내는 순서를 정했습니다.",
   "start": 92.14,
   "end": 98.81
  },
  {
   "n": 23,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "두 부부의 차이는 세 가지 원칙에서 나옵니다.",
   "start": 99.26,
   "end": 101.89
  },
  {
   "n": 24,
   "role": "host",
   "part": "두 부부의 통장",
   "text": "하나씩 보겠습니다.",
   "start": 102.34,
   "end": 103.57
  },
  {
   "n": 25,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "첫 번째 원칙은, 세금과 건보료는 부부가 아니라 한 사람씩, 1년 단위로 따진다는 것입니다.",
   "start": 104.57,
   "end": 110.45
  },
  {
   "n": 26,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "꼭 기억하실 기준은 세 가지입니다.",
   "start": 110.9,
   "end": 112.71
  },
  {
   "n": 27,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "먼저 이자와 배당 기준은 1년에 1,000만 원입니다.",
   "start": 113.16,
   "end": 116.12
  },
  {
   "n": 28,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "세금이 아니라 건보료 기준이에요.",
   "start": 116.57,
   "end": 118.53
  },
  {
   "n": 29,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "다음으로 연금저축에서 꺼내는 돈의 기준은 1년에 1,500만 원입니다.",
   "start": 118.98,
   "end": 123.22
  },
  {
   "n": 30,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "세액공제를 받은 돈과 그 수익만 셉니다.",
   "start": 123.67,
   "end": 126.2
  },
  {
   "n": 31,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "마지막으로 피부양자로 남을 수 있는 소득 기준은 1년에 2,000만 원입니다.",
   "start": 126.65,
   "end": 130.89
  },
  {
   "n": 32,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "국민연금은 전부 여기에 들어갑니다.",
   "start": 131.34,
   "end": 133.42
  },
  {
   "n": 33,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "재산이 많으면 이 피부양자 기준은 더 낮아집니다.",
   "start": 133.87,
   "end": 136.59
  },
  {
   "n": 34,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "그리고 이게 중요합니다.",
   "start": 137.04,
   "end": 138.4
  },
  {
   "n": 35,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "기준을 넘으면, 넘은 만큼이 아니라 전부가 소득으로 잡힙니다.",
   "start": 138.85,
   "end": 143.08
  },
  {
   "n": 36,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "예를 들어 이자가 1년에 1,010만 원이면, 넘은 10만 원이 아니라 1,010만 원이 전부 건보료 소득으로 잡힙니다.",
   "start": 143.53,
   "end": 150.5
  },
  {
   "n": 37,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "A 부부 남편은 퇴직금까지 넣은 예금 3억 원에서, 1년 이자가 1,050만 원 나옵니다.",
   "start": 150.95,
   "end": 156.43
  },
  {
   "n": 38,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "이자 기준 1,000만 원을 넘었으니, 1,050만 원이 전부 소득으로 잡힙니다.",
   "start": 156.88,
   "end": 161.4
  },
  {
   "n": 39,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "여기에 1년치 국민연금 1,320만 원을 더하면 2,370만 원이 되어, 피부양자 기준 2,000만 원을 넘습니다.",
   "start": 161.85,
   "end": 169.62
  },
  {
   "n": 40,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "연금저축에서 꺼낸 1,800만 원도 연금저축 기준 1,500만 원을 넘어서, 전부 피부양자 소득에 더해집니다.",
   "start": 170.07,
   "end": 177.37
  },
  {
   "n": 41,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "부부는 두 사람 모두 피부양자 기준 2,000만 원을 넘지 않아야 해서, 남편 때문에 아내까지 같이 피부양자에서 빠집니다.",
   "start": 177.82,
   "end": 185.02
  },
  {
   "n": 42,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "게다가 건보료 고지서는 다음 해에 나와서, 모르고 지나가기 쉽습니다.",
   "start": 185.47,
   "end": 189.62
  },
  {
   "n": 43,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "기준은 사람마다 따로 있는 바구니라고 보시면 됩니다.",
   "start": 190.07,
   "end": 192.97
  },
  {
   "n": 44,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "한 바구니에 몰아 담으면 넘치고, 두 바구니에 나눠 담으면 넘치지 않습니다.",
   "start": 193.42,
   "end": 198.37
  },
  {
   "n": 45,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "세금도 마찬가지입니다.",
   "start": 198.82,
   "end": 200.18
  },
  {
   "n": 46,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "연금저축에서 1,800만 원을 남편 혼자 꺼내면 세금이 약 118만 원입니다.",
   "start": 200.63,
   "end": 205.74
  },
  {
   "n": 47,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "남편이 1,000만 원, 아내가 800만 원씩 나눠 꺼내면 세금이 약 78만 원입니다.",
   "start": 206.19,
   "end": 211.42
  },
  {
   "n": 48,
   "role": "host",
   "part": "원칙 하나, 기준은 한 사람씩",
   "text": "한마디로, 돈은 부부 각자 이름으로 넣고, 해마다 나눠 꺼내야 합니다.",
   "start": 211.87,
   "end": 216.19
  },
  {
   "n": 49,
   "role": "host",
   "part": "원칙 둘, 연금계좌 돈은 꺼낼 때 세금",
   "text": "두 번째 원칙은, 연금계좌 안에 둔 돈은 꺼낼 때 세금을 낸다는 것입니다.",
   "start": 217.19,
   "end": 222.14
  },
  {
   "n": 50,
   "role": "host",
   "part": "원칙 둘, 연금계좌 돈은 꺼낼 때 세금",
   "text": "연금저축이나 IRP 안에서는 이자와 배당이 생겨도, 그해에는 세금도 건보료도 붙지 않습니다.",
   "start": 222.59,
   "end": 228.61
  },
  {
   "n": 51,
   "role": "host",
   "part": "원칙 둘, 연금계좌 돈은 꺼낼 때 세금",
   "text": "물론 꺼낼 때는 세금을 냅니다.",
   "start": 229.06,
   "end": 230.74
  },
  {
   "n": 52,
   "role": "host",
   "part": "원칙 둘, 연금계좌 돈은 꺼낼 때 세금",
   "text": "하지만 한 사람이 1년에 1,500만 원 이하로 꺼내면, 세금은 나이에 따라 5.5%에서 3.3%뿐이고, 피부양자 소득에도 들어가지 않습니다.",
   "start": 231.19,
   "end": 241.24
  },
  {
   "n": 53,
   "role": "host",
   "part": "원칙 둘, 연금계좌 돈은 꺼낼 때 세금",
   "text": "반대로 일반 예금은 1억 원이면 1년 이자가 350만 원이고, 여기서 해마다 세금이 약 54만 원 나갑니다.",
   "start": 241.69,
   "end": 248.25
  },
  {
   "n": 54,
   "role": "host",
   "part": "원칙 둘, 연금계좌 돈은 꺼낼 때 세금",
   "text": "한마디로, 해마다 세금이 붙는 예금을 먼저 쓰고, 연금계좌는 나중에 씁니다.",
   "start": 248.7,
   "end": 253.76
  },
  {
   "n": 55,
   "role": "host",
   "part": "원칙 셋, 퇴직금은 연금으로 첫해부터",
   "text": "세 번째 원칙은, 퇴직금은 연금으로 오래 나눠 받는다는 것입니다.",
   "start": 254.76,
   "end": 258.95
  },
  {
   "n": 56,
   "role": "host",
   "part": "원칙 셋, 퇴직금은 연금으로 첫해부터",
   "text": "퇴직금을 연금으로 받으면 퇴직소득세를 30%에서 최대 50%까지, 오래 받을수록 더 깎아 줍니다.",
   "start": 259.4,
