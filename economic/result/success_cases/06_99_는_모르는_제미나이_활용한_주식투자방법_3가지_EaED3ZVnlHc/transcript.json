 "segments": [
  {
   "start": 0.0,
   "duration": 3.0,
   "text": "오늘 영상을 끝까지 안 보시는 분들은 진짜 땅을 치고 해야 할텐데"
  },
  {
   "start": 3.0,
   "duration": 1.6,
   "text": "요 보고서로 다운받으시게 되면"
  },
  {
   "start": 5.6,
   "duration": 1.9,
   "text": "안녕하세요. 돈 공부 시켜주는 남자입니다."
  },
  {
   "start": 7.5,
   "duration": 2.2,
   "text": "요즘 재미나이 안 쓰시는 분들이 있으신가요?"
  },
  {
   "start": 9.7,
   "duration": 1.4,
   "text": "저도 채치 PT만 쓰다가"
  },
  {
   "start": 11.1,
   "duration": 2.7,
   "text": "재미나이로 갈아타고 나서 훨씬 더 좋아진 것 같습니다."
  },
  {
   "start": 13.8,
   "duration": 1.3,
   "text": "오늘은 재미나이를 통해서"
  },
  {
   "start": 15.1,
   "duration": 2.1,
   "text": "주식 투자 방법에 적용할 수 있는 3가지"
  },
  {
   "start": 17.2,
   "duration": 1.2,
   "text": "알려드리도록 하겠습니다."
  },
  {
   "start": 18.4,
   "duration": 2.3,
   "text": "요즘에 AI 시대가 격변하고 있다 보니까"
  },
  {
   "start": 20.7,
   "duration": 2.4,
   "text": "예전에 채치 PT의 점율이 엄청나게 높아졌는데"
  },
  {
   "start": 23.1,
   "duration": 2.4,
   "text": "요즘 재미나이의 이용률이 엄청나게 높아지고 있다는"
  },
  {
   "start": 25.5,
   "duration": 1.4,
   "text": "기사들이 나오고 있는 것 같습니다."
  },
  {
   "start": 26.9,
   "duration": 1.8,
   "text": "저도 투자를 하는 사람 있다 보니까"
  },
  {
   "start": 28.7,
   "duration": 2.8,
   "text": "재미나이를 어떻게 투자에 접목해야 될지 고민을 해보다가"
  },
  {
   "start": 31.5,
   "duration": 1.6,
   "text": "우리 구독해주시는 분들을 위해서"
  },
  {
   "start": 33.1,
   "duration": 1.7,
   "text": "재미나이를 활용해서 3가지"
  },
  {
   "start": 34.8,
   "duration": 2.3,
   "text": "주식 투자 적용 방법 안 내드리도록 하겠습니다."
  },
  {
   "start": 37.1,
   "duration": 1.6,
   "text": "오늘 영상만 끝까지 보셔도"
  },
  {
   "start": 38.7,
   "duration": 2.7,
   "text": "주식 투자에 대해서 공부하는 시간은 2-3배 주는데"
  },
  {
   "start": 41.4,
   "duration": 2.8,
   "text": "내 계좌 장보는 2-3배 늘어나실 수가 있으실 겁니다."
  },
  {
   "start": 44.2,
   "duration": 2.5,
   "text": "자, 화면 보면서 안 내드리도록 하겠습니다."
  },
  {
   "start": 46.7,
   "duration": 2.3,
   "text": "우선 재미나이를 처음 쓰시는 분들을 위해서"
  },
  {
   "start": 49.0,
   "duration": 1.5,
   "text": "간단한 접속 방법과"
  },
  {
   "start": 50.5,
   "duration": 2.0,
   "text": "일단 세팅 방법부터 안 내드리도록 할게요."
  },
  {
   "start": 52.5,
   "duration": 2.0,
   "text": "일단 네이버, 친숙한 네이버에다가"
  },
  {
   "start": 54.5,
   "duration": 1.9,
   "text": "재미나이를 이렇게 검색을 좀 해주시고요."
  },
  {
   "start": 56.4,
   "duration": 1.4,
   "text": "그리고 나서 이렇게 홈페이지 들어가시면"
  },
  {
   "start": 57.8,
   "duration": 1.4,
   "text": "바로 준비가 이제 된 겁니다."
  },
  {
   "start": 59.2,
   "duration": 2.3,
   "text": "저 같은 경우에는 여기서 꿀팁 알려드리면"
  },
  {
   "start": 61.5,
   "duration": 2.0,
   "text": "보통 구글 크롬 많이 사용하실 텐데"
  },
  {
   "start": 63.5,
   "duration": 1.5,
   "text": "여기서 설정을 간단하게 해주면"
  },
  {
   "start": 65.0,
   "duration": 2.3,
   "text": "훨씬 더 생산성을 높일 수가 있어요."
  },
  {
   "start": 67.3,
   "duration": 2.9,
   "text": "우측 상단에 보시는 이 점점점 버튼을 누르시고요."
  },
  {
   "start": 70.2,
   "duration": 1.8,
   "text": "설정 누르신 다음에"
  },
  {
   "start": 72.0,
   "duration": 2.1,
   "text": "여기 시작치 설정을 누르시고"
  },
  {
   "start": 74.1,
   "duration": 2.6,
   "text": "저는 특정 페이지 또는 페이지 모음 열기를"
  },
  {
   "start": 76.7,
   "duration": 1.5,
   "text": "기본 세팅으로 해놓거든요."
  },
  {
   "start": 78.2,
   "duration": 0.9,
   "text": "이 세팅을 해놓을 때"
  },
  {
   "start": 79.1,
   "duration": 3.1,
   "text": "저는 뉴스 같은 것들을 볼 때는 네이버를 주로 이용하고"
  },
  {
   "start": 82.2,
   "duration": 1.9,
   "text": "이제 어떠한 심층 리서치라든지"
  },
  {
   "start": 84.1,
   "duration": 1.1,
   "text": "기업 분석 같은 거 할 때는"
  },
  {
   "start": 85.2,
   "duration": 1.7,
   "text": "재미나이를 또 주로 이용하다 보니까"
  },
  {
   "start": 86.9,
   "duration": 2.3,
   "text": "이렇게 두 가지 페이지를 넣어놓는 거예요."
  },
  {
   "start": 89.2,
   "duration": 2.0,
   "text": "세 페이지 추가 누르시면 또 누를 수가 있거든요."
  },
  {
   "start": 91.2,
   "duration": 3.2,
   "text": "자, 그리고 나서 구글 크롬을 다시 이제 시작을 해보시면"
  },
  {
   "start": 94.4,
   "duration": 2.0,
   "text": "이런 식으로 시작이 될 때 네이버와"
  },
  {
   "start": 96.4,
   "duration": 2.4,
   "text": "재미나이가 한 번에 뜨는 걸 보실 수 있으실 거예요."
  },
  {
   "start": 98.8,
   "duration": 2.0,
   "text": "업무 활용도 훨씬 더 높아지실 거고"
  },
  {
   "start": 100.8,
   "duration": 1.3,
   "text": "아마 이렇게 세팅만 해놓으시면"
  },
  {
   "start": 102.1,
   "duration": 2.2,
   "text": "기본적으로 기업 분석 하시거나 이런 것들을 할 때"
  },
  {
   "start": 104.3,
   "duration": 2.0,
   "text": "엄청나게 시간이 많이 단축이 되실 겁니다."
  },
  {
   "start": 106.3,
   "duration": 1.6,
   "text": "자, 그럼 다시 재미나이에 들어와서"
  },
  {
   "start": 107.9,
   "duration": 2.2,
   "text": "여기서 기본적으로 우리가 재미나이를 통해서"
  },
  {
   "start": 110.1,
   "duration": 1.7,
   "text": "주식 투자를 활용하기 위해서는"
  },
  {
   "start": 111.8,
   "duration": 2.5,
   "text": "조금 질문에 대한 난이도를 좀 높여줘야 돼요."
  },
  {
   "start": 114.3,
   "duration": 2.3,
   "text": "그냥 간단하게 요즘에 투자할 만한 기업 뭐가 있어"
  },
  {
   "start": 116.6,
   "duration": 1.6,
   "text": "이렇게 하게 되면 좀 어렵거든요."
  },
  {
   "start": 118.2,
   "duration": 1.8,
   "text": "그럼 저 같으면 이렇게 좀 질문 해볼 것 같아요."
  },
  {
   "start": 120.0,
   "duration": 2.4,
   "text": "최근에 이제 삼성전자의 갤럭시 S26"
  },
  {
   "start": 122.4,
   "duration": 1.5,
   "text": "출시를 앞두고 있다 보니까"
  },
  {
   "start": 123.9,
   "duration": 3.1,
   "text": "삼성전자 갤럭시 S26에 들어가는 여러 가지 기능들"
  },
  {
   "start": 127.0,
   "duration": 1.6,
   "text": "삼성전자만 생산하는 게 아니라"
  },
  {
   "start": 128.6,
   "duration": 2.3,
   "text": "또 이제 협력 업체들과 같이 할 거 아니에요."
  },
  {
   "start": 130.9,
   "duration": 1.5,
   "text": "그럼 저는 이렇게 질문할 것 같아요."
  },
  {
   "start": 132.4,
   "duration": 4.7,
   "text": "삼성전자가 갤럭시 S26 출시를 앞두고 있는데"
  },
  {
   "start": 137.1,
   "duration": 4.7,
   "text": "이번에 삼성전자 갤럭시 S26에 들어가는"
  },
  {
   "start": 141.8,
   "duration": 1.5,
   "text": "핵심부품 중에"
  },
  {
   "start": 143.3,
   "duration": 3.5,
   "text": "삼성전자와 협력하는 협력사가 있을까?"
  },
  {
   "start": 146.8,
   "duration": 3.1,
   "text": "그 중에 수혜를 크게 받는 기업들을"
  },
  {
   "start": 149.9,
   "duration": 2.0,
   "text": "3개 정도만 추려서 알려줘."
  },
  {
   "start": 151.9,
   "duration": 1.9,
   "text": "일단 이런 것들은 전통적인 방식이에요."
  },
  {
   "start": 153.8,
   "duration": 1.9,
   "text": "이렇게 전통적인 방식으로 질문을 하게 되면"
  },
  {
   "start": 155.7,
   "duration": 1.7,
   "text": "재미나이가 어느 정도 생각을 해보고"
  },
  {
   "start": 157.4,
   "duration": 3.7,
   "text": "저는 참고로 여기 사고 모드, 빠른 모드, 프로 모드 다양하게 있는데"
  },
  {
   "start": 161.1,
   "duration": 2.1,
   "text": "저는 이제 프로 모델은 쓰지 않고 있어서"
  },
  {
   "start": 163.2,
   "duration": 2.1,
   "text": "플러스 모델만 쓰고 있어서"
  },
  {
   "start": 165.3,
   "duration": 2.9,
   "text": "일단 빠른 모드로 하게 되면 엄청나게 속도가 빨라집니다."
  },
  {
   "start": 168.2,
   "duration": 1.4,
   "text": "사고 모드로 하게 되면"
  },
  {
   "start": 169.6,
   "duration": 2.1,
   "text": "조금 더 디테일하게 사고를 할 수 있어요."
  },
  {
   "start": 171.7,
   "duration": 2.4,
   "text": "나중에 이 도구에 대한 부분들도 설명을 드리도록 할게요."
  },
  {
   "start": 174.1,
   "duration": 1.9,
   "text": "그러면 얘가 이렇게 답변해줍니다."
  },
  {
   "start": 176.0,
   "duration": 2.4,
   "text": "삼성전자의 차세대 플래그시 모모모 해가지고"
  },
  {
   "start": 178.4,
   "duration": 3.9,
   "text": "수혜가 예상되는 기업들, MCNX, 두산 테스나"
  },
  {
   "start": 182.3,
   "duration": 3.1,
   "text": "코리아서킷 이런 기업들을 추천를 해줬네요."
  },
  {
   "start": 185.4,
   "duration": 2.6,
   "text": "그러면 대략적으로 아 이런 기업들이 있구나."
  },
  {
   "start": 188.0,
   "duration": 3.6,
   "text": "근데 아마 이 중에 상장이 안 된 기업도 분명 있을 수 있을 거예요."
  },
  {
   "start": 191.6,
   "duration": 4.0,
   "text": "위 3개 중에 상장이 된 기업들만 알려주고"
  },
  {
   "start": 195.6,
   "duration": 3.8,
   "text": "상장이 안 된 기업이 있으면 제외시키고"
  },
  {
   "start": 199.4,
   "duration": 2.4,
   "text": "다시 3개 기업으로 추출해줘."
  },
  {
   "start": 201.8,
   "duration": 2.2,
   "text": "이렇게 딱 이제 제 질문을 하는 거죠."
  },
  {
   "start": 204.0,
   "duration": 1.1,
   "text": "근데 다시 답변해줬을 때"
  },
  {
   "start": 205.1,
   "duration": 1.8,
   "text": "아 3개 기업 모두 당장이 되어 있구나"
  },
  {
   "start": 206.9,
   "duration": 1.3,
   "text": "이렇게 체크를 해볼 수가 있을 거예요."
  },
  {
   "start": 208.2,
   "duration": 1.8,
   "text": "이게 기본적인 재미나이로 활용한"
  },
  {
   "start": 210.0,
   "duration": 1.6,
   "text": "기본적인 전통적인 방식이고요."
  },
  {
   "start": 211.6,
   "duration": 2.2,
   "text": "많은 분들이 이미 이용을 하고 있는 방식일 겁니다."
  },
  {
   "start": 213.8,
   "duration": 2.1,
   "text": "그럼 이제 바로 이어서 두 번째 방법에 대해서"
  },
  {
   "start": 215.9,
   "duration": 0.9,
   "text": "안 내드릴 텐데요."
  },
  {
   "start": 216.8,
   "duration": 2.4,
   "text": "자 이렇게 질문을 통해서 기업을 추출을 했어요."
  },
  {
   "start": 219.2,
   "duration": 2.0,
   "text": "그러면 이 기업이 좋은 기업인지"
  },
  {
   "start": 221.2,
   "duration": 1.2,
   "text": "투자해볼 만한 기업인지"
  },
  {
   "start": 222.4,
   "duration": 2.0,
   "text": "검색을 해보고 기업 분석을 해야 되잖아요."
  },
  {
   "start": 224.4,
   "duration": 1.4,
   "text": "일단 전통적인 방식은"
  },
  {
   "start": 225.8,
   "duration": 1.5,
   "text": "네이버 증권이라든지"
  },
  {
   "start": 227.3,
   "duration": 2.0,
   "text": "금융관도권 전자공시 시스템이라고 하는"
  },
  {
   "start": 229.3,
   "duration": 1.0,
   "text": "다트를 통해서"
  },
  {
   "start": 230.3,
   "duration": 1.6,
   "text": "기업에 대한 분석을 하는 것들이"
  },
  {
   "start": 231.9,
   "duration": 1.2,
   "text": "일반적인 경우인데요."
  },
  {
   "start": 233.1,
   "duration": 2.3,
   "text": "일단 전통적인 방식 한번 보여드리도록 할게요."
  },
  {
   "start": 235.4,
   "duration": 2.3,
   "text": "예를 들어서 아까 mcnext라고 하는 기업이 나왔죠."
  },
  {
   "start": 237.7,
   "duration": 2.5,
   "text": "그러면 mcnext에 대해서 검색을 해보는 겁니다."
  },
  {
   "start": 240.2,
   "duration": 2.1,
   "text": "그러면 저 같은 경우에 기업 분석을 할 때"
  },
  {
   "start": 242.3,
   "duration": 2.2,
   "text": "기본적인 홈페이지 보통 들어가 봅니다."
  },
  {
   "start": 244.5,
   "duration": 1.1,
   "text": "홈페이지 들어가 보고"
  },
  {
   "start": 245.6,
   "duration": 2.2,
   "text": "기업에 대한 내용들, 사업 분야들"
  },
  {
   "start": 247.8,
   "duration": 1.9,
   "text": "미디어에서 지금 나온 것들이 뭐가 있는지"
  },
  {
   "start": 249.7,
   "duration": 1.3,
   "text": "기본적으로 쭉 훑어보고"
  },
  {
   "start": 251.0,
   "duration": 1.5,
   "text": "조금 심층적으로 볼 게 있으면"
  },
  {
   "start": 252.5,
   "duration": 1.3,
   "text": "심층적으로 좀 보는 편이고요."
  },
  {
   "start": 253.8,
   "duration": 2.1,
   "text": "더 중요한 거는 mcnext라고 하는 기업을"
  },
  {
   "start": 255.9,
   "duration": 1.0,
   "text": "쳐서 들어가게 되면"
  },
  {
   "start": 256.9,
   "duration": 1.8,
   "text": "네이버 증권으로 연결이 되거든요."
  },
  {
   "start": 258.7,
   "duration": 2.3,
   "text": "여기서 기본적인 서칭을 할 수가 있는 게 있어요."
  },
  {
   "start": 261.0,
   "duration": 2.1,
   "text": "물론 hts나 mts를 통해서"
  },
  {
   "start": 263.1,
   "duration": 2.5,
   "text": "각 증권사별로 또 검색할 수 있는 것들이 있지만"
  },
  {
   "start": 265.6,
   "duration": 2.2,
   "text": "기본적인 검색들은 여기서 거의 다 가능합니다."
  },
  {
   "start": 267.8,
   "duration": 1.4,
   "text": "그래서 기본적인 종합정보,"
  },
  {
   "start": 269.2,
   "duration": 1.8,
   "text": "제무적인 구조들이 나오고 있고요."
  },
  {
   "start": 271.0,
   "duration": 1.3,
   "text": "최근 실적이라든지 이런 것들"
  },
  {
   "start": 272.3,
   "duration": 1.6,
   "text": "기본적인 지표들이 여기 나와 있어서"
  },
  {
   "start": 273.9,
   "duration": 1.2,
   "text": "기본적인 서칭을 하기에는"
  },
  {
   "start": 275.1,
   "duration": 1.5,
   "text": "충분할 거라고 저는 생각합니다."
  },
  {
   "start": 276.6,
   "duration": 1.6,
   "text": "그래서 동정 업종 내비했을 때"
  },
  {
   "start": 278.2,
   "duration": 1.1,
   "text": "이런 비교가 있구나."
  },
  {
   "start": 279.3,
   "duration": 2.7,
   "text": "그럼 여기서 저는 이제 종목 분석을 또 들어가 보는 편인데요."
  },
  {
   "start": 282.0,
   "duration": 2.5,
   "text": "종목 분석에서 현재 지표들이 어떻게 되어 있는지"
  },
  {
   "start": 284.5,
   "duration": 1.1,
   "text": "배당한 몇 프로고"
  },
  {
   "start": 285.6,
   "duration": 2.7,
   "text": "pbr, pbr, psr 이런 것들이 어떻게 되어 있는지"
  },
  {
   "start": 288.3,
   "duration": 1.2,
   "text": "기본으로 좀 살펴보고요."
  },
  {
   "start": 289.5,
   "duration": 1.2,
   "text": "컨센서스라고 해서"
  },
  {
   "start": 290.7,
   "duration": 2.1,
   "text": "기업을 좀 추천할 만한 기업인지"
  },
  {
   "start": 292.8,
   "duration": 1.3,
   "text": "이런 것들에 대한 증권사"
  },
  {
   "start": 294.1,
   "duration": 2.7,
   "text": "에널리스트들에 대한 분석도 보실 수가 있으실 거예요."
  },
  {
   "start": 296.8,
   "duration": 1.4,
   "text": "저는 꼭 보는 것 중에 하나가"
  },
  {
   "start": 298.2,
   "duration": 1.3,
   "text": "지분은 꼭 들어가 봐요."
  },
  {
   "start": 299.5,
   "duration": 1.1,
   "text": "지분 현황에 들어가 봐서"
  },
  {
   "start": 300.6,
   "duration": 3.5,
   "text": "이 지분이 대표이사 혹은 연결된 회사의 지분이"
  },
  {
   "start": 304.1,
   "duration": 1.6,
   "text": "최소 10% 이상은 되는지"
  },
  {
   "start": 305.7,
   "duration": 1.3,
   "text": "간혹 최대 주주의 지분율이"
  },
  {
   "start": 307.0,
   "duration": 1.7,
   "text": "10%도 안 되는 기업들도 있거든요."
  },
  {
   "start": 308.7,
   "duration": 2.1,
   "text": "그런 기업은 사실 잘 보진 않습니다."
  },
  {
   "start": 310.8,
   "duration": 1.5,
   "text": "왜냐하면 쉽게 생각해 볼게요."
  },
  {
   "start": 312.3,
   "duration": 1.8,
   "text": "내가 회사의 대표고 오너예요."
  },
  {
   "start": 314.1,
   "duration": 1.8,
   "text": "그런데 내가 이 회사의 지분은"
  },
  {
   "start": 315.9,
   "duration": 1.2,
   "text": "10%도 안 가지고 있어요."
  },
  {
   "start": 317.1,
   "duration": 1.5,
   "text": "그럼 기업을 성장시키고"
  },
  {
   "start": 318.6,
   "duration": 2.0,
   "text": "좀 더 발전시킬 만한 마음이 있을까요?"
  },
  {
   "start": 320.6,
   "duration": 1.1,
   "text": "아니면 현상 유지나"
  },
  {
   "start": 321.7,
   "duration": 1.4,
   "text": "그냥 권위만 세우려고 할까요?"
  },
  {
   "start": 323.1,
   "duration": 1.4,
   "text": "보통 후자의 가능성이 큽니다."
  },
  {
   "start": 324.5,
   "duration": 1.5,
   "text": "그렇기 때문에 저는 보실 때는"
  },
  {
   "start": 326.0,
   "duration": 2.2,
   "text": "최대 주주가 민동욱이라고 하는 사람이구나"
  },
  {
   "start": 328.2,
   "duration": 1.4,
   "text": "27% 정도 갖고 있고"
  },
  {
   "start": 329.6,
   "duration": 0.8,
   "text": "최선이라는 사람은"
  },
  {
   "start": 330.4,
   "duration": 1.8,
   "text": "아마 뭐 배우자가 될 수도 있겠죠."
  },
  {
   "start": 332.2,
   "duration": 2.1,
   "text": "이런 식으로 최대 주주에 대한 부분들이"
  },
  {
   "start": 334.3,
   "duration": 1.1,
   "text": "이 정도로 살펴 있는지"
  },
  {
   "start": 335.4,
   "duration": 1.3,
   "text": "간단하게 볼 수가 있을 겁니다."
  },
  {
   "start": 336.7,
   "duration": 2.4,
   "text": "그리고 재무적인 분석을 들어가 볼 수 있고요."
  },
  {
   "start": 339.1,
   "duration": 1.4,
   "text": "여러 가지 투자 지표 이런 것들"
  },
  {
   "start": 340.5,
   "duration": 1.2,
   "text": "쭉 살펴보는 편인데"
  },
  {
   "start": 341.7,
   "duration": 1.0,
   "text": "그리고 나서 더 중요한 건"
  },
  {
   "start": 342.7,
   "duration": 1.2,
   "text": "전자 공시를 들어가 보는데"
  },
  {
   "start": 343.9,
   "duration": 1.5,
   "text": "전자 공시는 여기 네이버 증권에서도"
  },
  {
   "start": 345.4,
   "duration": 1.9,
   "text": "바로 연동이 되니까 들어가 보실 수도 있고"
  },
  {
   "start": 347.3,
   "duration": 1.4,
   "text": "아니면 네이버에다가"
  },
  {
   "start": 348.7,
   "duration": 1.9,
   "text": "금융감독원 전자 공시 시스템"
  },
  {
   "start": 350.6,
   "duration": 1.1,
   "text": "혹은 그냥 영어로"
  },
  {
   "start": 351.7,
   "duration": 2.7,
   "text": "DART라고 검색하시면 바로 나오실 거예요."
  },
  {
   "start": 354.4,
   "duration": 0.9,
   "text": "여기 들어가셔서"
  },
  {
   "start": 355.3,
   "duration": 2.2,
   "text": "기업에 대한 이름을 검색해 주시면 되는 거예요."
  },
  {
   "start": 357.5,
   "duration": 2.6,
   "text": "MCNEX 이렇게 검색을 해주시면 나오죠."
  },
  {
   "start": 360.1,
   "duration": 1.3,
   "text": "아까랑 똑같은 방법입니다."
  },
  {
   "start": 361.4,
   "duration": 1.1,
   "text": "여기서 보셔도 되고"
  },
  {
   "start": 362.5,
   "duration": 0.7,
   "text": "저기서 보셔도 되고"
  },
  {
   "start": 363.2,
   "duration": 0.8,
   "text": "상관은 없어요."
  },
  {
   "start": 364.0,
   "duration": 1.4,
   "text": "그러면 MCNEX라는 기업에"
  },
  {
   "start": 365.4,
   "duration": 1.6,
   "text": "이런 보고서들이 나올 텐데"
  },
  {
   "start": 367.0,
   "duration": 1.5,
   "text": "주로 보셔야 되는 것 중에 하나가"
  },
  {
   "start": 368.5,
   "duration": 2.2,
   "text": "분기보고서나 사업 보고서를 보셔야 돼요."
  },
  {
   "start": 370.7,
   "duration": 1.2,
   "text": "그래서 여기 들어가 보시면"
  },
  {
   "start": 371.9,
   "duration": 1.7,
   "text": "분기보고서 최근 것들이 있죠."
  },
  {
   "start": 373.6,
   "duration": 1.0,
   "text": "저는 어떻게 보냐면"
  },
  {
   "start": 374.6,
   "duration": 2.6,
   "text": "회사의 개요 연역 이런 것들 간단하게 보고"
  },
  {
   "start": 377.2,
   "duration": 1.9,
   "text": "주로 보는 것 중에 하나가 사업의 내용이에요."
  },
  {
   "start": 379.1,
   "duration": 1.2,
   "text": "그래서 어떤 사업을 하는지"
  },
  {
   "start": 380.3,
   "duration": 1.1,
   "text": "제일 중요한 내용이죠."
  },
  {
   "start": 381.4,
   "duration": 2.5,
   "text": "얘네가 삼성전자의 협력 업체라고 하는데"
  },
  {
   "start": 383.9,
   "duration": 1.4,
   "text": "어떤 것들을 주로 협력을 해서"
  },
  {
   "start": 385.3,
   "duration": 0.8,
   "text": "운영을 하고 있는지"
  },
  {
   "start": 386.1,
   "duration": 1.5,
   "text": "이런 것들이 되게 중요할 거 아니에요."
  },
  {
   "start": 387.6,
   "duration": 1.3,
   "text": "그래서 이런 것들을 살펴보는 겁니다."
  },
  {
   "start": 388.9,
   "duration": 1.5,
   "text": "근데 이 두 번째 방법이"
  },
  {
   "start": 390.4,
   "duration": 1.7,
   "text": "매우 중요한 것 중에 하나가 뭐냐면"
  },
  {
   "start": 392.1,
   "duration": 1.1,
   "text": "이것들에 대한 부분들을"
  },
  {
   "start": 393.2,
   "duration": 2.3,
   "text": "보통 보고서를 다운 받을 수가 있어요."
  },
  {
   "start": 395.5,
   "duration": 1.6,
   "text": "오늘 영상을 끝까지 안 보시는 분들은"
  },
  {
   "start": 397.1,
   "duration": 1.2,
   "text": "진짜 땅을 치고 해야 할 텐데"
  },
  {
   "start": 398.3,
   "duration": 1.6,
   "text": "요 보고서로 다운 받으시게 되면"
  },
  {
   "start": 399.9,
   "duration": 1.3,
   "text": "그럼 이 분기보고서에 대한"
  },
  {
   "start": 401.2,
   "duration": 1.6,
   "text": "파일이 다운이 됐을 거 아니에요."
  },
  {
   "start": 403.1,
   "duration": 1.8,
   "text": "저는 이거를 파일을 가져와서"
  },
  {
   "start": 404.9,
   "duration": 1.2,
   "text": "재미나이에 늡니다."
  },
  {
   "start": 406.1,
   "duration": 1.9,
   "text": "그래서 어떻게 검색을 하냐면"
  },
  {
   "start": 408.0,
   "duration": 4.0,
   "text": "이건 MCNX라고 하는 기업의 사업 보고서야"
  },
  {
   "start": 412.0,
   "duration": 3.1,
   "text": "이 기업의 핵심 기술은 뭔지"
  },
  {
   "start": 415.1,
   "duration": 3.8,
   "text": "그리고 삼성전자 신제품 출시에서"
  },
  {
   "start": 418.9,
   "duration": 2.7,
   "text": "어떤 수혜를 볼 수 있는지"
  },
  {
   "start": 421.6,
   "duration": 3.5,
   "text": "그리고 기업의 주 사업 영역 뭔지"
  },
  {
   "start": 425.1,
   "duration": 1.0,
   "text": "요약을 해줘."
  },
  {
   "start": 426.1,
   "duration": 1.5,
   "text": "이런 식으로 검색을 하게 되는 거죠."
  },
  {
   "start": 427.6,
   "duration": 1.7,
   "text": "그러면 얘네가 이 재미나이에서"
  },
  {
   "start": 429.3,
   "duration": 1.1,
   "text": "이 기업의 보고서를"
  },
  {
   "start": 430.4,
   "duration": 1.6,
   "text": "쫙 스캔을 하고 읽어보고"
  },
  {
   "start": 432.0,
   "duration": 3.2,
   "text": "그 다음에 핵심 내용만 빠르게 정리를 해줄 수 있다는 거예요."
  },
  {
   "start": 435.2,
   "duration": 2.8,
   "text": "만약에 이거 기다리시는 게 조금 어려우신 분들은"
  },
  {
   "start": 438.0,
   "duration": 1.2,
   "text": "요새 저는 사고 모두를"
  },
  {
   "start": 439.2,
   "duration": 2.3,
   "text": "좀 더 복잡한 문제를 볼 수 있는 것들인데"
  },
  {
   "start": 441.5,
   "duration": 1.3,
   "text": "빠른 모두로 하시게 되면"
  },
  {
   "start": 442.8,
   "duration": 1.3,
   "text": "훨씬 더 속도가 빨라집니다."
  },
  {
   "start": 444.1,
   "duration": 0.7,
   "text": "참고해주세요."
  },
  {
   "start": 444.8,
   "duration": 1.4,
   "text": "그러면 이제 결과물이 나옵니다."
  },
  {
   "start": 446.2,
   "duration": 2.3,
   "text": "아 MCNX라고 하는 기업이"
  },
  {
   "start": 448.5,
   "duration": 1.7,
   "text": "요런 기술들을 하는구나."
  },
  {
   "start": 450.2,
   "duration": 1.4,
   "text": "그리고 삼성전자와"
  },
  {
   "start": 451.6,
   "duration": 2.0,
   "text": "신제품에 대한 수혜 요인들이"
  },
  {
   "start": 453.6,
   "duration": 1.5,
   "text": "요렇게 됐구나 라는 것들을"
  },
  {
   "start": 455.1,
   "duration": 1.7,
   "text": "간단하게 보실 수가 있으실 거예요."
  },
  {
   "start": 456.8,
   "duration": 1.6,
   "text": "그러면 저는 기업을 볼 때"
  },
  {
   "start": 458.4,
   "duration": 1.8,
   "text": "아 이 기업이 진짜 삼성전자의"
  },
  {
   "start": 460.2,
   "duration": 1.1,
   "text": "언팩에 맞춰서"
  },
  {
   "start": 461.3,
   "duration": 1.9,
   "text": "계속 주가가 좀 반응 있었는지"
  },
  {
   "start": 463.2,
   "duration": 1.6,
   "text": "요런 것들을 살펴볼 거거든요."
  },
  {
   "start": 464.8,
   "duration": 3.2,
   "text": "그러면 이 MCNX라고 하는 기업의"
  },
  {
   "start": 468.0,
   "duration": 1.6,
   "text": "과거 5년 동안"
  },
  {
   "start": 469.6,
   "duration": 3.2,
   "text": "삼성전자의 신제품 출시"
  },
  {
   "start": 472.8,
   "duration": 1.4,
   "text": "시점에 맞춰서"
  },
  {
   "start": 474.2,
   "duration": 2.8,
   "text": "주가들이 계속 상승을 해줬는지"
  },
  {
   "start": 477.0,
   "duration": 0.7,
   "text": "체크해줘."
  },
  {
   "start": 477.7,
   "duration": 2.7,
   "text": "그리고 주가 상승에 대한 부분은"
  },
  {
   "start": 480.4,
   "duration": 2.8,
   "text": "언팩 기준으로 직전 3개월"
  },
  {
   "start": 483.2,
   "duration": 1.7,
   "text": "언팩 이후 3개월"
  },
  {
   "start": 484.9,
   "duration": 2.3,
   "text": "이런 식으로 정리해서 알려줘."
  },
  {
   "start": 487.2,
   "duration": 1.3,
   "text": "이런 식으로 보면 되거든요."
  },
  {
   "start": 488.5,
   "duration": 1.4,
   "text": "그러면 얘가 이제 직전"
  },
  {
   "start": 489.9,
   "duration": 1.8,
   "text": "5년치의 데이터를 보고"
  },
  {
   "start": 491.7,
   "duration": 1.6,
   "text": "MCNX라고 하는 기업의"
  },
  {
   "start": 493.3,
   "duration": 1.2,
