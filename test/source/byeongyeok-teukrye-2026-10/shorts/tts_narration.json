 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "이번 선수들도 취소될까",
   "text": "아시안게임 금메달 뒤 나온 말 한마디에, 병역특례를 없애자는 말까지 나왔습니다.",
   "start": 0.3,
   "end": 5.41
  },
  {
   "n": 2,
   "role": "host",
   "part": "이번 선수들도 취소될까",
   "text": "일부 선수의 '전역모' 사진과, 군 면제만 바라봤다는 말 때문입니다.",
   "start": 5.79,
   "end": 10.125
  },
  {
   "n": 3,
   "role": "host",
   "part": "이번 선수들도 취소될까",
   "text": "선수들은 곧 사과했습니다.",
   "start": 10.505,
   "end": 12.235
  },
  {
   "n": 4,
   "role": "host",
   "part": "이번 선수들도 취소될까",
   "text": "국방부는 예술·체육요원을 궁극적으로 줄이고 없애겠다고 밝혔습니다.",
   "start": 12.615,
   "end": 16.938
  },
  {
   "n": 5,
   "role": "host",
   "part": "이번 선수들도 취소될까",
   "text": "이번 선수들부터 적용하라는 댓글엔 좋아요가 수천 개씩 붙었습니다.",
   "start": 17.318,
   "end": 21.269
  },
  {
   "n": 6,
   "role": "host",
   "part": "이번 선수들도 취소될까",
   "text": "그런데 병역특례는 사실 면제가 아닙니다.",
   "start": 21.649,
   "end": 24.083
  },
  {
   "n": 7,
   "role": "host",
   "part": "이번 선수들도 취소될까",
   "text": "2년 10개월 동안 복무하면서, 공익복무 544시간을 채워야 합니다.",
   "start": 24.463,
   "end": 29.181
  },
  {
   "n": 8,
   "role": "host",
   "part": "이번 선수들도 취소될까",
   "text": "병역법에는 이 자격을 취소하는 경우도 일곱 가지로 적혀 있습니다.",
   "start": 29.561,
   "end": 33.431
  },
  {
   "n": 9,
   "role": "host",
   "part": "이번 선수들도 취소될까",
   "text": "그렇다면 이번 금메달리스트의 병역특례도 취소할 수 있을까요?",
   "start": 33.811,
   "end": 37.564
