 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "깨끗하기로 유명한 일본 길거리에 주인 없는 캐리어가 버려지고 있습니다.",
   "start": 0.3,
   "end": 4.13
  },
  {
   "n": 2,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "도쿄 도시마구에서만 지난해 약 290개가 나왔습니다.",
   "start": 4.58,
   "end": 8.18
  },
  {
   "n": 3,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "한 쓰레기 집적소 앞 캐리어는 일주일이 지나도 주인이 나타나지 않았습니다.",
   "start": 8.63,
   "end": 13.35
  },
  {
   "n": 4,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "도쿄 경찰에 습득물로 들어온 캐리어도 약 4,600개로, 3년 전의 1.8배입니다.",
   "start": 13.8,
   "end": 19.56
  },
  {
   "n": 5,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "주민들 사이에선 \"폭발물인 줄 알았다\"는 말까지 나왔습니다.",
   "start": 20.01,
   "end": 23.89
  },
  {
   "n": 6,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "길에 버리는 건 불법입니다.",
   "start": 24.34,
   "end": 25.86
  },
  {
   "n": 7,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "5년 이하의 구금형이나 1,000만 엔 이하의 벌금을 받을 수 있습니다.",
   "start": 26.31,
   "end": 29.91
  },
  {
   "n": 8,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "그런데도 여행객들은 왜 캐리어를 길에 두고 갈까요?",
   "start": 30.36,
   "end": 33.4
  },
  {
   "n": 9,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "그냥 쓰레기로 버리면 되는 것 아닐까요?",
   "start": 33.85,
   "end": 36.07
  },
  {
   "n": 10,
   "role": "host",
   "part": "버려진 캐리어",
   "text": "그 이유는 아래 영상에서 확인하세요.",
   "start": 36.52,
   "end": 38.68
  }
 ],
