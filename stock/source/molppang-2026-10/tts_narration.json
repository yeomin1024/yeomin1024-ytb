 "items": [
  {
   "n": 1,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "최근에 AI와 관련된 주식 종목을 찾아보다가 몽고디비라는 종목을 알게 되었어요.",
   "start": 0.3,
   "end": 8.11
  },
  {
   "n": 2,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "투자 전망도 좋고 실적도 잘 나오고 주가 상승세도 좋았어요.",
   "start": 8.56,
   "end": 15.31
  },
  {
   "n": 3,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "그래서 좋은 종목이라고 확신하고 전 재산 7천만 원을 이 종목에 몰빵했었죠.",
   "start": 15.76,
   "end": 21.5
  },
  {
   "n": 4,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "매수하고 나서 천만 원 정도 수익이 나서 정말 기분이 좋았어요.",
   "start": 21.95,
   "end": 26.33
  },
  {
   "n": 5,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "전고점을 생각하면 더 상승할 것 같았죠.",
   "start": 26.78,
   "end": 30.27
  },
  {
   "n": 6,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "하지만 그건 달콤한 꿈일 뿐이었습니다.",
   "start": 30.72,
   "end": 33.98
  },
  {
   "n": 7,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "어느 날 계좌를 확인해 보니 갑자기 -2천만 원이 찍힌 겁니다.",
   "start": 34.43,
   "end": 39.52
  },
  {
   "n": 8,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "도대체 무슨 일인가 찾아보니 CEO가 다른 회사로 이적했다는 소식이었어요.",
   "start": 39.97,
   "end": 45.62
  },
  {
   "n": 9,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "안 그래도 고점에서 내려오던 주가가 그 소식에 최대 -26%까지 폭락했다는 거예요.",
   "start": 46.07,
   "end": 53.48
  },
  {
   "n": 10,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "물타기 할 돈도 없는데 하필이면 제가 매수한 다음에 이런 일이 일어나다니요.",
   "start": 53.93,
   "end": 60.86
  },
  {
   "n": 11,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "이 세상은 저한테 너무 가혹한 것 같아요.",
   "start": 61.31,
   "end": 64.72
  },
  {
   "n": 12,
   "role": "host",
   "part": "진행자 파트",
   "text": "앞의 사연과 같이",
   "start": 65.72,
   "end": 67.14
  },
  {
   "n": 13,
   "role": "host",
   "part": "진행자 파트",
   "text": "이 종목은 전망이 좋으니까 몰빵하면 많이 오르겠지?",
   "start": 67.59,
   "end": 70.63
  },
  {
   "n": 14,
   "role": "host",
   "part": "진행자 파트",
   "text": "여러 종목에 나눠 사면 수익이 줄어드니까 한 종목에 다 넣어야지.",
   "start": 71.08,
   "end": 75.76
  },
  {
   "n": 15,
   "role": "host",
   "part": "진행자 파트",
   "text": "혹시 떨어져도 좋은 종목이니까 금방 다시 오르겠지.",
   "start": 76.21,
   "end": 79.5
  },
  {
   "n": 16,
   "role": "host",
   "part": "진행자 파트",
   "text": "이런 식으로 자신이 좋다고 생각하는 종목에 전 재산을 몰빵하는 분들 꽤 있으실 겁니다.",
   "start": 79.95,
   "end": 85.82
  },
  {
   "n": 17,
   "role": "host",
   "part": "진행자 파트",
   "text": "과연 이렇게 몰빵 투자를 하는 사람들이 생각대로 큰 수익을 얻을 수 있을까요?",
   "start": 86.27,
   "end": 90.74
  },
  {
   "n": 18,
   "role": "host",
   "part": "진행자 파트",
   "text": "한번 문제가 뭔지 알아보겠습니다.",
   "start": 91.19,
   "end": 93.33
  },
  {
   "n": 19,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "첫 번째이자 가장 큰 문제는 몰빵한 종목이 하락하면 대처할 방법이 없다는 것입니다.",
   "start": 101.33,
   "end": 107.11
  },
  {
   "n": 20,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사람 일이 어떻게 될지 모르듯이 앞으로 어떻게 움직일지 모르는 게 주식입니다.",
   "start": 107.56,
   "end": 112.63
  },
  {
   "n": 21,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "장기적으로는 상승할 수 있어도 사연과 같이 단기적으로 갑자기 큰 악재가 발생할 수 있습니다.",
   "start": 113.08,
   "end": 119.54
  },
  {
   "n": 22,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "최근 상승세를 보고 매수하거나 기존에 수익을 보고 있던 투자자들도 큰 손해를 볼 수 있는 것이죠.",
   "start": 119.99,
   "end": 126.46
  },
  {
   "n": 23,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "이런 사례는 메타, 구글, 엔비디아 같은 빅테크에서도 일어났어요.",
   "start": 126.91,
   "end": 132.24
  },
  {
   "n": 24,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2022년 메타는 실적 실망으로 하루에 26% 빠졌습니다.",
   "start": 132.69,
   "end": 137.4
  },
  {
   "n": 25,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2023년 구글은 AI 챗봇 광고 속 오답 하나로 장중 9% 빠졌고요.",
   "start": 137.85,
   "end": 143.39
  },
  {
   "n": 26,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2025년 엔비디아는 중국 AI 기업 딥시크의 등장으로 하루에 17% 빠졌습니다.",
   "start": 143.84,
   "end": 149.76
  },
  {
   "n": 27,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "당시 미국 증시 역사상 하루 기준 가장 큰 시가총액 손실이었죠.",
   "start": 150.21,
   "end": 154.57
  },
  {
   "n": 28,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "이런 폭락은 전문가들조차 미리 알기 어렵습니다.",
   "start": 155.02,
   "end": 158.59
  },
  {
   "n": 29,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "실제로 메타가 폭락하기 직전, 팔라는 의견을 낸 애널리스트는 단 2명뿐이었습니다.",
   "start": 159.04,
   "end": 164.91
  },
  {
   "n": 30,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "문제는 몰빵한 상태에서 이런 일이 터지면 선택지가 없다는 겁니다.",
   "start": 165.36,
   "end": 169.84
  },
  {
   "n": 31,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "현금이 없으니 물타기도 못 하고, 손절하면 손실이 그대로 확정되죠.",
   "start": 170.29,
   "end": 175.0
  },
  {
   "n": 32,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "게다가 미리 정해 둔 손절 라인도 소용없을 수 있습니다.",
   "start": 175.45,
   "end": 179.23
  },
  {
   "n": 33,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "장 시작 전에 악재가 터지면 주가가 그보다 훨씬 아래에서 시작하니까요.",
   "start": 179.68,
   "end": 184.28
  },
  {
   "n": 34,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "두 번째는 그렇다고 버티는 것도 답이 아니라는 것입니다.",
   "start": 184.73,
   "end": 188.23
  },
  {
   "n": 35,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "한 번 크게 잃으면 되찾기가 훨씬 어렵기 때문이죠.",
   "start": 188.68,
   "end": 191.69
  },
  {
   "n": 36,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사연처럼 7천만 원이 5천만 원이 되면 원금을 되찾는 데 40%가 올라야 합니다.",
   "start": 192.14,
   "end": 197.32
  },
  {
   "n": 37,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "반토막이 나면 두 배가 올라야 본전이고, 70% 빠지면 세 배 넘게 올라야 합니다.",
   "start": 197.77,
   "end": 203.82
  },
  {
   "n": 38,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "몰빵은 이 위험을 계좌 전체로 떠안는 일입니다.",
   "start": 204.27,
   "end": 207.5
  },
  {
   "n": 39,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "세 번째는 한 종목으로 큰 수익을 낼 확률 자체가 낮다는 것입니다.",
   "start": 207.95,
   "end": 212.21
  },
  {
   "n": 40,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "자본시장연구원이 2023년 말까지 10년간 국내 상장사의 주식 수익률을 분석했는데요.",
   "start": 212.66,
   "end": 219.17
  },
  {
   "n": 41,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "절반이 넘는 52%가 1년짜리 안전한 채권에 넣어 둔 것보다 못 벌었습니다.",
   "start": 219.62,
   "end": 224.91
  },
  {
   "n": 42,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "시가총액 상위 30% 대형주만 보면 이 비율이 58%로 오히려 더 높았죠.",
   "start": 225.36,
   "end": 231.74
  },
  {
   "n": 43,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2026년 코스피가 두 배 넘게 오른 6월까지, 지수를 이긴 종목은 4%도 안 됐죠.",
   "start": 232.19,
   "end": 238.11
  },
  {
   "n": 44,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "한 종목에 몰빵한다는 건 이 4%를 정확히 골라야 한다는 뜻입니다.",
   "start": 238.56,
   "end": 243.01
  },
  {
   "n": 45,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2021년 고점을 찍은 엔씨소프트와 LG생활건강은 지금 70% 넘게 빠져 있습니다.",
   "start": 243.46,
   "end": 249.87
  },
  {
   "n": 46,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "5년이 넘도록 그 고점을 한 번도 되찾지 못했죠.",
   "start": 250.32,
   "end": 253.31
  },
  {
   "n": 47,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그사이 코스피는 2021년 고점의 두 배 수준까지 올랐는데 말이죠.",
   "start": 253.76,
   "end": 258.02
  },
  {
   "n": 48,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그런데도 몰빵 성공담만 들리는 건, 크게 잃은 사람들은 조용히 떠나기 때문이죠.",
   "start": 258.47,
   "end": 263.89
  },
  {
   "n": 49,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "네 번째는 몰빵이 판단력까지 무너뜨린다는 것입니다.",
   "start": 264.34,
   "end": 268.02
  },
  {
   "n": 50,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사람은 원래 잃는 것에 훨씬 예민합니다.",
   "start": 268.47,
   "end": 270.92
  },
  {
   "n": 51,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "연구에 따르면 잃을 때의 고통은 같은 금액을 얻을 때의 기쁨보다 두 배 정도 큽니다.",
   "start": 271.37,
   "end": 276.53
  },
  {
   "n": 52,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "전 재산이 걸려 있으면 그 고통이 매일 찾아오죠.",
   "start": 276.98,
   "end": 280.36
  },
  {
   "n": 53,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "하루에도 수십 번 앱을 열고, 밤에는 미국 장을 지켜보느라 잠을 설치게 됩니다.",
   "start": 280.81,
   "end": 285.83
  },
  {
   "n": 54,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그러다 보면 팔아야 할 때 못 팔고, 기다려야 할 때 못 기다리게 됩니다.",
   "start": 286.28,
   "end": 291.09
  },
  {
   "n": 55,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그렇다면 어떻게 투자해야 할까요?",
   "start": 291.54,
   "end": 293.56
  },
  {
   "n": 56,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "핵심은 큰 수익을 한 번에 얻겠다는 욕심을 버리고 나눠 담는 것입니다.",
   "start": 294.56,
   "end": 298.93
  },
  {
   "n": 57,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "구체적으로 다섯 가지만 기억하세요.",
   "start": 299.38,
   "end": 301.67
  },
  {
   "n": 58,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "첫째, 한 종목이 내 계좌에서 차지하는 비중의 상한을 정하세요.",
   "start": 302.12,
