{"id": "Ugzj0zOp6-2lTFJQ3rF4AaABAg.AbKxKzeuGxqAbLO6meitTn", "parent": "Ugzj0zOp6-2lTFJQ3rF4AaABAg", "likes": 4, "text": "저도 그렇게 생각합니다.", "published": "2026-09-29T13:34:51", "replies": 0, "creator": false}
