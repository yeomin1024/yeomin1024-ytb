 "items": [
  {
   "n": 1,
   "role": "host",
   "part": "도입",
   "text": "폭락 뒤 반등을 보고 큰돈을 매수했다가 다시 물린 분들 많으실 겁니다.",
   "start": 0.3,
   "end": 4.63
  },
  {
   "n": 2,
   "role": "host",
   "part": "도입",
   "text": "이제 오르나 싶었는데, 손실만 더 커졌죠.",
   "start": 5.01,
   "end": 7.695
  },
  {
   "n": 3,
   "role": "host",
   "part": "도입",
   "text": "매도하자니 바로 반등할까 두렵습니다.",
   "start": 8.075,
   "end": 10.208
  },
  {
   "n": 4,
   "role": "host",
   "part": "도입",
   "text": "그렇다고 버티자니 더 떨어질까 두렵고요.",
   "start": 10.588,
   "end": 12.908
  },
  {
   "n": 5,
   "role": "host",
   "part": "도입",
   "text": "실제로 2022년 5월 4일, 미국 증시는 하루 3% 넘게 반등했습니다.",
   "start": 13.288,
   "end": 18.544
  },
  {
   "n": 6,
   "role": "host",
   "part": "도입",
   "text": "그날 바닥이라고 생각하고 매수했다면 어떻게 됐을까요?",
   "start": 18.924,
   "end": 21.917
  },
  {
   "n": 7,
   "role": "host",
   "part": "도입",
   "text": "6월 16일까지 약 14.5%가 더 하락했습니다.",
   "start": 22.297,
   "end": 25.767
  },
  {
   "n": 8,
   "role": "host",
   "part": "도입",
   "text": "1천만 원을 매수했다면 약 145만 원이 사라진 겁니다.",
   "start": 26.147,
   "end": 29.723
  },
  {
   "n": 9,
   "role": "host",
   "part": "도입",
   "text": "그렇다면 반등이 진짜인지 미리 구별할 방법은 없을까요?",
   "start": 30.103,
   "end": 33.513
  },
  {
   "n": 10,
   "role": "host",
   "part": "도입",
   "text": "전문가들이 사용하는 지표부터 확인해 보겠습니다.",
   "start": 33.893,
   "end": 36.583
  },
  {
   "n": 11,
   "role": "host",
   "part": "판별법",
   "text": "주식 차트에서 많이 보는 것이 이동평균선과 거래량입니다.",
   "start": 37.583,
   "end": 41.263
  },
  {
   "n": 12,
   "role": "host",
   "part": "판별법",
   "text": "20일 이동평균선은 최근 20거래일 주가의 평균입니다.",
   "start": 41.643,
   "end": 45.323
  },
  {
   "n": 13,
   "role": "host",
   "part": "판별법",
   "text": "거래량은 그날 거래된 주식의 수를 말하죠.",
   "start": 45.703,
   "end": 48.352
  },
  {
   "n": 14,
   "role": "host",
   "part": "판별법",
   "text": "이번에는 두 조건으로 반등을 구분하겠습니다.",
   "start": 48.732,
   "end": 51.412
  },
  {
   "n": 15,
   "role": "host",
   "part": "판별법",
   "text": "반등 후 10거래일 안에 주가가 20일선 위로 올라서야 합니다.",
   "start": 51.792,
   "end": 55.649
  },
  {
   "n": 16,
   "role": "host",
   "part": "판별법",
   "text": "그날 거래량도 직전 20거래일 평균보다 많아야 합니다.",
   "start": 56.029,
   "end": 59.209
  },
  {
   "n": 17,
   "role": "host",
   "part": "판별법",
   "text": "두 조건을 충족하면 진짜 반등 신호로 보겠습니다.",
   "start": 59.589,
   "end": 62.559
  },
  {
   "n": 18,
   "role": "host",
   "part": "판별법",
   "text": "아니면 가짜 반등 신호로 분류하겠습니다.",
   "start": 62.939,
   "end": 65.276
  },
  {
   "n": 19,
   "role": "host",
   "part": "판별법",
   "text": "실제 결과는 이후 약 6개월을 기준으로 확인했습니다.",
   "start": 65.656,
   "end": 68.899
  },
  {
   "n": 20,
   "role": "host",
   "part": "판별법",
   "text": "반등 전 20거래일의 최저 종가를 깨면 가짜로 정했습니다.",
   "start": 69.279,
   "end": 73.225
  },
  {
   "n": 21,
   "role": "host",
   "part": "판별법",
   "text": "분석 대상은 미국 S&P 500을 추종하는 SPY입니다.",
   "start": 73.605,
   "end": 77.486
  },
  {
   "n": 22,
   "role": "host",
   "part": "판별법",
   "text": "과연 이 방법이 통했을까요?",
   "start": 77.866,
   "end": 79.586
  },
  {
   "n": 23,
   "role": "host",
   "part": "판별법",
   "text": "-2020년 폭락",
   "start": 79.966,
   "end": 81.605
  },
  {
   "n": 24,
   "role": "host",
   "part": "판별법",
   "text": "2020년 2월 19일, 미국 증시는 최고가를 기록했습니다.",
   "start": 81.985,
   "end": 86.168
  },
  {
   "n": 25,
   "role": "host",
   "part": "판별법",
   "text": "하지만 코로나 충격으로 열흘도 안 돼 12.4% 하락했습니다.",
   "start": 86.548,
   "end": 90.268
  },
  {
   "n": 26,
   "role": "host",
   "part": "판별법",
   "text": "그러다 3월 2일, 하루 만에 4.3% 반등했죠.",
   "start": 90.648,
   "end": 94.155
  },
  {
   "n": 27,
   "role": "host",
   "part": "판별법",
   "text": "거래량도 평소의 두 배가 넘었습니다.",
   "start": 94.535,
   "end": 96.635
  },
  {
   "n": 28,
   "role": "host",
   "part": "판별법",
   "text": "바닥을 찍고 다시 오르는 것처럼 보였죠.",
   "start": 97.015,
   "end": 99.445
  },
  {
   "n": 29,
   "role": "host",
   "part": "판별법",
   "text": "하지만 주가는 20일선 위로 올라서지 못했습니다.",
   "start": 99.825,
   "end": 102.755
  },
  {
   "n": 30,
   "role": "host",
   "part": "판별법",
   "text": "결국 3월 9일, 이전 저점을 깨고 하루 7.8% 하락했습니다.",
   "start": 103.135,
   "end": 107.645
  },
  {
   "n": 31,
   "role": "host",
   "part": "판별법",
   "text": "3월 23일에는 반등한 날보다 27.4%나 더 떨어졌죠.",
   "start": 108.025,
   "end": 112.265
  },
  {
   "n": 32,
   "role": "host",
   "part": "판별법",
   "text": "이때는 지표가 가짜 반등을 정확히 맞혔습니다.",
   "start": 112.645,
   "end": 115.405
  },
  {
   "n": 33,
   "role": "host",
   "part": "판별법",
   "text": "그럼 이 지표를 믿고 매수하면 될까요?",
   "start": 115.785,
   "end": 118.28
  },
  {
   "n": 34,
   "role": "host",
   "part": "판별법",
   "text": "2008년에는 정반대의 일이 벌어졌습니다.",
   "start": 118.66,
   "end": 121.035
  },
  {
   "n": 35,
   "role": "host",
   "part": "판별법",
   "text": "-2008년 금융위기",
   "start": 121.415,
   "end": 123.291
  },
  {
   "n": 36,
   "role": "host",
   "part": "판별법",
   "text": "2008년 3월 11일, 연준이 금융시장 지원책을 발표했습니다.",
   "start": 123.671,
   "end": 127.871
  },
  {
   "n": 37,
   "role": "host",
   "part": "판별법",
   "text": "그러자 SPY가 하루 만에 3.6% 반등했습니다.",
   "start": 128.251,
   "end": 131.85
  },
  {
   "n": 38,
   "role": "host",
   "part": "판별법",
   "text": "일주일 뒤에는 기준금리 인하로 4.2% 더 올랐죠.",
   "start": 132.23,
   "end": 135.74
  },
  {
   "n": 39,
   "role": "host",
   "part": "판별법",
   "text": "이때는 거래량이 늘었고, 주가도 20일선 위로 올라섰습니다.",
   "start": 136.12,
   "end": 140.021
  },
  {
   "n": 40,
   "role": "host",
   "part": "판별법",
   "text": "앞에서 정한 기준으로는 진짜 반등 신호였습니다.",
   "start": 140.401,
   "end": 143.601
  },
  {
   "n": 41,
   "role": "host",
   "part": "판별법",
   "text": "실제로 5월까지 상승세가 이어졌습니다.",
   "start": 143.981,
   "end": 146.636
  },
  {
   "n": 42,
   "role": "host",
   "part": "판별법",
   "text": "하지만 반등은 오래가지 못했습니다.",
   "start": 147.016,
   "end": 149.127
  },
  {
   "n": 43,
   "role": "host",
   "part": "판별법",
   "text": "7월 2일, 주가는 다시 3월의 저점 아래로 떨어졌습니다.",
   "start": 149.507,
   "end": 153.257
  },
  {
   "n": 44,
   "role": "host",
   "part": "판별법",
   "text": "이듬해 3월에는 반등한 날보다 47.4%나 하락했죠.",
   "start": 153.637,
   "end": 157.734
  },
  {
   "n": 45,
   "role": "host",
   "part": "판별법",
   "text": "지표를 믿고 큰돈을 매수했다면 막대한 손실이었습니다.",
   "start": 158.114,
   "end": 161.727
  },
  {
   "n": 46,
   "role": "host",
   "part": "판별법",
   "text": "그런데 반대로 지표를 믿어서 기회를 놓친 경우도 있습니다.",
   "start": 162.107,
   "end": 165.406
  },
  {
   "n": 47,
   "role": "host",
   "part": "판별법",
   "text": "-2025년 관세 충격",
   "start": 165.786,
   "end": 167.981
  },
  {
   "n": 48,
   "role": "host",
   "part": "판별법",
   "text": "2025년 4월, 미국 증시는 관세 충격으로 급락했습니다.",
   "start": 168.361,
   "end": 172.485
  },
  {
   "n": 49,
   "role": "host",
   "part": "판별법",
   "text": "그러다 4월 9일, 미국이 관세 유예를 발표했습니다.",
   "start": 172.865,
   "end": 176.375
  },
  {
   "n": 50,
   "role": "host",
   "part": "판별법",
   "text": "중국을 제외한 국가의 높은 상호관세를 90일 유예했죠.",
   "start": 176.755,
   "end": 180.445
  },
  {
   "n": 51,
   "role": "host",
   "part": "판별법",
   "text": "이날 SPY는 무려 10.5% 상승했습니다.",
   "start": 180.825,
   "end": 183.855
  },
  {
   "n": 52,
   "role": "host",
   "part": "판별법",
   "text": "하지만 이후 2주 동안 지표는 진짜 반등 신호를 주지 않았습니다.",
   "start": 184.235,
   "end": 187.885
  },
  {
   "n": 53,
   "role": "host",
   "part": "판별법",
   "text": "기준대로라면 가짜 반등이었던 겁니다.",
   "start": 188.265,
   "end": 190.505
  },
  {
   "n": 54,
   "role": "host",
   "part": "판별법",
   "text": "그런데 이번에는 달랐습니다.",
   "start": 190.885,
   "end": 192.425
  },
  {
   "n": 55,
   "role": "host",
   "part": "판별법",
   "text": "미국과 중국이 관세를 낮추기로 합의했고, 증시는 상승했습니다.",
   "start": 192.805,
   "end": 196.994
  },
  {
   "n": 56,
   "role": "host",
   "part": "판별법",
   "text": "결국 6월에는 이전 최고가까지 되찾았습니다.",
   "start": 197.374,
   "end": 200.311
  },
  {
   "n": 57,
   "role": "host",
   "part": "판별법",
   "text": "가짜 반등이라고 확신했다면 상승 기회를 놓칠 수도 있었죠.",
   "start": 200.691,
   "end": 204.291
  },
  {
   "n": 58,
   "role": "host",
   "part": "판별법",
   "text": "이처럼 지표는 맞을 때도 있고 틀릴 때도 있습니다.",
   "start": 204.671,
   "end": 207.462
  },
  {
   "n": 59,
   "role": "host",
   "part": "판별법",
   "text": "그렇다면 전체 적중률은 얼마나 될까요?",
   "start": 207.842,
   "end": 210.1
  },
  {
   "n": 60,
   "role": "host",
   "part": "판별법",
   "text": "-20번의 반등",
   "start": 210.48,
   "end": 211.928
  },
  {
   "n": 61,
   "role": "host",
   "part": "판별법",
   "text": "2000년부터 2025년까지 SPY의 반등 20번을 분석했습니다.",
   "start": 212.308,
   "end": 217.479
  },
  {
   "n": 62,
   "role": "host",
   "part": "판별법",
   "text": "고점에서 10% 넘게 하락한 뒤 하루 3% 넘게 오른 경우입니다.",
   "start": 217.859,
   "end": 222.269
  },
  {
   "n": 63,
   "role": "host",
   "part": "판별법",
   "text": "가까운 시기의 반등은 중복되지 않도록 제외했습니다.",
   "start": 222.649,
   "end": 225.881
  },
  {
   "n": 64,
   "role": "host",
   "part": "판별법",
   "text": "앞서 설명한 지표는 20번 중 13번을 맞혔습니다.",
   "start": 226.261,
   "end": 229.451
  },
  {
   "n": 65,
   "role": "host",
   "part": "판별법",
   "text": "그런데 여기에는 중요한 함정이 있습니다.",
   "start": 229.831,
   "end": 232.411
  },
  {
   "n": 66,
   "role": "host",
   "part": "판별법",
   "text": "아무런 지표 없이 전부 가짜 반등이라고 했다면 어떨까요?",
   "start": 232.791,
   "end": 236.106
  },
  {
   "n": 67,
   "role": "host",
   "part": "판별법",
   "text": "오히려 20번 중 15번을 맞혔을 겁니다.",
   "start": 236.486,
   "end": 239.0
  },
  {
   "n": 68,
   "role": "host",
   "part": "판별법",
   "text": "실제로 가짜 반등이 15번이나 있었기 때문입니다.",
   "start": 239.38,
   "end": 242.341
  },
  {
   "n": 69,
   "role": "host",
   "part": "판별법",
   "text": "이번 지표는 단순히 가짜라고 판단하는 것보다 못했습니다.",
   "start": 242.721,
   "end": 246.109
  },
  {
   "n": 70,
   "role": "host",
   "part": "판별법",
   "text": "이 결과만으로는 지표가 유용하다고 보기 어렵습니다.",
   "start": 246.489,
   "end": 249.895
  },
  {
   "n": 71,
   "role": "host",
   "part": "판별법",
   "text": "다른 지표를 쓰더라도 미래를 확신할 수는 없습니다.",
   "start": 250.275,
   "end": 253.242
  },
  {
   "n": 72,
   "role": "host",
   "part": "판별법",
   "text": "그렇다면 폭락할 때 우리는 어떻게 대응해야 할까요?",
   "start": 253.622,
   "end": 256.72
  },
  {
   "n": 73,
   "role": "host",
   "part": "전문가의 대응",
   "text": "2020년 코로나 폭락 때, 투자자 하워드 막스가 글을 남겼습니다.",
   "start": 257.72,
   "end": 262.217
  },
  {
   "n": 74,
   "role": "host",
   "part": "전문가의 대응",
   "text": "그는 바닥이 어디인지 알 수 없다고 했습니다.",
   "start": 262.597,
   "end": 264.981
  },
  {
   "n": 75,
   "role": "host",
   "part": "전문가의 대응",
   "text": "몇 달 뒤에는 주가가 훨씬 더 떨어질 수도 있다고 했죠.",
   "start": 265.361,
   "end": 268.34
  },
  {
   "n": 76,
   "role": "host",
   "part": "전문가의 대응",
   "text": "하지만 그렇다고 매수를 전부 미룰 이유도 없다고 했습니다.",
   "start": 268.72,
   "end": 271.804
  },
  {
   "n": 77,
   "role": "host",
   "part": "전문가의 대응",
   "text": "반대로 오늘 모든 돈을 매수에 투입할 이유도 없다고 했죠.",
   "start": 272.184,
   "end": 275.563
  },
  {
   "n": 78,
   "role": "host",
   "part": "전문가의 대응",
   "text": "핵심은 바닥을 맞히는 것이 아닙니다.",
   "start": 275.943,
   "end": 277.97
  },
  {
   "n": 79,
   "role": "host",
   "part": "전문가의 대응",
   "text": "매수할 금액을 나누고 추가 하락에 대비하는 겁니다.",
   "start": 278.35,
   "end": 281.367
  },
  {
   "n": 80,
   "role": "host",
   "part": "전문가의 대응",
   "text": "이 원칙을 참고해 SPY의 과거 반등을 시험했습니다.",
   "start": 281.747,
   "end": 285.047
  },
  {
   "n": 81,
   "role": "host",
   "part": "전문가의 대응",
   "text": "먼저 여유 현금이 있는 경우부터 보겠습니다.",
   "start": 285.427,
   "end": 287.809
  },
  {
   "n": 82,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "반등을 봤다고 투자할 돈을 한 번에 모두 넣을 필요는 없습니다.",
   "start": 288.809,
   "end": 292.175
  },
  {
   "n": 83,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "실험에서는 먼저 투자 예정금의 5%만 매수했습니다.",
   "start": 292.555,
   "end": 296.075
  },
  {
   "n": 84,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "이후 평단보다 10% 하락할 때마다 5%씩 추가 매수했습니다.",
   "start": 296.455,
   "end": 300.619
  },
  {
   "n": 85,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "이전 최고가를 회복하면 남은 현금도 투입했습니다.",
   "start": 300.999,
   "end": 304.239
  },
  {
   "n": 86,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "이렇게 했을 때 과거 성적은 어땠을까요?",
   "start": 304.619,
   "end": 306.912
  },
  {
   "n": 87,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "1년간 계좌가 원금보다 20% 넘게 하락한 경우는 한 번이었습니다.",
   "start": 307.292,
   "end": 311.392
  },
  {
   "n": 88,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "처음부터 전액 매수했다면 여덟 번이었죠.",
   "start": 311.772,
   "end": 314.202
  },
  {
   "n": 89,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "물론 현금을 많이 남겨둔 효과가 컸습니다.",
   "start": 314.582,
   "end": 316.952
  },
  {
   "n": 90,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "또 2008년에는 이 계획으로도 큰 손실이 발생했습니다.",
   "start": 317.332,
   "end": 321.001
  },
  {
   "n": 91,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "따라서 5%나 10%가 정답이라는 뜻은 아닙니다.",
   "start": 321.381,
   "end": 324.715
  },
  {
   "n": 92,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "중요한 건 추가 하락에 쓸 현금을 남겨두는 겁니다.",
   "start": 325.095,
   "end": 328.195
  },
  {
   "n": 93,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "반등했다고 한 번에 전액 매수하면 대응할 여지가 줄어듭니다.",
   "start": 328.575,
   "end": 332.003
  },
  {
   "n": 94,
   "role": "host",
   "part": "현금이 남아 있다면",
   "text": "그런데 이미 대부분의 돈을 매수했다면 어떨까요?",
   "start": 332.383,
   "end": 335.181
  },
  {
   "n": 95,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "이미 물린 분들은 상황이 다릅니다.",
   "start": 336.181,
   "end": 338.281
  },
  {
   "n": 96,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "남은 현금이 별로 없어 추가 매수도 어렵습니다.",
   "start": 338.661,
   "end": 341.592
  },
  {
   "n": 97,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "그렇다고 지금 매도하자니 원금 회복이 아깝죠.",
   "start": 341.972,
   "end": 344.952
  },
  {
   "n": 98,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "방법은 크게 두 가지입니다.",
   "start": 345.332,
   "end": 346.902
  },
  {
   "n": 99,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "첫 번째는 추가 매수 없이 회복을 기다리는 겁니다.",
   "start": 347.282,
   "end": 350.26
  },
  {
   "n": 100,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "과거 SPY 반등 20번은 결국 모두 당시 매수가를 회복했습니다.",
   "start": 350.64,
   "end": 354.852
  },
  {
   "n": 101,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "하지만 가장 오래 걸린 사례는 약 6년이었습니다.",
   "start": 355.232,
   "end": 358.183
  },
  {
   "n": 102,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "그동안 더 큰 손실을 견뎌야 할 수도 있었죠.",
   "start": 358.563,
   "end": 360.936
  },
  {
   "n": 103,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "개별 종목이나 미래의 SPY도 회복한다는 보장은 없습니다.",
   "start": 361.316,
   "end": 365.011
  },
  {
   "n": 104,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "두 번째는 일부를 매도해 주식 비중부터 줄이는 겁니다.",
   "start": 365.391,
   "end": 368.699
  },
  {
   "n": 105,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "이 방법도 과거 SPY 자료로 시험해 봤습니다.",
   "start": 369.079,
   "end": 371.789
  },
  {
   "n": 106,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "처음 주식 80%, 현금 20%인 가상 계좌를 만들었습니다.",
   "start": 372.169,
   "end": 376.573
  },
  {
   "n": 107,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "평단보다 10% 하락하면 보유 주식의 절반을 매도했습니다.",
   "start": 376.953,
   "end": 380.812
  },
  {
   "n": 108,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "그 뒤 매도가보다 10%, 20%, 30% 더 하락하면 나눠 매수했습니다.",
   "start": 381.192,
   "end": 386.857
  },
  {
   "n": 109,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "매도 후 남은 현금을 세 번에 나눠 투입하는 방식입니다.",
   "start": 387.237,
   "end": 390.513
  },
  {
   "n": 110,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "그럼 결과는 어땠을까요?",
   "start": 390.893,
   "end": 392.546
  },
  {
   "n": 111,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "그냥 보유한 경우, 1년 안에 큰 손실이 발생한 건 다섯 번이었습니다.",
   "start": 392.926,
   "end": 397.296
  },
  {
   "n": 112,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "절반을 매도하는 방법은 두 번이었죠.",
   "start": 397.676,
   "end": 399.774
  },
  {
   "n": 113,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "3년으로 늘리면 보유는 일곱 번, 절반 매도는 네 번이었습니다.",
   "start": 400.154,
   "end": 404.303
  },
  {
   "n": 114,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "대신 수익은 일부 포기해야 했습니다.",
   "start": 404.683,
   "end": 406.809
  },
  {
   "n": 115,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "3년 뒤 수익률의 중간값은 보유가 36.6%였습니다.",
   "start": 407.189,
   "end": 411.501
  },
  {
   "n": 116,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "절반 매도는 29.1%였죠.",
   "start": 411.881,
   "end": 414.391
  },
  {
   "n": 117,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "큰 손실을 줄이는 대신 수익도 줄어든 겁니다.",
   "start": 414.771,
   "end": 417.736
  },
  {
   "n": 118,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "물론 이 역시 과거 SPY의 가상 계좌 결과입니다.",
   "start": 418.116,
   "end": 421.486
  },
  {
   "n": 119,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "이미 다른 가격에 매수한 계좌를 시험한 것은 아닙니다.",
   "start": 421.866,
   "end": 424.867
  },
  {
   "n": 120,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "그러니 이 숫자를 그대로 따라야 한다는 뜻은 아닙니다.",
   "start": 425.247,
   "end": 428.207
  },
  {
   "n": 121,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "여기서 기억할 점은 하나입니다.",
   "start": 428.587,
   "end": 430.427
  },
  {
   "n": 122,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "손실을 만회하려고 남은 돈까지 무작정 매수하지 않는 겁니다.",
   "start": 430.807,
   "end": 434.417
  },
  {
   "n": 123,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "현금이 부족하고 손실을 감당하기 어렵다면 비중 축소도 방법입니다.",
   "start": 434.797,
   "end": 439.267
  },
  {
   "n": 124,
   "role": "host",
   "part": "이미 많이 물렸다면",
   "text": "추가 매수와 일부 매도는 모두 미리 기준을 정해두는 게 좋습니다.",
   "start": 439.647,
   "end": 443.327
  },
  {
   "n": 125,
   "role": "host",
   "part": "마무리",
   "text": "반등이 진짜인지 가짜인지는 지나고 나서야 확실해집니다.",
   "start": 444.327,
   "end": 447.777
  },
  {
   "n": 126,
   "role": "host",
   "part": "마무리",
   "text": "우리가 통제할 수 있는 건 주가가 아니라 투자할 금액입니다.",
   "start": 448.157,
   "end": 451.493
  },
  {
   "n": 127,
   "role": "host",
   "part": "마무리",
   "text": "반등했다고 전액 매수하지 마세요.",
   "start": 451.873,
   "end": 453.873
  },
  {
   "n": 128,
   "role": "host",
   "part": "마무리",
   "text": "추가 하락에 쓸 현금과 매수·매도 기준을 미리 정하세요.",
   "start": 454.253,
   "end": 457.603
  },
  {
   "n": 129,
   "role": "host",
   "part": "마무리",
   "text": "과거에 통했던 숫자도 미래의 수익을 보장하지는 않습니다.",
   "start": 457.983,
   "end": 461.329
  },
  {
   "n": 130,
   "role": "host",
   "part": "마무리",
   "text": "그럼 모두 성공 투자 하시기 바랍니다.",
   "start": 461.709,
   "end": 463.919
  },
  {
   "n": 131,
   "role": "host",
   "part": "마무리",
   "text": "시청해주셔서 감사합니다.",
   "start": 464.299,
   "end": 465.829
  }
 ],
