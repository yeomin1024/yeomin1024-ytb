# 비밀 정보 — 절대 커밋하지 않음
.env
cookies*.txt

# 실행 산출물 (결과는 스크립트가 GitHub의 <PROJECT_FOLDER>/<RESULT_FOLDER>로 따로 푸시함)
output/
.yt_work/

# 파이썬 환경
.venv/
venv/
__pycache__/
*.pyc
# 영상 제작 (Remotion) — 렌더 결과 영상은 용량이 커서 올리지 않음 (썸네일·스토리보드 이미지는 올림)
node_modules/
**/out/**/*.mp4
**/out/**/*.mov
# 업로드 도구가 만드는 썸네일 변환본 (원본은 source/<영상ID>/thumbnails/)
**/out/**/*_upload.jpg
# 완성 영상 원본(out/)은 올리지 않고, 압축본 <주제>/source/<영상ID>/final_1080p.mp4 만 올림 (tools/compress_video.py, 사용자 지시 2026-10-15)
video/.remotion/
# 실행기(run_analyzer)가 받는 중인 임시 파일·설정 백업
*.download
*.toml.bak
video/public/fonts/
video/public/audio/
*.srt.bak-*
# Claude Code 임시 작업 공간 (에이전트 worktree) — 커밋하지 않음
.claude/worktrees/
# 성공 사례 수집(tools/outlier_research.py)·웹 화면: 사례 폴더(01_·P01_·W_ — 설명·자막·댓글·썸네일)는 공개 저장소에도 올림
# (사용자 지시 2026-10-14 "그냥 공개에서 다 올리도록 해" — 분석기 v2.9.3). API 캐시·빠진 사례·탐색 목록만 PC 에
*/result/outliers/.cache/
*/result/outliers/_old/
*/result/web/
