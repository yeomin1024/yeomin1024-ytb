 "items": [
  {
   "n": 1,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "2026년 3월 4일, 코스피가 하루 만에 12% 넘게 떨어졌어요.",
   "start": 0.3,
   "end": 5.71
  },
  {
   "n": 2,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "저는 그 닷새 전 4천만 원으로 삼성전자를 샀어요.",
   "start": 6.16,
   "end": 10.85
  },
  {
   "n": 3,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "반도체가 잘 팔린다는 뉴스를 보고 오래 들고 갈 생각이었죠.",
   "start": 11.3,
   "end": 16.7
  },
  {
   "n": 4,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "그런데 산 다음 날, 미국과 이스라엘이 이란을 공격했어요.",
   "start": 17.15,
   "end": 21.44
  },
  {
   "n": 5,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "연휴 뒤 첫 거래일인 3월 3일, 계좌는 -400만 원이 됐어요.",
   "start": 21.89,
   "end": 27.12
  },
  {
   "n": 6,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "그래도 금방 회복하겠지 하고 버텼죠.",
   "start": 27.57,
   "end": 30.03
  },
  {
   "n": 7,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "하지만 다음 날은 차원이 달랐습니다.",
   "start": 30.48,
   "end": 32.94
  },
  {
   "n": 8,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "오전 11시쯤에는 서킷브레이커로 시장 전체의 거래가 20분 동안 멈췄어요.",
   "start": 33.39,
   "end": 40.17
  },
  {
   "n": 9,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "계좌는 어느새 -800만 원이 넘어 있었고요.",
   "start": 40.62,
   "end": 44.59
  },
  {
   "n": 10,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "전쟁이 커지면서 유가와 환율이 치솟는다는 뉴스가 쏟아졌어요.",
   "start": 45.04,
   "end": 49.82
  },
  {
   "n": 11,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "이러다 전부 잃겠다는 생각에 장 마감 직전 모두 팔았어요.",
   "start": 50.27,
   "end": 54.8
  },
  {
   "n": 12,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "그런데 바로 다음 날 삼성전자는 11% 넘게 올랐습니다.",
   "start": 55.25,
   "end": 60.67
  },
  {
   "n": 13,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "7주 뒤에는 제가 판 가격보다 30% 넘게 올라 있었어요.",
   "start": 61.12,
   "end": 67.1
  },
  {
   "n": 14,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "처음 산 가격도 이미 넘어 있었죠.",
   "start": 67.55,
   "end": 70.71
  },
  {
   "n": 15,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "시장이 빼앗아 간 게 아니라, 제가 겁에 질려 내던진 800만 원이었어요.",
   "start": 71.16,
   "end": 77.61
  },
  {
   "n": 16,
   "role": "storyteller",
   "part": "사연 파트",
   "text": "다음 날 빨갛게 오른 주가를 보면서 한참 동안 아무것도 할 수 없었어요.",
   "start": 78.06,
   "end": 83.06
  },
  {
   "n": 17,
   "role": "host",
   "part": "진행자 파트",
   "text": "시장 전체가 무너지는 날이면 많은 분들이 이런 생각을 하죠.",
   "start": 84.06,
   "end": 87.45
  },
  {
   "n": 18,
   "role": "host",
   "part": "진행자 파트",
   "text": "이러다 정말 0원이 되는 거 아니야?",
   "start": 87.9,
   "end": 90.07
  },
  {
   "n": 19,
   "role": "host",
   "part": "진행자 파트",
   "text": "일단 팔고 잠잠해지면 다시 사면 되지.",
   "start": 90.52,
   "end": 93.15
  },
  {
   "n": 20,
   "role": "host",
   "part": "진행자 파트",
   "text": "뉴스마다 더 떨어진다고 하잖아.",
   "start": 93.6,
   "end": 95.73
  },
  {
   "n": 21,
   "role": "host",
   "part": "진행자 파트",
   "text": "이런 식으로 겁이 판단을 앞서면, 가격이 가장 낮을 때 가장 많이 팔게 됩니다.",
   "start": 96.18,
   "end": 101.13
  },
  {
   "n": 22,
   "role": "host",
   "part": "진행자 파트",
   "text": "실제로 3월 4일, 변동성 지수 VKOSPI는 80을 넘어 사상 최고였습니다.",
   "start": 101.58,
   "end": 107.23
  },
  {
   "n": 23,
   "role": "host",
   "part": "진행자 파트",
   "text": "시장이 느끼는 공포를 숫자로 보여 주는 지수죠.",
   "start": 107.68,
   "end": 110.42
  },
  {
   "n": 24,
   "role": "host",
   "part": "진행자 파트",
   "text": "코스피 하루 거래대금도 58조 원을 넘어 사상 최대였습니다.",
   "start": 110.87,
   "end": 115.24
  },
  {
   "n": 25,
   "role": "host",
   "part": "진행자 파트",
   "text": "그날 두려움에 떤 사람이 사연자 혼자가 아니었던 겁니다.",
   "start": 115.69,
   "end": 119.28
  },
  {
   "n": 26,
   "role": "host",
   "part": "진행자 파트",
   "text": "그럼 하락장에서 전부 팔아 버리는 게 왜 위험한지 하나씩 짚어 보겠습니다.",
   "start": 119.73,
   "end": 124.24
  },
  {
   "n": 27,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "첫 번째 문제는 크게 오르는 날이 크게 떨어진 날 바로 뒤에 몰려 있다는 것입니다.",
   "start": 132.24,
   "end": 136.82
  },
  {
   "n": 28,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "3월 4일은 코스피 역사상 하루 하락률이 가장 큰 날이었습니다.",
   "start": 137.27,
   "end": 141.68
  },
  {
   "n": 29,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "하루 뒤 코스피는 거꾸로 10% 가까이 올랐죠.",
   "start": 142.13,
   "end": 145.22
  },
  {
   "n": 30,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2020년 코로나 때도 그랬습니다.",
   "start": 145.67,
   "end": 147.95
  },
  {
   "n": 31,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "3월 19일 8% 넘게 떨어진 코스피는 다음 날 7% 넘게 올랐습니다.",
   "start": 148.4,
   "end": 153.36
  },
  {
   "n": 32,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "미국 자산운용사 JP모건이 2006년부터 20년 동안 S&P 500 지수를 분석했습니다.",
   "start": 153.81,
   "end": 160.49
  },
  {
   "n": 33,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "1천만 원을 계속 넣어 뒀다면 8천만 원이 넘었습니다.",
   "start": 160.94,
   "end": 164.53
  },
  {
   "n": 34,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그런데 가장 많이 오른 10일만 놓쳐도 3,600만 원에 그쳤죠.",
   "start": 164.98,
   "end": 169.63
  },
  {
   "n": 35,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그 10일 중 6일은 가장 크게 떨어진 10일과 2주 안에 붙어 있었습니다.",
   "start": 170.08,
   "end": 174.77
  },
  {
   "n": 36,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "폭락한 날 팔고 나가면 바로 뒤에 오는 반등을 놓치기 쉽다는 뜻입니다.",
   "start": 175.22,
   "end": 179.7
  },
  {
   "n": 37,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "두 번째는 한번 팔고 나면 다시 사기가 훨씬 어렵다는 것입니다.",
   "start": 180.15,
   "end": 184.79
  },
  {
   "n": 38,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사연자가 판 다음 날 다시 사려면 판 가격보다 11% 넘게 비싸게 사야 했습니다.",
   "start": 185.24,
   "end": 191.15
  },
  {
   "n": 39,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "내가 틀렸다는 걸 인정해야 하니 쉽게 손이 가지 않죠.",
   "start": 191.6,
   "end": 195.32
  },
  {
   "n": 40,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "미국 MIT 연구진은 2003년부터 13년 동안 증권 계좌 65만여 개를 살펴봤습니다.",
   "start": 195.77,
   "end": 202.46
  },
  {
   "n": 41,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "한 달 사이 주식을 90% 넘게 정리한 패닉셀을 찾아봤죠.",
   "start": 202.91,
   "end": 207.07
  },
  {
   "n": 42,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그중 31%는 다시는 주식으로 돌아오지 않았습니다.",
   "start": 207.52,
   "end": 211.78
  },
  {
   "n": 43,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "잠잠해지면 다시 사겠다는 계획이 생각처럼 되지 않는 이유입니다.",
   "start": 212.23,
   "end": 216.12
  },
  {
   "n": 44,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "세 번째는 바닥이 지나고 나서야 보인다는 것입니다.",
   "start": 216.57,
   "end": 219.33
  },
  {
   "n": 45,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "사연자가 판 3월 4일도 바닥은 아니었습니다.",
   "start": 219.78,
   "end": 222.96
  },
  {
   "n": 46,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "코스피는 3월 31일 그보다 더 낮은 5,052까지 내려갔죠.",
   "start": 223.41,
   "end": 227.94
  },
  {
   "n": 47,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그런데 그 뒤 한 달도 안 돼 30% 넘게 올랐습니다.",
   "start": 228.39,
   "end": 231.67
  },
  {
   "n": 48,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "팔았다가 더 싸게 다시 사려면 파는 날과 사는 날을 둘 다 맞혀야 합니다.",
   "start": 232.12,
   "end": 237.01
  },
  {
   "n": 49,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "겁에 질린 날 그 두 가지를 맞히기는 훨씬 더 어렵죠.",
   "start": 237.46,
   "end": 240.72
  },
  {
   "n": 50,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "네 번째는 사고판 시점 때문에 투자자가 가져가는 수익이 줄어든다는 것입니다.",
   "start": 241.17,
   "end": 246.52
  },
  {
   "n": 51,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "미국 펀드 평가사 모닝스타가 2024년까지 10년 동안 미국 펀드를 분석했습니다.",
   "start": 246.97,
   "end": 253.05
  },
  {
   "n": 52,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "펀드 자체는 1년에 8.2%씩 벌었는데, 투자자들이 실제로 번 돈은 7.0%였습니다.",
   "start": 253.5,
   "end": 260.32
  },
  {
   "n": 53,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "1년에 1.2%포인트, 전체 수익의 15% 정도가 사고판 시점 때문에 사라진 겁니다.",
   "start": 260.77,
   "end": 267.46
  },
  {
   "n": 54,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "물론 하락장이 길게 이어질 때도 있습니다.",
   "start": 267.91,
   "end": 270.78
  },
  {
   "n": 55,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "2008년 금융위기 때 코스피는 1년 만에 절반 넘게 떨어졌습니다.",
   "start": 271.23,
   "end": 275.61
  },
  {
   "n": 56,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "이전 고점을 되찾기까지는 3년이 넘게 걸렸죠.",
   "start": 276.06,
   "end": 279.55
  },
  {
   "n": 57,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그래서 무조건 버티라는 게 아니라, 겁이 결정하지 않도록 미리 기준을 세워 둬야 합니다.",
   "start": 280.0,
   "end": 285.17
  },
  {
   "n": 58,
   "role": "host",
   "part": "문제 분석 파트",
   "text": "그렇다면 하락장에서는 어떻게 해야 할까요?",
   "start": 285.62,
   "end": 288.24
  },
  {
   "n": 59,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "첫째, 1~2년 안에 쓸 돈은 처음부터 주식에 넣지 않는 것입니다.",
   "start": 289.24,
   "end": 293.82
  },
  {
   "n": 60,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "2008년처럼 회복에 몇 년이 걸리는 하락장도 있기 때문입니다.",
   "start": 294.27,
   "end": 298.34
  },
  {
   "n": 61,
   "role": "host",
   "part": "올바른 방법 설명 파트",
   "text": "그 사이에 꺼내 써야 할 돈이 주식에 묶여 있으면 바닥에서라도 팔 수밖에 없습니다.",
